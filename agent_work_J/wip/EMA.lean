    have e : (args a).foldl (fun acc t => mulRgt acc (clsRgt t)) 0 = clsRgt a := (clsRgt_args a).symm
    have hk := kSRgt
    simp only [checkSRgt, RNRgt, List.all_eq_true, List.mem_range, beq_iff_eq] at hk
    rw [e, hk _ (clsRgt_lt a) _ (clsRgt_lt b) _ (clsRgt_lt c)]
    rfl

theorem clsLRgt_run : ∀ (n : Nat) (L L' : List Tm), run n L = some L' → clsLRgt L = clsLRgt L'
  | 0, L, L', h => by simp [run] at h; subst h; rfl
  | n + 1, L, L', h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 => rw [hs] at h; exact (clsLRgt_step L L1 hs).trans (clsLRgt_run n L1 L' h)

theorem jointRgt_term : ∀ t : Tm, (clsRgt t, cls t) ∈ JRgt
  | S => by
    have h := kJRgt
    simp only [checkJRgt, Bool.and_eq_true, List.contains_iff_mem] at h
    exact h.1.1
  | app f x => by
    have h := kJRgt
    simp only [checkJRgt, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem] at h
    exact h.1.2 _ (jointRgt_term f) _ (jointRgt_term x)

theorem jointRgt_list : ∀ (L : List Tm) (acc : Nat × Nat), acc ∈ JRgt →
    (L.foldl (fun a t => mulRgt a (clsRgt t)) acc.1, L.foldl (fun a t => mul a (cls t)) acc.2) ∈ JRgt
  | [], acc, h => by simpa using h
  | t :: L, acc, h => by
    simp only [List.foldl]
    have hk := kJRgt
    simp only [checkJRgt, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem] at hk
    exact jointRgt_list L (mulRgt acc.1 (clsRgt t), mul acc.2 (cls t)) (hk.1.2 _ h _ (jointRgt_term t))

theorem flagRgt_F (L : List Tm) (h : flagRgt (clsLRgt L) = true) : isF (clsL L) = true := by
  have hk := kJRgt
  simp only [checkJRgt, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem, Bool.or_eq_true,
    Bool.not_eq_true'] at hk
  have hm := jointRgt_list L (0, 0) hk.1.1
  rcases hk.2 _ hm with h1 | h1
  · exact absurd h (by simp only [clsLRgt] at h1 ⊢; rw [h1]; decide)
  · exact h1

/-- the rightmost Böhm-tree path has at least d further nodes, each with a head normal form -/
def InfRgt : Nat → List Tm → Prop
  | 0, _ => True
  | d + 1, L => ∃ n L', run n L = some L' ∧ L'.length ≤ 2 ∧ ∃ x, L'.getLast? = some x ∧ InfRgt d (args x)

theorem infRgt_aux : ∀ (d : Nat) (L : List Tm), flagRgt (clsLRgt L) = true → InfRgt d L
  | 0, _, _ => trivial
  | d + 1, L, h => by
    obtain ⟨n, L', hr, hl⟩ := hnfF L (flagRgt_F L h)
    have hc : clsLRgt L' = clsLRgt L := (clsLRgt_run n L L' hr).symm
    rw [← hc] at h
    have hk := kCRgt
    simp only [checkCRgt, Bool.and_eq_true, List.all_eq_true, List.mem_range, beq_iff_eq, RNRgt,
      Bool.not_eq_true'] at hk
    obtain ⟨⟨h0, h1⟩, h2⟩ := hk
    refine ⟨n, L', hr, hl, ?_⟩
    match L', hl with
    | [], _ => simp only [clsLRgt, List.foldl] at h; rw [h0] at h; exact absurd h (by decide)
    | [x], _ =>
      simp only [clsLRgt, List.foldl] at h
      have hx : flagRgt (clsLRgt (args x)) = true := by rw [← clsRgt_args, ← h1 _ (clsRgt_lt x)]; exact h
      exact ⟨x, rfl, infRgt_aux d (args x) hx⟩
    | [x, y], _ =>
      simp only [clsLRgt, List.foldl] at h
      have hz := h2 _ (clsRgt_lt x) _ (clsRgt_lt y)
      rw [h] at hz
      have hy : flagRgt (clsLRgt (args y)) = true := by rw [← clsRgt_args]; exact hz.symm
      exact ⟨y, rfl, infRgt_aux d (args y) hy⟩

/-- Proposition Q'' (rightmost path): if the Rgt class of t is flagged, the rightmost path of BT(t) is infinite. -/
theorem propQ2Rgt (t : Tm) (h : flagRgt (clsRgt t) = true) : ∀ d, InfRgt d (args t) :=
  fun d => infRgt_aux d (args t) (by rw [← clsRgt_args]; exact h)

end PM


namespace C


inductive T where
  | S : T
  | app : T → T → T
deriving DecidableEq, Repr

open T

def args : T → List T
  | S => []
  | app f x => args f ++ [x]

def size : T → Nat
  | S => 1
  | app f x => size f + size x

def lchild : T → T
  | S => S
  | app f _ => f

def step : List T → Option (List T)
  | a :: b :: c :: R => some (args a ++ c :: app b c :: R)
  | _ => none

inductive Reach (L0 : List T) : List T → Prop
  | refl : Reach L0 L0
  | tail {L L' : List T} : Reach L0 L → step L = some L' → Reach L0 L'

theorem size_pos : ∀ t : T, 0 < size t
  | S => by simp [size]
  | app f x => by have := size_pos f; simp [size]; omega

theorem args_nil (t : T) (h : args t = []) : t = S := by
  cases t with
  | S => rfl
  | app f x => simp [args] at h

theorem size_args : ∀ (t y : T), y ∈ args t → size y < size t
  | S, y, h => by simp [args] at h
  | app f x, y, h => by
    simp only [args, List.mem_append, List.mem_singleton] at h
    rcases h with h | rfl
    · have := size_args f y h; simp [size]; omega
    · have := size_pos f; simp [size]; omega

theorem step_len (L L' : List T) (h : step L = some L') : 2 ≤ L'.length := by
  match L, h with
  | a :: b :: c :: R, h =>
    simp only [step, Option.some.injEq] at h; subst h; simp; omega

theorem step_exists (L : List T) (h : 3 ≤ L.length) : ∃ L', step L = some L' := by
  match L, h with
  | a :: b :: c :: R, _ => exact ⟨_, rfl⟩

theorem step_append (L L' M : List T) (h3 : 3 ≤ L.length) (h : step L = some L') :
    step (L ++ M) = some (L' ++ M) := by
  match L, h3, h with
  | a :: b :: c :: R, _, h =>
    simp only [step, Option.some.injEq] at h; subst h
    simp [step]

theorem step_short (A : List T) (hA : A.length ≤ 2) : step A = none := by
  match A, hA with
  | [], _ => rfl
  | [_], _ => rfl
  | [_, _], _ => rfl
  | _ :: _ :: _ :: _, hA => simp at hA

theorem reach_stuck (A B : List T) (hA : A.length ≤ 2) (h : Reach A B) : B = A := by
  induction h with
  | refl => rfl
  | tail _ hs ih =>
    rw [ih, step_short A hA] at hs
    exact absurd hs (by simp)

/-! ## the bottom-size invariant -/

/-- the last element is strictly larger than z -/
def BigBot (z : T) (L : List T) : Prop := ∃ M w, L = M ++ [w] ∧ size z < size w

theorem bigbot_step (z : T) (L L' : List T) (hB : BigBot z L) (hs : step L = some L') : BigBot z L' := by
  obtain ⟨M, w, rfl, hw⟩ := hB
  match M, hs with
  | [], hs => simp [step] at hs
  | [_], hs => simp [step] at hs
  | [a, b], hs =>
    simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
    subst hs
    refine ⟨args a ++ [w], app b w, by simp, ?_⟩
    simp [size]; omega
  | a :: b :: c :: M', hs =>
    simp only [List.cons_append, step, Option.some.injEq] at hs
    subst hs
    exact ⟨args a ++ c :: app b c :: M', w, by simp, hw⟩

theorem bigbot_reach (z : T) (A B : List T) (hA : BigBot z A) (h : Reach A B) : BigBot z B := by
  induction h with
  | refl => exact hA
  | tail _ hs ih => exact bigbot_step z _ _ ih hs

/-- a 2-list reached by at least one step from a BigBot list has a first element larger than z -/
theorem bigbot_final (z : T) (A : List T) (c d : T) (hA : BigBot z A) (h : Reach A [c, d])
    (hne : A ≠ [c, d]) : size z < size c := by
  cases h with
  | refl => exact absurd rfl hne
  | tail h1 hs =>
    rename_i L1
    have hB := bigbot_reach z A L1 hA h1
    obtain ⟨M, w, hL1, hw⟩ := hB
    match L1, hs, hL1 with
    | a :: b :: c' :: R, hs, hL1 =>
      simp only [step, Option.some.injEq] at hs
      have hlen := congrArg List.length hs
      simp at hlen
      have ha : args a = [] := by
        cases h' : args a with
        | nil => rfl
        | cons _ _ => rw [h'] at hlen; simp at hlen; omega
      have hR : R = [] := by
        cases R with
        | nil => rfl
        | cons _ _ => simp at hlen; omega
      subst hR
      rw [ha] at hs
      simp only [List.nil_append, List.cons.injEq] at hs
      have hw' : w = c' := by
        have := congrArg List.getLast? hL1
        simp at this; exact this.symm
      rw [← hs.1, ← hw']; exact hw

/-! ## the stripping invariant -/

def SInv (L : List T) (z : T) (L2 : List T) : Prop :=
  (∃ L1, Reach L L1 ∧ 2 ≤ L1.length ∧ L2 = L1 ++ [z]) ∨
  (∃ y, Reach L [S, y] ∧ L2 = [z, app y z]) ∨
  (∃ x y, x ≠ S ∧ Reach L [x, y] ∧ Reach (args x ++ [z, app y z]) L2)

theorem inv_step (L : List T) (z : T) (L2 L3 : List T) (hI : SInv L z L2) (hs : step L2 = some L3) :
    SInv L z L3 := by
  rcases hI with ⟨L1, hr, hlen, rfl⟩ | ⟨y, _, rfl⟩ | ⟨x, y, hx, hr, hr2⟩
  · by_cases h3 : 3 ≤ L1.length
    · obtain ⟨L1', h1'⟩ := step_exists L1 h3
      have := step_append L1 L1' [z] h3 h1'
      rw [this] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inl ⟨L1', Reach.tail hr h1', step_len _ _ h1', rfl⟩
    · have h2 : L1.length = 2 := by omega
      match L1, h2, hr, hs with
      | [x, y], _, hr, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hx : x = S
        · subst hx
          exact Or.inr (Or.inl ⟨y, hr, by simp [args]⟩)
        · exact Or.inr (Or.inr ⟨x, y, hx, hr, Reach.refl⟩)
  · simp [step] at hs
  · exact Or.inr (Or.inr ⟨x, y, hx, hr, Reach.tail hr2 hs⟩)

theorem inv_reach (L : List T) (z : T) (hL : 2 ≤ L.length) (L2 : List T) (h : Reach (L ++ [z]) L2) :
    SInv L z L2 := by
  induction h with
  | refl => exact Or.inl ⟨L, Reach.refl, hL, rfl⟩
  | tail _ hs ih => exact inv_step L z _ _ ih hs

/-- **Final shape.**  A head normal form [c, d] of L ++ [z] (L with >= 2 elements) either keeps the bottom z as its
    first component — and then L itself reaches [S, y] and d = y.z — or has a first component larger than z. -/
theorem final_shape (L : List T) (z c d : T) (hL : 2 ≤ L.length) (h : Reach (L ++ [z]) [c, d]) :
    (c = z ∧ ∃ y, Reach L [S, y] ∧ d = app y z) ∨ size z < size c := by
  rcases inv_reach L z hL _ h with ⟨L1, _, hlen, hEq⟩ | ⟨y, hr, hEq⟩ | ⟨x, y, hx, _, hr2⟩
  · have := congrArg List.length hEq; simp at this; omega
  · simp only [List.cons.injEq] at hEq
    exact Or.inl ⟨hEq.1, y, hr, hEq.2.1⟩
  · right
    refine bigbot_final z _ c d ⟨args x ++ [z], app y z, by simp, ?_⟩ hr2 ?_
    · simp [size]; have := size_pos y; omega
    · intro hEq
      have := congrArg List.length hEq
      simp at this
      have : args x = [] := by
        cases h' : args x with
        | nil => rfl
        | cons _ _ => rw [h'] at this; simp at this
      exact hx (args_nil x this)

/-! ## chains -/

/-- H(P) = S S P' -/
def R (P P' : T) : Prop := Reach (args P) [S, P']

/-- H(W) = S (S S) W' -/
def R2 (W W' : T) : Prop := Reach (args W) [app S S, W']

theorem args_app (f x : T) : args (app f x) = args f ++ [x] := rfl

theorem R_short (P P' : T) (h : (args P).length ≤ 2) (hR : R P P') : args P = [S, P'] :=
  (reach_stuck _ _ h hR).symm

theorem R_S (P' : T) : ¬ R S P' := by
  intro h
  have := R_short S P' (by simp [args]) h
  simp [args] at this

/-- if P = Q.z with Q having >= 2 arguments and H(P) = S S P', then z = S and H(Q) = S S y with P' = y.S -/
theorem R_strip (Q z P' : T) (hQ : 2 ≤ (args Q).length) (h : R (app Q z) P') :
    z = S ∧ ∃ y, R Q y ∧ P' = app y S := by
  unfold R at h
  rw [args_app] at h
  rcases final_shape (args Q) z S P' hQ h with ⟨hz, y, hy, hP⟩ | hbig
  · subst hz; exact ⟨rfl, y, hy, hP⟩
  · have := size_pos z; simp [size] at hbig; omega

theorem R2_strip (Q P' : T) (hQ : 2 ≤ (args Q).length) (h : R2 (app Q (app S S)) P') :
    ∃ y, R Q y ∧ P' = app y (app S S) := by
  unfold R2 at h
  rw [args_app] at h
  rcases final_shape (args Q) (app S S) (app S S) P' hQ h with ⟨_, y, hy, hP⟩ | hbig
  · exact ⟨y, hy, hP⟩
  · simp [size] at hbig

/-- a term y.S where y has at most one argument cannot start an R-chain of length 2 -/
theorem R_dies (y P1 P2 : T) (hy : (args y).length ≤ 1) (h1 : R (app y S) P1) (h2 : R P1 P2) : False := by
  have hlen : (args (app y S)).length ≤ 2 := by rw [args_app]; simp; omega
  have e := R_short _ _ hlen h1
  rw [args_app] at e
  match hy' : args y, e with
  | [w], e =>
    simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
    rw [← e.2.1] at h2
    exact R_S P2 h2
  | [], e => simp at e
  | _ :: _ :: _, _ => rw [hy'] at hy; simp at hy

theorem no_R_chain_aux : ∀ (n : Nat) (f : Nat → T), size (f 0) ≤ n → (∀ j, R (f j) (f (j + 1))) → False := by
  intro n
  induction n with
  | zero => intro f h _; have := size_pos (f 0); omega
  | succ n ih =>
    intro f hsize hR
    by_cases hshort : (args (f 0)).length ≤ 2
    · have e := R_short _ _ hshort (hR 0)
      have hmem : f 1 ∈ args (f 0) := by rw [e]; simp
      have := size_args _ _ hmem
      exact ih (fun j => f (j + 1)) (by simp; omega) (fun j => hR (j + 1))
    · match hf0 : f 0 with
      | S => rw [hf0] at hshort; simp [args] at hshort
      | app Q z =>
        have hQ : 2 ≤ (args Q).length := by
          rw [hf0, args_app] at hshort; simp at hshort; omega
        have key : ∀ j, f j = app (lchild (f j)) S ∧ 2 ≤ (args (lchild (f j))).length := by
          intro j
          induction j with
          | zero =>
            have h0 := hR 0
            rw [hf0] at h0
            obtain ⟨hz, _⟩ := R_strip Q z (f 1) hQ h0
            subst hz
            rw [hf0]; exact ⟨rfl, hQ⟩
          | succ j ihj =>
            obtain ⟨hfj, hlen⟩ := ihj
            have hj := hR j
            rw [hfj] at hj
            obtain ⟨_, y, _, hP⟩ := R_strip _ S _ hlen hj
            have hy : 2 ≤ (args y).length := by
              by_cases hy1 : (args y).length ≤ 1
              · exfalso
                have h1 := hR (j + 1)
                rw [hP] at h1
                exact R_dies y _ _ hy1 h1 (hR (j + 2))
              · omega
            rw [hP]; exact ⟨rfl, hy⟩
        have chain : ∀ j, R (lchild (f j)) (lchild (f (j + 1))) := by
          intro j
          obtain ⟨hfj, hlen⟩ := key j
          have hj := hR j
          rw [hfj] at hj
          obtain ⟨_, y, hy, hP⟩ := R_strip _ S _ hlen hj
          rw [hP]; exact hy
        have hsz : size (lchild (f 0)) ≤ n := by
          rw [hf0] at hsize ⊢; simp [lchild, size] at hsize ⊢; have := size_pos z; omega
        exact ih (fun j => lchild (f j)) hsz chain

/-- **No infinite R-chain:** there is no sequence P0, P1, ... of closed S-terms with H(P_j) = S S P_(j+1). -/
theorem no_R_chain (f : Nat → T) (hR : ∀ j, R (f j) (f (j + 1))) : False :=
  no_R_chain_aux (size (f 0)) f (Nat.le_refl _) hR


/-! ## R2-chains (the opaque-fuel step) -/

/-- a 2-list reached from a list of length >= 3 has the shape [c, b.c] -/
theorem final_app (A : List T) (c d : T) (hA : 3 ≤ A.length) (h : Reach A [c, d]) : ∃ b, d = app b c := by
  cases h with
  | refl => simp at hA
  | tail h1 hs =>
    rename_i L1
    match L1, hs with
    | a :: b :: c' :: R, hs =>
      simp only [step, Option.some.injEq] at hs
      have hlen := congrArg List.length hs
      simp at hlen
      have ha : args a = [] := by
        cases h' : args a with
        | nil => rfl
        | cons _ _ => rw [h'] at hlen; simp at hlen; omega
      have hR : R = [] := by
        cases R with
        | nil => rfl
        | cons _ _ => simp at hlen; omega
      subst hR
      rw [ha] at hs
      simp only [List.nil_append, List.cons.injEq] at hs
      exact ⟨b, by rw [← hs.2.1, hs.1]⟩

theorem R2_short (W W' : T) (h : (args W).length ≤ 2) (hR : R2 W W') : args W = [app S S, W'] :=
  (reach_stuck _ _ h hR).symm

theorem R2_SS (W' : T) : ¬ R2 (app S S) W' := by
  intro h
  have := R2_short (app S S) W' (by simp [args]) h
  simp [args] at this

theorem R2_dies (y W1 W2 : T) (hy : (args y).length ≤ 1) (h1 : R2 (app y (app S S)) W1)
    (h2 : R2 W1 W2) : False := by
  have hlen : (args (app y (app S S))).length ≤ 2 := by rw [args_app]; simp; omega
  have e := R2_short _ _ hlen h1
  rw [args_app] at e
  match hy' : args y, e with
  | [w], e =>
    simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
    rw [← e.2.1] at h2
    exact R2_SS W2 h2
  | [], e => simp at e
  | _ :: _ :: _, _ => rw [hy'] at hy; simp at hy

theorem no_R2_chain_aux : ∀ (n : Nat) (f : Nat → T), size (f 0) ≤ n → (∀ j, R2 (f j) (f (j + 1))) → False := by
  intro n
  induction n with
  | zero => intro f h _; have := size_pos (f 0); omega
  | succ n ih =>
    intro f hsize hR
    by_cases hshort : (args (f 0)).length ≤ 2
    · have e := R2_short _ _ hshort (hR 0)
      have hmem : f 1 ∈ args (f 0) := by rw [e]; simp
      have := size_args _ _ hmem
      exact ih (fun j => f (j + 1)) (by simp; omega) (fun j => hR (j + 1))
    · obtain ⟨b, hb⟩ := final_app _ _ _ (by omega) (hR 0)
      -- from f 1 on, every term is y.(S S) with y having >= 2 arguments
      have key : ∀ j, f (j + 1) = app (lchild (f (j + 1))) (app S S) ∧
          2 ≤ (args (lchild (f (j + 1)))).length := by
        intro j
        induction j with
        | zero =>
          have hb2 : 2 ≤ (args b).length := by
            by_cases hb1 : (args b).length ≤ 1
            · exfalso
              have h1 := hR 1
              rw [hb] at h1
              exact R2_dies b _ _ hb1 h1 (hR 2)
            · omega
          rw [hb]; exact ⟨rfl, hb2⟩
        | succ j ihj =>
          obtain ⟨hfj, hlen⟩ := ihj
          have hj := hR (j + 1)
          rw [hfj] at hj
          obtain ⟨y, _, hP⟩ := R2_strip _ _ hlen hj
          have hy : 2 ≤ (args y).length := by
            by_cases hy1 : (args y).length ≤ 1
            · exfalso
              have h1 := hR (j + 2)
              rw [hP] at h1
              exact R2_dies y _ _ hy1 h1 (hR (j + 3))
            · omega
          rw [hP]; exact ⟨rfl, hy⟩
      have chain : ∀ j, R (lchild (f (j + 1))) (lchild (f (j + 1 + 1))) := by
        intro j
        obtain ⟨hfj, hlen⟩ := key j
        have hj := hR (j + 1)
        rw [hfj] at hj
        obtain ⟨y, hy, hP⟩ := R2_strip _ _ hlen hj
        rw [hP]; exact hy
      exact no_R_chain (fun j => lchild (f (j + 1))) chain

/-- **No infinite R2-chain:** there is no sequence W0, W1, ... of closed S-terms with H(W_j) = S (S S) W_(j+1). -/
theorem no_R2_chain (f : Nat → T) (hR : ∀ j, R2 (f j) (f (j + 1))) : False :=
  no_R2_chain_aux (size (f 0)) f (Nat.le_refl _) hR

end C

/-! ## Fuel-S tail calls and the reload shape (namespace TC, closed terms of namespace C) -/

namespace TC

open C
open C.T

theorem args_one' (q p : T) (h : args q = [p]) : q = app S p := by
  cases q with
  | S => simp [args] at h
  | app f x =>
    simp only [args] at h
    have hl := congrArg List.length h
    simp at hl
    have hf : args f = [] := by
      cases h' : args f with
      | nil => rfl
      | cons _ _ => rw [h'] at hl; simp at hl
    rw [hf] at h
    simp at h
    rw [args_nil f hf, h]

/-- runs from args Q ++ [z]: before any wrap (A), after the last wrap [x, c, w] -> args x ++ [w, c.w] (B), finished
    after a wrap (C), finished without a wrap (D) -/
def TCInv (Q z : T) (L : List T) : Prop :=
  (∃ L1, Reach (args Q) L1 ∧ 2 ≤ L1.length ∧ L = L1 ++ [z]) ∨
  (∃ x c w P, w ≠ S ∧ x ≠ S ∧ Reach (args x ++ [w]) P ∧ 2 ≤ P.length ∧ L = P ++ [app c w]) ∨
  (∃ x c w b, w ≠ S ∧ x ≠ S ∧ Reach (args x ++ [w]) [S, b] ∧ L = [app c w, app b (app c w)]) ∨
  (∃ y, Reach (args Q) [S, y] ∧ L = [z, app y z])

theorem args_ne_nil (x : T) (hx : x ≠ S) : 1 ≤ (args x).length := by
  cases h : args x with
  | nil => exact absurd (args_nil x h) hx
  | cons _ _ => simp

theorem tc_step (Q z : T) (hz : z ≠ S) (L L' : List T) (hI : TCInv Q z L) (hs : step L = some L') :
    TCInv Q z L' := by
  rcases hI with ⟨L1, hr, hlen, rfl⟩ | ⟨x, c, w, P, hw, hx, hP, hlen, rfl⟩ | ⟨_, _, _, _, _, _, _, rfl⟩ |
      ⟨_, _, rfl⟩
  · by_cases h3 : 3 ≤ L1.length
    · obtain ⟨L1', h1'⟩ := step_exists L1 h3
      rw [step_append L1 L1' [z] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inl ⟨L1', Reach.tail hr h1', step_len _ _ h1', rfl⟩
    · have h2 : L1.length = 2 := by omega
      match L1, h2, hr, hs with
      | [x, c], _, hr, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hxS : x = S
        · subst hxS
          exact Or.inr (Or.inr (Or.inr ⟨c, hr, by simp [args]⟩))
        · refine Or.inr (Or.inl ⟨x, c, z, args x ++ [z], hz, hxS, Reach.refl, ?_, by simp⟩)
          have := args_ne_nil x hxS; simp; omega
  · by_cases h3 : 3 ≤ P.length
    · obtain ⟨P', h1'⟩ := step_exists P h3
      rw [step_append P P' [app c w] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inr (Or.inl ⟨x, c, w, P', hw, hx, Reach.tail hP h1', step_len _ _ h1', rfl⟩)
    · have h2 : P.length = 2 := by omega
      match P, h2, hP, hs with
      | [x', c'], _, hP, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hxS : x' = S
        · subst hxS
          exact Or.inr (Or.inr (Or.inl ⟨x, c, w, c', hw, hx, hP, by simp [args]⟩))
        · refine Or.inr (Or.inl ⟨x', c', app c w, args x' ++ [app c w], by simp, hxS, Reach.refl, ?_, by simp⟩)
          have := args_ne_nil x' hxS; simp; omega
  · simp [step] at hs
  · simp [step] at hs

theorem tc_reach (Q z : T) (hQ : 2 ≤ (args Q).length) (hz : z ≠ S) (L : List T)
    (h : Reach (args Q ++ [z]) L) : TCInv Q z L := by
  induction h with
  | refl => exact Or.inl ⟨args Q, Reach.refl, hQ, rfl⟩
  | tail _ hs ih => exact tc_step Q z hz _ _ ih hs

/-- **Reload lemma.**  Let q = Q.z have >= 3 arguments, with last argument z /= S, and let the head normal form of q be
    S p q' where p is a fuel-S tail-call head (p = S S, or H(p) = S S y).  Then either the step is an R-step on the
    prefix (H(Q) = S S y and q' = y.z, same last argument) or q' has the RELOAD SHAPE  w.(S S w). -/
theorem reload_lemma (Q z p q' : T) (hQ : 2 ≤ (args Q).length) (hz : z ≠ S)
    (h : Reach (args (app Q z)) [p, q']) (hfuel : p = app S S ∨ ∃ y, R p y) :
    (∃ y, R Q y ∧ q' = app y z) ∨ (∃ w, q' = app w (app (app S S) w)) := by
  rw [args_app] at h
  rcases tc_reach Q z hQ hz _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c, w, P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hw, hx, hP, hEq⟩ | ⟨y, hy, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · right
    simp only [List.cons.injEq] at hEq
    obtain ⟨hp, hq, _⟩ := hEq
    -- b = w: the prefix args x ++ [w] reached [S, b]
    have hbw : b = w := by
      by_cases hx2 : 2 ≤ (args x).length
      · rcases final_shape (args x) w S b hx2 hP with ⟨hwS, _⟩ | hbig
        · exact absurd hwS.symm hw
        · simp [size] at hbig; have := size_pos w; omega
      · have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [x0], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          exact e.2.1
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at hx2; simp at hx2
    -- c = S S by the fuel condition on p = c.w
    have hc : c = app S S := by
      rcases hfuel with hSS | ⟨y, hy⟩
      · rw [hp] at hSS
        simp only [app.injEq] at hSS
        exact absurd hSS.2 hw
      · rw [hp] at hy
        by_cases hc2 : 2 ≤ (args c).length
        · exact absurd (R_strip c w y hc2 hy).1 hw
        · have hl : (args (app c w)).length ≤ 2 := by rw [args_app]; simp; omega
          have e := R_short _ _ hl hy
          rw [args_app] at e
          match hac : args c, e with
          | [c0], e =>
            simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
            rw [args_one' c c0 hac, e.1]
          | [], e => simp at e
          | _ :: _ :: _, _ => rw [hac] at hc2; simp at hc2
    exact ⟨w, by rw [hq, hbw, hc]⟩
  · left
    simp only [List.cons.injEq] at hEq
    exact ⟨y, hy, hEq.2.1⟩

end TC


namespace TC
open C
open C.T

/-- R-steps strictly shrink: H(Q) = S S y implies |y| < |Q| -/
theorem R_shrinks : ∀ (n : Nat) (Q y : T), size Q ≤ n → R Q y → size y < size Q := by
  intro n
  induction n with
  | zero => intro Q y h _; have := size_pos Q; omega
  | succ n ih =>
    intro Q y hs hR
    by_cases h2 : (args Q).length ≤ 2
    · have e := R_short Q y h2 hR
      have hmem : y ∈ args Q := by rw [e]; simp
      exact size_args Q y hmem
    · match Q, h2, hR, hs with
      | S, h2, _, _ => simp [args] at h2
      | app Q' z, h2, hR, hs =>
        have hQ' : 2 ≤ (args Q').length := by rw [args_app] at h2; simp at h2; omega
        obtain ⟨hz, y', hy', hyy⟩ := R_strip Q' z y hQ' hR
        subst hz; subst hyy
        have := ih Q' y' (by simp [size] at hs; omega) hy'
        simp [size]; omega

/-- a fuel-S tail call q.S -> q'.S: the head normal form of q is S p q' with p = S S or H(p) = S S y -/
def TCStep (q q' : T) : Prop := ∃ p, Reach (args q) [p, q'] ∧ (p = app S S ∨ ∃ y, R p y)

/-- the last spine argument -/
def lastArg : T → T
  | S => S
  | app _ z => z

/-- **Restart theorem.**  In an infinite chain of fuel-S tail calls whose terms never have last argument S, the
    reload shape w.(S S w) recurs infinitely often. -/
theorem restarts (f : Nat → T) (hstep : ∀ j, TCStep (f j) (f (j + 1))) (hlast : ∀ j, lastArg (f j) ≠ S) :
    ∀ N, ∃ j, N ≤ j ∧ ∃ w, f j = app w (app (app S S) w) := by
  intro N
  refine Classical.byContradiction (fun hno => ?_)
  have hno' : ∀ j, N ≤ j → ∀ w, f j ≠ app w (app (app S S) w) := by
    intro j hj w hw
    exact hno ⟨j, hj, w, hw⟩
  -- sizes strictly decrease from N on
  have hdec : ∀ j, N ≤ j → size (f (j + 1)) < size (f j) := by
    intro j hj
    obtain ⟨p, hr, hfuel⟩ := hstep j
    by_cases h2 : (args (f j)).length ≤ 2
    · have e := (reach_stuck _ _ h2 hr).symm
      have hmem : f (j + 1) ∈ args (f j) := by rw [e]; simp
      exact size_args _ _ hmem
    · match hfj : f j, h2, hr with
      | S, h2, _ => simp [args] at h2
      | app Q z, h2, hr =>
        have hQ : 2 ≤ (args Q).length := by rw [args_app] at h2; simp at h2; omega
        have hz : z ≠ S := by have := hlast j; rw [hfj] at this; exact this
        rcases reload_lemma Q z p (f (j + 1)) hQ hz hr hfuel with ⟨y, hy, hq⟩ | ⟨w, hw⟩
        · rw [hq]
          have := R_shrinks (size Q) Q y (Nat.le_refl _) hy
          simp [size]; omega
        · exact absurd hw (hno' (j + 1) (by omega) w)
  -- an infinite strictly decreasing sequence of naturals
  have hbound : ∀ k, size (f (N + k)) + k ≤ size (f N) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have := hdec (N + k) (by omega)
      rw [show N + (k + 1) = N + k + 1 by omega]
      omega
  have := hbound (size (f N) + 1)
  omega

end TC


/-! ## Classification: infinite fuel-S tail-call chains are the reload cycle -/

namespace RC

open C
open C.T
open TC

def SS : T := app S S
/-- B = S(SS)(SS) -/
def B : T := app (app S SS) SS
/-- N 0 = B, N (k+1) = S S (N k) -/
def N : Nat → T
  | 0 => B
  | k + 1 => app SS (N k)

/-- bottoms after wraps: z, c.z, c'.(c.z), ... -/
inductive Wrapped (z : T) : T → Prop
  | base : Wrapped z z
  | wrap (c w : T) : Wrapped z w → Wrapped z (app c w)

theorem wrapped_ne_S (z w : T) (hz : z ≠ S) (h : Wrapped z w) : w ≠ S := by
  cases h with
  | base => exact hz
  | wrap c w' _ => intro h; cases h

/-- a 2-list [S S, S S] is never the result of a step, so it is reached only in zero steps -/
theorem reach_SSSS (A : List T) (h : Reach A [SS, SS]) : A = [SS, SS] := by
  cases h with
  | refl => rfl
  | tail h1 hs =>
    rename_i L1
    match L1, hs with
    | a :: b :: c :: R, hs =>
      simp only [step, Option.some.injEq] at hs
      have hlen := congrArg List.length hs
      simp at hlen
      have ha : args a = [] := by
        cases h' : args a with
        | nil => rfl
        | cons _ _ => rw [h'] at hlen; simp at hlen; omega
      have hR : R = [] := by
        cases R with
        | nil => rfl
        | cons _ _ => simp at hlen; omega
      subst hR
      rw [ha] at hs
      simp only [List.nil_append, List.cons.injEq, SS] at hs
      obtain ⟨h1, h2, _⟩ := hs
      rw [h1] at h2
      simp at h2

theorem args_two (q a b : T) (h : args q = [a, b]) : q = app (app S a) b := by
  cases q with
  | S => simp [args] at h
  | app f x =>
    simp only [args] at h
    have hl := congrArg List.length h
    simp at hl
    match hf : args f, h with
    | [a'], h =>
      simp only [List.cons_append, List.nil_append, List.cons.injEq] at h
      rw [args_one' f a' hf, h.1, h.2.1]
    | [], h => simp at h
    | _ :: _ :: _, h => simp at h

/-- history of the last wrap [x, c, w] -/
def Hist (Q z x c w : T) : Prop :=
  (w = z ∧ Reach (args Q) [x, c]) ∨
  (∃ x0 c0 w0, w = app c0 w0 ∧ Wrapped z w0 ∧ Reach (args x0 ++ [w0]) [x, c])

theorem hist_wrapped (Q z x c w : T) (h : Hist Q z x c w) : Wrapped z w := by
  rcases h with ⟨rfl, _⟩ | ⟨x0, c0, w0, rfl, hw0, _⟩
  · exact Wrapped.base
  · exact Wrapped.wrap c0 w0 hw0

def CInv (Q z : T) (L : List T) : Prop :=
  (∃ L1, Reach (args Q) L1 ∧ 2 ≤ L1.length ∧ L = L1 ++ [z]) ∨
  (∃ x c w P, x ≠ S ∧ Hist Q z x c w ∧ Reach (args x ++ [w]) P ∧ 2 ≤ P.length ∧ L = P ++ [app c w]) ∨
  (∃ x c w b, x ≠ S ∧ Hist Q z x c w ∧ Reach (args x ++ [w]) [S, b] ∧ L = [app c w, app b (app c w)]) ∨
  (∃ y, Reach (args Q) [S, y] ∧ L = [z, app y z])

theorem cinv_step (Q z : T) (L L' : List T) (hI : CInv Q z L) (hs : step L = some L') : CInv Q z L' := by
  rcases hI with ⟨L1, hr, hlen, rfl⟩ | ⟨x, c, w, P, hx, hH, hP, hlen, rfl⟩ | ⟨_, _, _, _, _, _, _, rfl⟩ |
      ⟨_, _, rfl⟩
  · by_cases h3 : 3 ≤ L1.length
    · obtain ⟨L1', h1'⟩ := step_exists L1 h3
      rw [step_append L1 L1' [z] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inl ⟨L1', Reach.tail hr h1', step_len _ _ h1', rfl⟩
    · have h2 : L1.length = 2 := by omega
      match L1, h2, hr, hs with
      | [x, c], _, hr, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hxS : x = S
        · subst hxS
          exact Or.inr (Or.inr (Or.inr ⟨c, hr, by simp [args]⟩))
        · refine Or.inr (Or.inl ⟨x, c, z, args x ++ [z], hxS, Or.inl ⟨rfl, hr⟩, Reach.refl, ?_, by simp⟩)
          have := args_ne_nil x hxS; simp; omega
  · by_cases h3 : 3 ≤ P.length
    · obtain ⟨P', h1'⟩ := step_exists P h3
      rw [step_append P P' [app c w] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inr (Or.inl ⟨x, c, w, P', hx, hH, Reach.tail hP h1', step_len _ _ h1', rfl⟩)
    · have h2 : P.length = 2 := by omega
      match P, h2, hP, hs with
      | [x', c'], _, hP, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hxS : x' = S
        · subst hxS
          exact Or.inr (Or.inr (Or.inl ⟨x, c, w, c', hx, hH, hP, by simp [args]⟩))
        · refine Or.inr (Or.inl ⟨x', c', app c w, args x' ++ [app c w], hxS,
            Or.inr ⟨x, c, w, rfl, hist_wrapped Q z x c w hH, hP⟩, Reach.refl, ?_, by simp⟩)
          have := args_ne_nil x' hxS; simp; omega
  · simp [step] at hs
  · simp [step] at hs

theorem cinv_reach (Q z : T) (hQ : 2 ≤ (args Q).length) (L : List T)
    (h : Reach (args Q ++ [z]) L) : CInv Q z L := by
  induction h with
  | refl => exact Or.inl ⟨args Q, Reach.refl, hQ, rfl⟩
  | tail _ hs ih => exact cinv_step Q z _ _ ih hs

/-- **Restart detail.**  If q = Q.z (>= 3 arguments) with z /= S, z /= S S makes a fuel-S tail call, then it is an
    R-step on the prefix, or Q = B and the next multiplier is z.(S S z). -/
theorem restart_detail (Q z p q' : T) (hQ : 2 ≤ (args Q).length) (hz : z ≠ S) (hzSS : z ≠ SS)
    (h : Reach (args (app Q z)) [p, q']) (hfuel : p = SS ∨ ∃ y, R p y) :
    (∃ y, R Q y ∧ q' = app y z) ∨ (Q = B ∧ q' = app z (app SS z)) := by
  rw [args_app] at h
  rcases cinv_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c, w, P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hy, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · right
    simp only [List.cons.injEq] at hEq
    obtain ⟨hp, hq, _⟩ := hEq
    have hw : w ≠ S := wrapped_ne_S z w hz (hist_wrapped Q z x c w hH)
    -- the prefix args x ++ [w] reached [S, b]: |args x| = 1, x = S S, b = w
    have hx1 : (args x).length = 1 := by
      by_cases hx2 : 2 ≤ (args x).length
      · rcases final_shape (args x) w S b hx2 hP with ⟨hwS, _⟩ | hbig
        · exact absurd hwS.symm hw
        · simp [size] at hbig; have := size_pos w; omega
      · have := args_ne_nil x hx; omega
    have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
    have e := reach_stuck _ _ hl hP
    obtain ⟨hxSS, hbw⟩ : x = SS ∧ b = w := by
      match hax : args x, e with
      | [x0], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        refine ⟨?_, e.2.1⟩
        rw [args_one' x x0 hax, ← e.1]; rfl
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hax] at hx1; simp at hx1
    -- c = S S by the fuel condition
    have hc : c = SS := by
      rcases hfuel with hSS | ⟨y, hy⟩
      · rw [hp] at hSS
        simp only [SS, app.injEq] at hSS
        exact absurd hSS.2 hw
      · rw [hp] at hy
        by_cases hc2 : 2 ≤ (args c).length
        · exact absurd (R_strip c w y hc2 hy).1 hw
        · have hl2 : (args (app c w)).length ≤ 2 := by rw [args_app]; simp; omega
          have e2 := R_short _ _ hl2 hy
          rw [args_app] at e2
          match hac : args c, e2 with
          | [c0], e2 =>
            simp only [List.cons_append, List.nil_append, List.cons.injEq] at e2
            rw [args_one' c c0 hac, e2.1]; rfl
          | [], e2 => simp at e2
          | _ :: _ :: _, _ => rw [hac] at hc2; simp at hc2
    subst hxSS; subst hc
    -- the last wrap was [S S, S S, w]: it is the first wrap (Q = B, w = z)
    rcases hH with ⟨hwz, hrQ⟩ | ⟨x0, c0, w0, hw0eq, hw0, hr0⟩
    · have := reach_SSSS _ hrQ
      refine ⟨args_two Q SS SS this, ?_⟩
      rw [hq, hbw, hwz]
    · exfalso
      have e0 := reach_SSSS _ hr0
      have hw0SS : w0 = SS := by
        have := congrArg List.getLast? e0; simp at this; exact this
      cases hw0 with
      | base => exact hzSS hw0SS
      | wrap c1 w1 hw1 =>
        simp only [SS, app.injEq] at hw0SS
        exact wrapped_ne_S z w1 hz hw1 hw0SS.2
  · left
    simp only [List.cons.injEq] at hEq
    exact ⟨y, hy, hEq.2.1⟩

/-- R-steps into a term whose last argument is not S are syntactic -/
theorem R_into (y v : T) (hv : lastArg v ≠ S) (h : R y v) : y = app SS v := by
  by_cases h2 : (args y).length ≤ 2
  · have e := R_short y v h2 h
    have := args_two y S v e
    rw [this]; rfl
  · match y, h2, h with
    | S, h2, _ => simp [args] at h2
    | app Q z, h2, h =>
      have hQ : 2 ≤ (args Q).length := by rw [args_app] at h2; simp at h2; omega
      obtain ⟨_, y', _, hv'⟩ := R_strip Q z v hQ h
      rw [hv'] at hv; simp [lastArg] at hv

theorem N_ne_S (k : Nat) : N k ≠ S := by
  cases k <;> simp [N, B]

theorem lastArg_N (k : Nat) : lastArg (N k) ≠ S := by
  cases k with
  | zero => simp [N, B, SS, lastArg]
  | succ k => simp only [N, lastArg]; exact N_ne_S k

/-- an R-chain of length t ending at B starts at N t -/
theorem Rchain_to_B : ∀ (t : Nat) (y : Nat → T), y t = B → (∀ s, s < t → R (y s) (y (s + 1))) → y 0 = N t := by
  intro t
  induction t with
  | zero => intro y h _; simpa [N] using h
  | succ t ih =>
    intro y ht hR
    -- shift: y' s = y (s + 1)
    have h1 := ih (fun s => y (s + 1)) ht (fun s hs => hR (s + 1) (by omega))
    have h0 := R_into (y 0) (y 1) (by simp at h1; rw [h1]; exact lastArg_N t) (hR 0 (by omega))
    simp at h1
    rw [h0, h1]; rfl

end RC


namespace RC

open C
open C.T
open TC

/-! ### determinism of head runs -/

theorem reach_head (X Y : List T) (h : Reach X Y) : Y = X ∨ ∃ X', step X = some X' ∧ Reach X' Y := by
  induction h with
  | refl => exact Or.inl rfl
  | tail _ hs ih =>
    rcases ih with rfl | ⟨X', hX', hr⟩
    · exact Or.inr ⟨_, hs, Reach.refl⟩
    · exact Or.inr ⟨X', hX', Reach.tail hr hs⟩

theorem reach_trans (A B C : List T) (h1 : Reach A B) (h2 : Reach B C) : Reach A C := by
  induction h2 with
  | refl => exact h1
  | tail _ hs ih => exact Reach.tail ih hs

theorem reach_linear (A B C : List T) (hB : Reach A B) (hC : Reach A C) : Reach B C ∨ Reach C B := by
  induction hC with
  | refl => exact Or.inr hB
  | tail hC' hs ih =>
    rename_i C' C2
    rcases ih with h | h
    · exact Or.inl (Reach.tail h hs)
    · rcases reach_head _ _ h with rfl | ⟨X', hX', hr⟩
      · exact Or.inl (Reach.tail Reach.refl hs)
      · rw [hs] at hX'
        simp only [Option.some.injEq] at hX'
        subst hX'
        exact Or.inr hr

theorem reach_det (A B1 B2 : List T) (h1 : Reach A B1) (h2 : Reach A B2) (l1 : B1.length ≤ 2)
    (l2 : B2.length ≤ 2) : B1 = B2 := by
  rcases reach_linear A B1 B2 h1 h2 with h | h
  · exact (reach_stuck _ _ l1 h).symm
  · exact reach_stuck _ _ l2 h

/-! ### the reload set is closed under tail calls -/

theorem args_N_succ (i : Nat) : args (N (i + 1)) = [S, N i] := rfl

theorem args_B : args B = [SS, SS] := rfl

theorem closure (i m : Nat) (q' : T) (him : i < m) (h : TCStep (app (N i) (N m)) q') :
    ∃ i' m', i' < m' ∧ q' = app (N i') (N m') := by
  obtain ⟨p, hr, _⟩ := h
  cases i with
  | succ i =>
    have hr1 : Reach (args (app (N (i + 1)) (N m))) [N m, app (N i) (N m)] := by
      apply Reach.tail Reach.refl
      rw [args_app, args_N_succ]
      rfl
    have := reach_det _ _ _ hr hr1 (by simp) (by simp)
    simp only [List.cons.injEq] at this
    exact ⟨i, m, by omega, this.2.1⟩
  | zero =>
    have s1 : step (args (app (N 0) (N m))) = some [S, N m, app SS (N m)] := rfl
    have s2 : step [S, N m, app SS (N m)] = some [N (m + 1), app (N m) (N (m + 1))] := rfl
    have hr1 : Reach (args (app (N 0) (N m))) [N (m + 1), app (N m) (N (m + 1))] :=
      Reach.tail (Reach.tail Reach.refl s1) s2
    have := reach_det _ _ _ hr hr1 (by simp) (by simp)
    simp only [List.cons.injEq] at this
    exact ⟨m, m + 1, by omega, this.2.1⟩

/-! ### between two restarts the prefix is a counter -/

def Restart (q : T) : Prop := ∃ w, q = app w (app SS w)

theorem SSw_ne_S (w : T) : app SS w ≠ S := by intro h; cases h

theorem SSw_ne_SS (w : T) : app SS w ≠ SS := by
  intro h; simp only [SS, app.injEq] at h; exact absurd h.1 (by intro h'; cases h')

/-- a node whose multiplier is y.Z with y having <= 1 argument cannot make two tail calls in a row -/
theorem short_dies (y Z q1 q2 : T) (hy : (args y).length ≤ 1) (hZ : Z = app SS (lchild Z) ∨ True)
    (h1 : TCStep (app y Z) q1) (h2 : TCStep q1 q2) (hZS : ∃ w, Z = app SS w) : False := by
  obtain ⟨w, rfl⟩ := hZS
  obtain ⟨p1, hr1, _⟩ := h1
  have hl : (args (app y (app SS w))).length ≤ 2 := by rw [args_app]; simp; omega
  have e := (reach_stuck _ _ hl hr1)
  rw [args_app] at e
  have hq1 : q1 = app SS w := by
    have := congrArg List.getLast? e; simp at this; exact this
  subst hq1
  obtain ⟨p2, hr2, hf2⟩ := h2
  have e2 := (reach_stuck _ _ (by rw [args_app]; simp [SS, args]) hr2)
  -- args (S S w) = [S, w], so p2 = S, which is not a fuel head
  have hp2 : p2 = S := by
    have : args (app SS w) = [S, w] := rfl
    rw [this] at e2
    simp only [List.cons.injEq] at e2
    exact e2.1
  subst hp2
  rcases hf2 with h | ⟨y', hy'⟩
  · cases h
  · exact R_S y' hy'

theorem next_restart : ∀ (d j : Nat) (f : Nat → T), (∀ i, TCStep (f i) (f (i + 1))) →
    Restart (f j) → Restart (f (j + d + 1)) → ∃ k, f j = app (N k) (N (k + 1)) := by
  intro d
  induction d using Nat.strongRecOn with
  | _ d ih =>
    intro j f hstep hj hjd
    by_cases hmid : ∃ d', d' < d ∧ Restart (f (j + d' + 1))
    · obtain ⟨d', hd', hr⟩ := hmid
      exact ih d' hd' j f hstep hj hr
    · have hno : ∀ s, 1 ≤ s → s ≤ d → ¬ Restart (f (j + s)) := by
        intro s hs1 hsd hr
        exact hmid ⟨s - 1, by omega, by rw [show j + (s - 1) + 1 = j + s by omega]; exact hr⟩
      obtain ⟨w, hw⟩ := hj
      -- prefixes y s := lchild (f (j + s)); invariant for s <= d
      have inv : ∀ s, s ≤ d → f (j + s) = app (lchild (f (j + s))) (app SS w) ∧
          2 ≤ (args (lchild (f (j + s)))).length ∧
          (∀ s', s' < s → R (lchild (f (j + s'))) (lchild (f (j + s' + 1)))) ∧
          (0 < s → size (lchild (f (j + s))) < size w) := by
        intro s
        induction s with
        | zero =>
          intro _
          refine ⟨by simp [hw, lchild], ?_, fun s' hs' => absurd hs' (by omega), fun h => absurd h (by omega)⟩
          by_cases h1 : (args w).length ≤ 1
          · exfalso
            have h1' := hstep j
            rw [hw] at h1'
            exact short_dies w (app SS w) _ _ h1 (Or.inr trivial) h1' (hstep (j + 1)) ⟨w, rfl⟩
          · simp [hw, lchild]; omega
        | succ s ihs =>
          intro hsd
          obtain ⟨hfs, hlen, hR, hsz⟩ := ihs (by omega)
          have hst := hstep (j + s)
          rw [hfs] at hst
          obtain ⟨p, hr, hfuel⟩ := hst
          rcases restart_detail _ _ p _ hlen (SSw_ne_S w) (SSw_ne_SS w) hr hfuel with ⟨y, hy, hq⟩ | ⟨_, hq⟩
          · have hq' : f (j + (s + 1)) = app y (app SS w) := by rw [show j + (s + 1) = j + s + 1 by omega, hq]
            have hyl : lchild (f (j + (s + 1))) = y := by rw [hq']; rfl
            refine ⟨by rw [hq']; rfl, ?_, ?_, ?_⟩
            · rw [hyl]
              by_cases h1 : (args y).length ≤ 1
              · exfalso
                have h1' := hstep (j + (s + 1))
                rw [hq'] at h1'
                exact short_dies y (app SS w) _ _ h1 (Or.inr trivial) h1' (hstep (j + (s + 1) + 1)) ⟨w, rfl⟩
              · omega
            · intro s' hs'
              by_cases hss : s' < s
              · exact hR s' hss
              · have : s' = s := by omega
                subst this
                rw [show j + s' + 1 = j + (s' + 1) by omega, hyl]; exact hy
            · intro _
              have h1 := R_shrinks _ _ _ (Nat.le_refl _) hy
              rw [hyl]
              by_cases hs0 : s = 0
              · subst hs0
                have : lchild (f (j + 0)) = w := by simp [hw, lchild]
                rw [this] at h1; exact h1
              · have := hsz (by omega); omega
          · exfalso
            exact hno (s + 1) (by omega) hsd ⟨app SS w, by rw [show j + (s + 1) = j + s + 1 by omega, hq]⟩
      -- the step from f (j + d) into the restart f (j + d + 1)
      obtain ⟨hfd, hlen, hR, hsz⟩ := inv d (Nat.le_refl d)
      have hst := hstep (j + d)
      rw [hfd] at hst
      obtain ⟨p, hr, hfuel⟩ := hst
      rcases restart_detail _ _ p _ hlen (SSw_ne_S w) (SSw_ne_SS w) hr hfuel with ⟨y, hy, hq⟩ | ⟨hB, _⟩
      · -- an R-step cannot produce the restart shape: it would make the prefix w again, but prefixes shrink
        exfalso
        obtain ⟨w', hw'⟩ := hjd
        rw [hq] at hw'
        simp only [app.injEq] at hw'
        obtain ⟨hyw, hZ⟩ := hw'
        have hww : w = w' := by
          first
            | exact hZ
            | exact hZ.2
            | (simp only [SS, app.injEq] at hZ; exact hZ.2)
        have h1 := R_shrinks _ _ _ (Nat.le_refl _) hy
        rw [hyw, ← hww] at h1
        by_cases hd0 : d = 0
        · subst hd0
          have : lchild (f (j + 0)) = w := by simp [hw, lchild]
          rw [this] at h1; omega
        · have := hsz (by omega); omega
      · -- the prefix chain w = y 0 -> ... -> y d = B: w = N d
        have hchain := Rchain_to_B d (fun s => lchild (f (j + s))) hB (fun s hs => hR s hs)
        simp only [Nat.add_zero] at hchain
        have hwl : lchild (f j) = w := by simp [hw, lchild]
        rw [hwl] at hchain
        exact ⟨d, by rw [hw, hchain]; rfl⟩

/-- **Reload classification.**  An infinite chain of fuel-S tail calls q_j.S -> q_(j+1).S of the leftmost path, whose
    terms never have last argument S, is eventually the reload cycle: from some index on every q_j is N i . N m with
    i < m (N 0 = S(SS)(SS), N (k+1) = S S (N k)). -/
theorem reload_classification (f : Nat → T) (hstep : ∀ j, TCStep (f j) (f (j + 1)))
    (hlast : ∀ j, lastArg (f j) ≠ S) : ∃ J, ∀ j, J ≤ j → ∃ i m, i < m ∧ f j = app (N i) (N m) := by
  obtain ⟨j1, _, w1, hw1⟩ := restarts f hstep hlast 0
  obtain ⟨j2, hj2, w2, hw2⟩ := restarts f hstep hlast (j1 + 1)
  have hd : j2 = j1 + (j2 - j1 - 1) + 1 := by omega
  obtain ⟨k, hk⟩ := next_restart (j2 - j1 - 1) j1 f hstep ⟨w1, hw1⟩ (by rw [← hd]; exact ⟨w2, hw2⟩)
  refine ⟨j1, ?_⟩
  have all : ∀ t, ∃ i m, i < m ∧ f (j1 + t) = app (N i) (N m) := by
    intro t
    induction t with
    | zero => exact ⟨k, k + 1, by omega, by simpa using hk⟩
    | succ t iht =>
      obtain ⟨i, m, him, hf⟩ := iht
      have hs := hstep (j1 + t)
      rw [hf] at hs
      obtain ⟨i', m', him', hq⟩ := closure i m _ him hs
      exact ⟨i', m', him', by rw [show j1 + (t + 1) = j1 + t + 1 by omega]; exact hq⟩
  intro j hj
  have := all (j - j1)
  rw [show j1 + (j - j1) = j by omega] at this
  exact this

end RC


/-! ## Tail calls over a closed fuel Z /= S (Conjecture F, tail-call case) -/

namespace FZ

open C
open C.T

/-- the last element is a.w with w larger than Z -/
def RBig (Z : T) (L : List T) : Prop := ∃ M a w, L = M ++ [app a w] ∧ size Z < size w

theorem rbig_step (Z : T) (L L' : List T) (hB : RBig Z L) (hs : step L = some L') : RBig Z L' := by
  obtain ⟨M, a0, w0, rfl, hw⟩ := hB
  match M, hs with
  | [], hs => simp [step] at hs
  | [_], hs => simp [step] at hs
  | [a, b], hs =>
    simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
    subst hs
    refine ⟨args a ++ [app a0 w0], b, app a0 w0, by simp, ?_⟩
    simp [size]; omega
  | a :: b :: c :: M', hs =>
    simp only [List.cons_append, step, Option.some.injEq] at hs
    subst hs
    exact ⟨args a ++ c :: app b c :: M', a0, w0, by simp, hw⟩

theorem rbig_reach (Z : T) (A B : List T) (hA : RBig Z A) (h : Reach A B) : RBig Z B := by
  induction h with
  | refl => exact hA
  | tail _ hs ih => exact rbig_step Z _ _ ih hs

theorem rbig_final (Z : T) (A : List T) (x y : T) (hA : RBig Z A) (h : Reach A [x, y]) (hne : A ≠ [x, y]) :
    ∃ a w, x = app a w ∧ size Z < size w := by
  cases h with
  | refl => exact absurd rfl hne
  | tail h1 hs =>
    rename_i L1
    match L1, hs with
    | a0 :: b0 :: c0 :: R0, hs =>
      simp only [step, Option.some.injEq] at hs
      have hlen := congrArg List.length hs
      simp at hlen
      have ha : args a0 = [] := by
        cases h' : args a0 with
        | nil => rfl
        | cons _ _ => rw [h'] at hlen; simp at hlen; omega
      have hR : R0 = [] := by
        cases R0 with
        | nil => rfl
        | cons _ _ => simp at hlen; omega
      subst hR
      rw [ha] at hs
      simp only [List.nil_append, List.cons.injEq] at hs
      obtain ⟨M, a1, w1, hM, hw1⟩ := rbig_reach Z _ _ hA h1
      have hlast : app a1 w1 = c0 := by
        have := congrArg List.getLast? hM; simp at this; exact this.symm
      exact ⟨a1, w1, by rw [← hs.1, ← hlast], hw1⟩

def FInvZ (Lq : List T) (Z : T) (L2 : List T) : Prop :=
  (∃ L1, Reach Lq L1 ∧ 2 ≤ L1.length ∧ L2 = L1 ++ [Z]) ∨
  (∃ p c P2, Reach Lq [p, c] ∧ Reach (args p ++ [Z]) P2 ∧ 2 ≤ P2.length ∧ L2 = P2 ++ [app c Z]) ∨
  (∃ p c d', Reach Lq [p, c] ∧ Reach (args p ++ [Z]) [S, d'] ∧ L2 = [app c Z, app d' (app c Z)]) ∨
  (∃ p c c' d', Reach Lq [p, c] ∧ Reach (args p ++ [Z]) [c', d'] ∧ c' ≠ S ∧
      Reach (args c' ++ [app c Z, app d' (app c Z)]) L2) ∨
  (∃ c, Reach Lq [S, c] ∧ L2 = [Z, app c Z])

theorem finvz_step (Lq : List T) (Z : T) (L2 L3 : List T) (hI : FInvZ Lq Z L2) (hs : step L2 = some L3) :
    FInvZ Lq Z L3 := by
  rcases hI with ⟨L1, hr, hlen, rfl⟩ | ⟨p, c, P2, hr, hP, hlen, rfl⟩ | ⟨_, _, _, _, _, rfl⟩ |
      ⟨p, c, c', d', hr, hP, hc', hr2⟩ | ⟨_, _, rfl⟩
  · by_cases h3 : 3 ≤ L1.length
    · obtain ⟨L1', h1'⟩ := step_exists L1 h3
      rw [step_append L1 L1' [Z] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inl ⟨L1', Reach.tail hr h1', step_len _ _ h1', rfl⟩
    · have h2 : L1.length = 2 := by omega
      match L1, h2, hr, hs with
      | [p, c], _, hr, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hpS : p = S
        · subst hpS
          exact Or.inr (Or.inr (Or.inr (Or.inr ⟨c, hr, by simp [args]⟩)))
        · refine Or.inr (Or.inl ⟨p, c, args p ++ [Z], hr, Reach.refl, ?_, by simp⟩)
          have := TC.args_ne_nil p hpS; simp; omega
  · by_cases h3 : 3 ≤ P2.length
    · obtain ⟨P2', h1'⟩ := step_exists P2 h3
      rw [step_append P2 P2' [app c Z] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inr (Or.inl ⟨p, c, P2', hr, Reach.tail hP h1', step_len _ _ h1', rfl⟩)
    · have h2 : P2.length = 2 := by omega
      match P2, h2, hP, hs with
      | [c', d'], _, hP, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hcS : c' = S
        · subst hcS
          exact Or.inr (Or.inr (Or.inl ⟨p, c, d', hr, hP, by simp [args]⟩))
        · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨p, c, c', d', hr, hP, hcS, Reach.refl⟩)))
  · simp [step] at hs
  · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨p, c, c', d', hr, hP, hc', Reach.tail hr2 hs⟩)))
  · simp [step] at hs

theorem finvz_reach (Lq : List T) (Z : T) (hL : 2 ≤ Lq.length) (L2 : List T) (h : Reach (Lq ++ [Z]) L2) :
    FInvZ Lq Z L2 := by
  induction h with
  | refl => exact Or.inl ⟨Lq, Reach.refl, hL, rfl⟩
  | tail _ hs ih => exact finvz_step Lq Z _ _ ih hs

/-- **Tail call over a closed fuel.**  If q has >= 2 arguments, Z /= S, and the leftmost child of the node q.Z is
    q'.Z (a single pushed multiplier), then H(q) = S (S S) q'. -/
theorem tail_call_fuel (q q' Z d : T) (hq : 2 ≤ (args q).length) (hZ : Z ≠ S)
    (h : Reach (args (app q Z)) [app q' Z, d]) : R2 q q' := by
  rw [args_app] at h
  rcases finvz_reach (args q) Z hq _ h with ⟨L1, _, hlen, hEq⟩ | ⟨p, c, P2, _, _, hlen, hEq⟩ |
      ⟨p, c, d', hr, hP, hEq⟩ | ⟨p, c, c', d', _, _, hc', hr2⟩ | ⟨c, _, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · simp only [List.cons.injEq, app.injEq] at hEq
    obtain ⟨⟨hcq, _⟩, _⟩ := hEq
    -- args p ++ [Z] reaches [S, d'] only in zero steps, so p = S S
    have hp : p = app S S := by
      by_cases hp2 : 2 ≤ (args p).length
      · rcases final_shape (args p) Z S d' hp2 hP with ⟨hS, _⟩ | hbig
        · exact absurd hS.symm hZ
        · simp [size] at hbig; have := size_pos Z; omega
      · have hl : (args p ++ [Z]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hap : args p, e with
        | [p0], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          rw [TC.args_one' p p0 hap, ← e.1]
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hap] at hp2; simp at hp2
    unfold R2
    rw [hp, ← hcq] at hr
    exact hr
  · exfalso
    have hB : RBig Z (args c' ++ [app c Z, app d' (app c Z)]) :=
      ⟨args c' ++ [app c Z], d', app c Z, by simp, by simp [size]; have := size_pos c; omega⟩
    by_cases hne : args c' ++ [app c Z, app d' (app c Z)] = [app q' Z, d]
    · have hl := congrArg List.length hne
      simp at hl
      have : args c' = [] := by
        cases h' : args c' with
        | nil => rfl
        | cons _ _ => rw [h'] at hl; simp at hl
      exact hc' (args_nil c' this)
    · obtain ⟨a, w, hx, hw⟩ := rbig_final Z _ _ _ hB hr2 hne
      simp only [app.injEq] at hx
      rw [← hx.2] at hw
      omega
  · simp only [List.cons.injEq] at hEq
    obtain ⟨h0, _⟩ := hEq
    have := congrArg size h0
    simp [size] at this; have := size_pos q'; omega

/-- **No infinite tail-call walk over a closed fuel Z /= S**: there is no infinite sequence of multipliers q_j (each
    with >= 2 arguments) such that the leftmost child of q_j.Z is q_(j+1).Z. -/
theorem no_tail_calls_fuel (Z : T) (hZ : Z ≠ S) (f : Nat → T)
    (h : ∀ j, 2 ≤ (args (f j)).length ∧ ∃ d, Reach (args (app (f j) Z)) [app (f (j + 1)) Z, d]) : False := by
  apply no_R2_chain f
  intro j
  obtain ⟨hl, d, hr⟩ := h j
  exact tail_call_fuel (f j) (f (j + 1)) Z d hl hZ hr

end FZ


namespace FZ
open C
open C.T

/-- **Tail call over the fuel S.**  If q has >= 2 arguments and the leftmost child of the node q.S is q'.S, then the
    step is a fuel-S tail call of the multipliers (TC.TCStep q q'). -/
theorem tail_call_S (q q' d : T) (hq : 2 ≤ (args q).length) (h : Reach (args (app q S)) [app q' S, d]) :
    TC.TCStep q q' := by
  rw [args_app] at h
  rcases finvz_reach (args q) S hq _ h with ⟨L1, _, hlen, hEq⟩ | ⟨p, c, P2, _, _, hlen, hEq⟩ |
      ⟨p, c, d', hr, hP, hEq⟩ | ⟨p, c, c', d', _, _, hc', hr2⟩ | ⟨c, _, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · simp only [List.cons.injEq, app.injEq] at hEq
    obtain ⟨⟨hcq, _⟩, _⟩ := hEq
    refine ⟨p, by rw [hcq]; exact hr, ?_⟩
    by_cases hp2 : 2 ≤ (args p).length
    · rcases final_shape (args p) S S d' hp2 hP with ⟨_, y, hy, _⟩ | hbig
      · exact Or.inr ⟨y, hy⟩
      · simp [size] at hbig
    · left
      have hl : (args p ++ [S]).length ≤ 2 := by simp; omega
      have e := reach_stuck _ _ hl hP
      match hap : args p, e with
      | [p0], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        rw [TC.args_one' p p0 hap, ← e.1]
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hap] at hp2; simp at hp2
  · exfalso
    have hB : RBig S (args c' ++ [app c S, app d' (app c S)]) :=
      ⟨args c' ++ [app c S], d', app c S, by simp, by simp [size]; have := size_pos c; omega⟩
    by_cases hne : args c' ++ [app c S, app d' (app c S)] = [app q' S, d]
    · have hl := congrArg List.length hne
      simp at hl
      have : args c' = [] := by
        cases h' : args c' with
        | nil => rfl
        | cons _ _ => rw [h'] at hl; simp at hl
      exact hc' (args_nil c' this)
    · obtain ⟨a, w, hx, hw⟩ := rbig_final S _ _ _ hB hr2 hne
      simp only [app.injEq] at hx
      rw [← hx.2] at hw
      simp [size] at hw
  · simp only [List.cons.injEq] at hEq
    obtain ⟨h0, _⟩ := hEq
    cases h0

/-- **Walk-level reload classification.**  An infinite leftmost walk through nodes q_j.S in which every child is the
    next node q_(j+1).S (pure tail calls over the fuel S; every q_j with >= 2 arguments and last argument /= S) is
    eventually the reload cycle N_i N_m S (i < m). -/
theorem walk_reload (f : Nat → T) (d : Nat → T)
    (h : ∀ j, 2 ≤ (args (f j)).length ∧ Reach (args (app (f j) S)) [app (f (j + 1)) S, d j])
    (hlast : ∀ j, TC.lastArg (f j) ≠ S) :
    ∃ J, ∀ j, J ≤ j → ∃ i m, i < m ∧ f j = app (RC.N i) (RC.N m) :=
  RC.reload_classification f (fun j => tail_call_S (f j) (f (j + 1)) (d j) (h j).1 (h j).2) hlast

end FZ


/-! ## Full classification: every infinite chain of fuel-S tail calls is eventually the reload cycle -/

namespace RC2

open C
open C.T
open TC
open RC

/-- all outcomes of a fuel-S tail call from q = Q.z (Q with >= 2 arguments), for an arbitrary last argument z -/
theorem tc_detail (Q z p q' : T) (hQ : 2 ≤ (args Q).length)
    (h : Reach (args (app Q z)) [p, q']) (hfuel : p = SS ∨ ∃ y, R p y) :
    (∃ y, R Q y ∧ q' = app y z) ∨ (∃ w, q' = app w (app SS w)) ∨
    (z = S ∧ ∃ x c, (x = SS ∧ q' = app S (app c S)) ∨ (∃ y, R x y ∧ q' = app (app y S) (app c S))) := by
  rw [args_app] at h
  rcases cinv_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c, w, P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hy, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hp, hq, _⟩ := hEq
    by_cases hw : w = S
    · -- the last wrap was the first one, with bottom z = S
      subst hw
      right; right
      have hz : z = S := by
        rcases hH with ⟨hwz, _⟩ | ⟨_, _, _, hw0, _, _⟩
        · exact hwz.symm
        · cases hw0
      refine ⟨hz, x, c, ?_⟩
      by_cases hx2 : 2 ≤ (args x).length
      · rcases final_shape (args x) S S b hx2 hP with ⟨_, y, hy, hb⟩ | hbig
        · right; exact ⟨y, hy, by rw [hq, hb]⟩
        · simp [size] at hbig
      · left
        have hl : (args x ++ [S]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [x0], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          refine ⟨by rw [args_one' x x0 hax, ← e.1]; rfl, by rw [hq, e.2.1]⟩
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at hx2; simp at hx2
    · -- w /= S: x = S S, b = w, c = S S: a restart
      right; left
      have hx1 : (args x).length = 1 := by
        by_cases hx2 : 2 ≤ (args x).length
        · rcases final_shape (args x) w S b hx2 hP with ⟨hwS, _⟩ | hbig
          · exact absurd hwS.symm hw
          · simp [size] at hbig; have := size_pos w; omega
        · have := args_ne_nil x hx; omega
      have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
      have e := reach_stuck _ _ hl hP
      have hbw : b = w := by
        match hax : args x, e with
        | [x0], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          exact e.2.1
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at hx1; simp at hx1
      have hc : c = SS := by
        rcases hfuel with hSS | ⟨y, hy⟩
        · rw [hp] at hSS
          simp only [SS, app.injEq] at hSS
          exact absurd hSS.2 hw
        · rw [hp] at hy
          by_cases hc2 : 2 ≤ (args c).length
          · exact absurd (R_strip c w y hc2 hy).1 hw
          · have hl2 : (args (app c w)).length ≤ 2 := by rw [args_app]; simp; omega
            have e2 := R_short _ _ hl2 hy
            rw [args_app] at e2
            match hac : args c, e2 with
            | [c0], e2 =>
              simp only [List.cons_append, List.nil_append, List.cons.injEq] at e2
              rw [args_one' c c0 hac, e2.1]; rfl
            | [], e2 => simp at e2
            | _ :: _ :: _, _ => rw [hac] at hc2; simp at hc2
      exact ⟨w, by rw [hq, hbw, hc]⟩
  · left
    simp only [List.cons.injEq] at hEq
    exact ⟨y, hy, hEq.2.1⟩

/-- multipliers with at most one argument, and S S X, make no tail call -/
theorem no_tc_small (q q' : T) (h : (args q).length ≤ 1) : ¬ TCStep q q' := by
  intro ⟨p, hr, _⟩
  have := reach_stuck _ _ (by omega) hr
  have hl := congrArg List.length this
  simp at hl; omega

theorem no_tc_SS (X q' : T) : ¬ TCStep (app SS X) q' := by
  intro ⟨p, hr, hf⟩
  have e := reach_stuck _ _ (by rw [args_app]; simp [SS, args]) hr
  have hp : p = S := by
    have : args (app SS X) = [S, X] := rfl
    rw [this] at e
    simp only [List.cons.injEq] at e
    exact e.1
  subst hp
  rcases hf with h | ⟨y, hy⟩
  · cases h
  · exact R_S y hy

/-- a 2-argument multiplier S p z makes the tail call to z -/
theorem tc_two (q q' : T) (h : (args q).length = 2) (ht : TCStep q q') : ∃ p, q = app (app S p) q' := by
  obtain ⟨p, hr, _⟩ := ht
  have e := (reach_stuck _ _ (by omega) hr).symm
  exact ⟨p, args_two q p q' e⟩

/-- I: the multiplier has a last argument of the form S S W -/
def I (q : T) : Prop := ∃ P W, q = app P (app SS W)

theorem I_step (q q1 q2 : T) (hI : I q) (h1 : TCStep q q1) (h2 : TCStep q1 q2) : I q1 := by
  obtain ⟨P, W, rfl⟩ := hI
  by_cases hP : 2 ≤ (args P).length
  · obtain ⟨p, hr, hf⟩ := h1
    rcases tc_detail P (app SS W) p q1 hP hr hf with ⟨y, _, hq⟩ | ⟨w, hq⟩ | ⟨hz, _⟩
    · exact ⟨y, W, hq⟩
    · exact ⟨w, w, hq⟩
    · cases hz
  · exfalso
    by_cases hP1 : (args P).length = 1
    · have h2' : (args (app P (app SS W))).length = 2 := by rw [args_app]; simp; omega
      obtain ⟨p, hq⟩ := tc_two _ _ h2' h1
      -- q1 is the last argument S S W
      have : q1 = app SS W := by
        simp only [app.injEq] at hq; exact hq.2.symm
      rw [this] at h2
      exact no_tc_SS W q2 h2
    · exact no_tc_small _ q1 (by rw [args_app, List.length_append]; simp only [List.length_singleton]; omega) h1

theorem I_forever (f : Nat → T) (hstep : ∀ j, TCStep (f j) (f (j + 1))) (j0 : Nat) (h0 : I (f j0)) :
    ∀ t, I (f (j0 + t)) := by
  intro t
  induction t with
  | zero => simpa using h0
  | succ t ih =>
    exact I_step _ _ _ ih (hstep (j0 + t)) (hstep (j0 + t + 1))

theorem I_lastArg (q : T) (h : I q) : lastArg q ≠ S := by
  obtain ⟨P, W, rfl⟩ := h
  exact SSw_ne_S W

/-- PS: the prefix has last argument S and the last argument is not S -/
def PS (q : T) : Prop := ∃ P z, q = app P z ∧ lastArg P = S ∧ z ≠ S

theorem PS_step (q q1 q2 : T) (hPS : PS q) (hnI : ¬ I q1) (h1 : TCStep q q1) (_h2 : TCStep q1 q2) :
    PS q1 ∧ size q1 < size q := by
  obtain ⟨P, z, rfl, hP, hz⟩ := hPS
  by_cases hP2 : 2 ≤ (args P).length
  · obtain ⟨p, hr, hf⟩ := h1
    rcases tc_detail P z p q1 hP2 hr hf with ⟨y, hy, hq⟩ | ⟨w, hq⟩ | ⟨hzS, _⟩
    · -- an R-step keeps the prefix's last argument S and shrinks the prefix
      match P, hP2, hP, hy with
      | S, hP2, _, _ => simp [args] at hP2
      | app P' S, hP2, _, hy =>
        have hsz := R_shrinks _ _ _ (Nat.le_refl _) hy
        have hly : lastArg y = S := by
          by_cases hP'2 : 2 ≤ (args P').length
          · obtain ⟨_, y', _, hyy⟩ := R_strip P' S y hP'2 hy
            rw [hyy]; rfl
          · have hl2 : (args (app P' S)).length ≤ 2 := by
              rw [args_app, List.length_append]; simp only [List.length_singleton]; omega
            have e := R_short _ _ hl2 hy
            rw [args_app] at e
            have : y = S := by
              have := congrArg List.getLast? e; simp at this; exact this.symm
            rw [this]; rfl
        refine ⟨⟨y, z, hq, hly, hz⟩, ?_⟩
        rw [hq]; simp [size] at hsz ⊢; omega
      | app P' (app _ _), _, hP, _ => simp [lastArg] at hP
    · exact absurd ⟨w, w, hq⟩ hnI
    · exact absurd hzS hz
  · exfalso
    by_cases hP1 : (args P).length = 1
    · -- P = S S
      match P, hP1, hP with
      | app P0 S, hP1, _ =>
        have : args P0 = [] := by
          have := congrArg List.length (show args (app P0 S) = args P0 ++ [S] from rfl)
          rw [hP1] at this; simp at this
          cases h' : args P0 with
          | nil => rfl
          | cons _ _ => rw [h'] at this; simp at this
        have hP0 := args_nil P0 this
        subst hP0
        exact no_tc_SS z q1 h1
      | S, hP1, _ => simp [args] at hP1
      | app _ (app _ _), _, hP => simp [lastArg] at hP
    · exact no_tc_small _ q1 (by rw [args_app, List.length_append]; simp only [List.length_singleton]; omega) h1

/-- in a chain without the invariant I, the steps before a wrap shrink the multiplier -/
theorem shrink_or_wrap (q q1 q2 : T) (hnI : ¬ I q1) (h1 : TCStep q q1) (h2 : TCStep q1 q2) :
    size q1 < size q ∨ PS q1 := by
  by_cases hq : (args q).length ≤ 2
  · left
    by_cases hq1 : (args q).length ≤ 1
    · exact absurd h1 (no_tc_small q q1 hq1)
    · obtain ⟨p, hp⟩ := tc_two q q1 (by omega) h1
      rw [hp]; simp [size]; have := size_pos p; omega
  · match q, hq, h1 with
    | S, hq, _ => simp [args] at hq
    | app Q z, hq, h1 =>
      have hQ : 2 ≤ (args Q).length := by rw [args_app] at hq; simp at hq; omega
      obtain ⟨p, hr, hf⟩ := h1
      rcases tc_detail Q z p q1 hQ hr hf with ⟨y, hy, hq1⟩ | ⟨w, hq1⟩ | ⟨_, x, c, ⟨_, hq1⟩ | ⟨y, _, hq1⟩⟩
      · left
        have := R_shrinks _ _ _ (Nat.le_refl _) hy
        rw [hq1]; simp [size]; omega
      · exact absurd ⟨w, w, hq1⟩ hnI
      · exfalso; rw [hq1] at h2; exact no_tc_small _ q2 (by simp [args]) h2
      · right; exact ⟨app y S, app c S, hq1, rfl, by intro h; cases h⟩

/-- **Every infinite chain of fuel-S tail calls is eventually the reload cycle.** -/
theorem reload_classification_full (f : Nat → T) (hstep : ∀ j, TCStep (f j) (f (j + 1))) :
    ∃ J, ∀ j, J ≤ j → ∃ i m, i < m ∧ f j = app (N i) (N m) := by
  -- step 1: the invariant I holds at some index
  have hI : ∃ j0, I (f j0) := by
    refine Classical.byContradiction (fun hno => ?_)
    have hnI : ∀ j, ¬ I (f j) := fun j h => hno ⟨j, h⟩
    -- either the multipliers shrink forever (impossible) or some step reaches PS, after which they shrink forever
    have hPS : ∃ j, PS (f j) := by
      refine Classical.byContradiction (fun hno2 => ?_)
      have hdec : ∀ j, size (f (j + 1)) < size (f j) := by
        intro j
        rcases shrink_or_wrap _ _ _ (hnI (j + 1)) (hstep j) (hstep (j + 1)) with h | h
        · exact h
        · exact absurd ⟨j + 1, h⟩ hno2
      have : ∀ k, size (f k) + k ≤ size (f 0) := by
        intro k
        induction k with
        | zero => simp
        | succ k ih => have := hdec k; omega
      have := this (size (f 0) + 1); omega
    obtain ⟨j1, hj1⟩ := hPS
    have hPSall : ∀ t, PS (f (j1 + t)) ∧ size (f (j1 + t)) + t ≤ size (f j1) := by
      intro t
      induction t with
      | zero => exact ⟨by simpa using hj1, by simp⟩
      | succ t ih =>
        obtain ⟨hps, hsz⟩ := ih
        obtain ⟨hps', hlt⟩ := PS_step _ _ _ hps (hnI (j1 + t + 1)) (hstep (j1 + t)) (hstep (j1 + t + 1))
        rw [show j1 + (t + 1) = j1 + t + 1 by omega]
        exact ⟨hps', by omega⟩
    have := (hPSall (size (f j1) + 1)).2; omega
  -- step 2: from there on the last arguments are not S; apply the classification
  obtain ⟨j0, h0⟩ := hI
  have hall := I_forever f hstep j0 h0
  obtain ⟨J, hJ⟩ := reload_classification (fun t => f (j0 + t))
    (fun t => by rw [show j0 + (t + 1) = j0 + t + 1 by omega]; exact hstep (j0 + t))
    (fun t => I_lastArg _ (hall t))
  refine ⟨j0 + J, fun j hj => ?_⟩
  have := hJ (j - j0) (by omega)
  rw [show j0 + (j - j0) = j by omega] at this
  exact this

end RC2


/-- **Walk-level, unconditional.**  An infinite leftmost walk through nodes q_j.S in which every child is the next node
    q_(j+1).S (pure tail calls over the fuel S, every q_j with >= 2 arguments) is eventually the reload cycle. -/
theorem walk_reload_full (f : Nat → C.T) (d : Nat → C.T)
    (h : ∀ j, 2 ≤ (C.args (f j)).length ∧ C.Reach (C.args (C.T.app (f j) C.T.S)) [C.T.app (f (j + 1)) C.T.S, d j]) :
    ∃ J, ∀ j, J ≤ j → ∃ i m, i < m ∧ f j = C.T.app (RC.N i) (RC.N m) :=
  RC2.reload_classification_full f (fun j => FZ.tail_call_S (f j) (f (j + 1)) (d j) (h j).1 (h j).2)


/-! ## End-to-end: the tail-call scenario of the leftmost-path finite half -/

namespace FH

open C
open C.T

/-- closed terms of namespace C as terms of the main agent's PathModels (namespace PM) -/
def toTm : C.T → PM.Tm
  | C.T.S => PM.Tm.S
  | C.T.app f x => PM.Tm.app (toTm f) (toTm x)

theorem toTm_args : ∀ t : C.T, PM.args (toTm t) = (C.args t).map toTm
  | C.T.S => rfl
  | C.T.app f x => by simp [toTm, PM.args, C.args, toTm_args f]

theorem step_toTm (L : List C.T) : PM.step (L.map toTm) = (C.step L).map (List.map toTm) := by
  match L with
  | [] => rfl
  | [_] => rfl
  | [_, _] => rfl
  | a :: b :: c :: R => simp [PM.step, C.step, toTm_args, toTm]

theorem run_snoc : ∀ (n : Nat) (A L L' : List PM.Tm), PM.run n A = some L → PM.step L = some L' →
    PM.run (n + 1) A = some L'
  | 0, A, L, L', h, hs => by
    simp only [PM.run, Option.some.injEq] at h; subst h
    simp only [PM.run, hs]
  | n + 1, A, L, L', h, hs => by
    simp only [PM.run] at h
    cases h1 : PM.step A with
    | none => rw [h1] at h; simp at h
    | some A1 =>
      rw [h1] at h
      have := run_snoc n A1 L L' h hs
      simp only [PM.run, h1]
      exact this

theorem reach_run (A B : List C.T) (h : C.Reach A B) : ∃ n, PM.run n (A.map toTm) = some (B.map toTm) := by
  induction h with
  | refl => exact ⟨0, rfl⟩
  | tail _ hs ih =>
    obtain ⟨n, hn⟩ := ih
    refine ⟨n + 1, run_snoc n _ _ _ hn ?_⟩
    rw [step_toTm, hs]; rfl

/-- the L36 flag of a closed term -/
def flag (t : C.T) : Bool := PM.flagLft (PM.clsLft (toTm t))

/-- one leftmost step -/
def LChild (u u' : C.T) : Prop :=
  ((C.args u).length ≤ 2 ∧ ∃ rest, C.args u = u' :: rest) ∨
  (3 ≤ (C.args u).length ∧ ∃ d, C.Reach (C.args u) [u', d])

theorem kC_facts : (∀ x, x < 36 → PM.flagLft (PM.mulLft 0 x) = PM.flagLft x) ∧
    (∀ x, x < 36 → ∀ y, y < 36 → PM.flagLft (PM.mulLft (PM.mulLft 0 x) y) = PM.flagLft x) := by
  have hk := PM.kCLft
  simp only [PM.checkCLft, Bool.and_eq_true, List.all_eq_true, List.mem_range, beq_iff_eq, PM.RNLft,
    Bool.not_eq_true'] at hk
  exact ⟨hk.1.2, hk.2⟩

/-- **Flag invariance**: the L36 flag is constant along a leftmost step (the main agent's closure facts and class
    invariance under head reduction). -/
theorem flag_step (u u' : C.T) (h : LChild u u') : flag u = flag u' := by
  obtain ⟨k1, k2⟩ := kC_facts
  have hcls : PM.clsLft (toTm u) = PM.clsLLft ((C.args u).map toTm) := by
    rw [PM.clsLft_args, toTm_args]
  rcases h with ⟨hlen, rest, hr⟩ | ⟨_, d, hr⟩
  · unfold flag
    rw [hcls, hr]
    match rest with
    | [] =>
      simp only [List.map_cons, List.map_nil, PM.clsLLft, List.foldl]
      exact k1 _ (PM.clsLft_lt _)
    | [y] =>
      simp only [List.map_cons, List.map_nil, PM.clsLLft, List.foldl]
      exact k2 _ (PM.clsLft_lt _) _ (PM.clsLft_lt _)
    | _ :: _ :: _ =>
      exfalso
      rw [hr] at hlen; simp at hlen
  · obtain ⟨n, hn⟩ := reach_run _ _ hr
    have hinv := PM.clsLLft_run n _ _ hn
    unfold flag
    rw [hcls, hinv]
    simp only [List.map_cons, List.map_nil, PM.clsLLft, List.foldl]
    exact k2 _ (PM.clsLft_lt _) _ (PM.clsLft_lt _)

theorem flag_walk (u : Nat → C.T) (h : ∀ j, LChild (u j) (u (j + 1))) : ∀ j, flag (u j) = flag (u 0) := by
  intro j
  induction j with
  | zero => rfl
  | succ j ih => rw [← flag_step _ _ (h j), ih]

set_option maxRecDepth 200000 in
/-- the L36 classes of the counters: N 0 = B and N k for k >= 1 -/
theorem cls_N_succ : ∀ k, PM.clsLft (toTm (RC.N (k + 1))) = PM.clsLft (toTm (RC.N 1))
  | 0 => rfl
  | k + 1 => by
    have ih := cls_N_succ k
    show PM.mulLft (PM.clsLft (toTm RC.SS)) (PM.clsLft (toTm (RC.N (k + 1)))) = PM.clsLft (toTm (RC.N 1))
    rw [ih]
    decide +kernel

set_option maxRecDepth 200000 in
/-- every reload node N_i N_m S (i < m) has flag 1 -/
theorem flag_reload (i m : Nat) (him : i < m) : flag (app (app (RC.N i) (RC.N m)) S) = true := by
  unfold flag
  show PM.flagLft (PM.mulLft (PM.mulLft (PM.clsLft (toTm (RC.N i))) (PM.clsLft (toTm (RC.N m)))) 0) = true
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  rw [cls_N_succ m']
  cases i with
  | zero => decide +kernel
  | succ i => rw [cls_N_succ i]; decide +kernel

/-- **Theorem (finite half, tail-call scenario).**  Let u be an infinite leftmost walk (each u (j+1) the leftmost
    child of u j) starting from a closed S-term whose L36 class has flag 0 — e.g. any term of the joint classes
    (14,28), (14,26).  Then the walk does NOT eventually consist of tail calls over a fixed bottom: there are no j0,
    Z and multipliers f with u (j0 + j) = (f j).Z and f j having >= 2 arguments for all j. -/
theorem finite_half_TC (u : Nat → C.T) (hchild : ∀ j, LChild (u j) (u (j + 1))) (hflag : flag (u 0) = false)
    (j0 : Nat) (Z : C.T) (f : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (f j) Z ∧ 2 ≤ (C.args (f j)).length) : False := by
  -- each step is a tail call over Z
  have htc : ∀ j, ∃ d, C.Reach (C.args (app (f j) Z)) [app (f (j + 1)) Z, d] := by
    intro j
    have hc := hchild (j0 + j)
    rw [(hform j).1, show j0 + j + 1 = j0 + (j + 1) by omega, (hform (j + 1)).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, d, hr⟩
    · exfalso
      rw [C.args_app] at hlen
      have := (hform j).2
      simp at hlen; omega
    · exact ⟨d, hr⟩
  by_cases hZ : Z = S
  · subst hZ
    obtain ⟨J, hJ⟩ := walk_reload_full f (fun j => Classical.choose (htc j))
      (fun j => ⟨(hform j).2, Classical.choose_spec (htc j)⟩)
    obtain ⟨i, m, him, hfJ⟩ := hJ J (Nat.le_refl J)
    have h1 := flag_walk u hchild (j0 + J)
    rw [(hform J).1, hfJ, flag_reload i m him, hflag] at h1
    exact absurd h1 (by decide)
  · exact FZ.no_tail_calls_fuel Z hZ f (fun j => ⟨(hform j).2, htc j⟩)

end FH

#print axioms FH.flag_step
#print axioms FH.finite_half_TC

/-! ## The Omega cycle: walks of R2 tail calls and canonical Omega steps -/

namespace OM

open C
open C.T
open TC
open RC

/-- S(SS) -/
def SSS1 : T := app S SS
/-- M = S (S(SS)) (S(SS)) -/
def M : T := app (app S SSS1) SSS1
/-- w 0 = M, w (k+1) = S (SS) (w k) -/
def w : Nat → T
  | 0 => M
  | k + 1 => app (app S SS) (w k)

/-- H(W) = S (S(SS)) W' -/
def Om (W W' : T) : Prop := Reach (args W) [SSS1, W']

/-- the full history of the wraps of the bottom z (each wrap [x, c, w] -> args x ++ [w, c w]) -/
inductive WH (Q z : T) : T → T → T → Prop
  | first (x c : T) : Reach (args Q) [x, c] → WH Q z x c z
  | next (x0 c0 w0 x c : T) : WH Q z x0 c0 w0 → Reach (args x0 ++ [w0]) [x, c] → WH Q z x c (app c0 w0)

theorem wh_size (Q z x c w : T) (h : WH Q z x c w) : size z ≤ size w := by
  induction h with
  | first => exact Nat.le_refl _
  | next _ _ _ _ _ _ _ ih => simp [size]; omega

def CInv2 (Q z : T) (L : List T) : Prop :=
  (∃ L1, Reach (args Q) L1 ∧ 2 ≤ L1.length ∧ L = L1 ++ [z]) ∨
  (∃ x c w P, x ≠ S ∧ WH Q z x c w ∧ Reach (args x ++ [w]) P ∧ 2 ≤ P.length ∧ L = P ++ [app c w]) ∨
  (∃ x c w b, x ≠ S ∧ WH Q z x c w ∧ Reach (args x ++ [w]) [S, b] ∧ L = [app c w, app b (app c w)]) ∨
  (∃ y, Reach (args Q) [S, y] ∧ L = [z, app y z])

theorem cinv2_step (Q z : T) (L L' : List T) (hI : CInv2 Q z L) (hs : step L = some L') : CInv2 Q z L' := by
  rcases hI with ⟨L1, hr, hlen, rfl⟩ | ⟨x, c, w, P, hx, hH, hP, hlen, rfl⟩ | ⟨_, _, _, _, _, _, _, rfl⟩ |
      ⟨_, _, rfl⟩
  · by_cases h3 : 3 ≤ L1.length
    · obtain ⟨L1', h1'⟩ := step_exists L1 h3
      rw [step_append L1 L1' [z] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inl ⟨L1', Reach.tail hr h1', step_len _ _ h1', rfl⟩
    · have h2 : L1.length = 2 := by omega
      match L1, h2, hr, hs with
      | [x, c], _, hr, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hxS : x = S
        · subst hxS
          exact Or.inr (Or.inr (Or.inr ⟨c, hr, by simp [args]⟩))
        · refine Or.inr (Or.inl ⟨x, c, z, args x ++ [z], hxS, WH.first x c hr, Reach.refl, ?_, by simp⟩)
          have := args_ne_nil x hxS; simp; omega
  · by_cases h3 : 3 ≤ P.length
    · obtain ⟨P', h1'⟩ := step_exists P h3
      rw [step_append P P' [app c w] h3 h1'] at hs
      simp only [Option.some.injEq] at hs
      subst hs
      exact Or.inr (Or.inl ⟨x, c, w, P', hx, hH, Reach.tail hP h1', step_len _ _ h1', rfl⟩)
    · have h2 : P.length = 2 := by omega
      match P, h2, hP, hs with
      | [x', c'], _, hP, hs =>
        simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
        subst hs
        by_cases hxS : x' = S
        · subst hxS
          exact Or.inr (Or.inr (Or.inl ⟨x, c, w, c', hx, hH, hP, by simp [args]⟩))
        · refine Or.inr (Or.inl ⟨x', c', app c w, args x' ++ [app c w], hxS,
            WH.next x c w x' c' hH hP, Reach.refl, ?_, by simp⟩)
          have := args_ne_nil x' hxS; simp; omega
  · simp [step] at hs
  · simp [step] at hs

theorem cinv2_reach (Q z : T) (hQ : 2 ≤ (args Q).length) (L : List T)
    (h : Reach (args Q ++ [z]) L) : CInv2 Q z L := by
  induction h with
  | refl => exact Or.inl ⟨args Q, Reach.refl, hQ, rfl⟩
  | tail _ hs ih => exact cinv2_step Q z _ _ ih hs

theorem size_app_ne (a b : T) : app a b ≠ b := by
  intro h; have := congrArg size h; simp [size] at this; have := size_pos a; omega

theorem size_le_one (t : T) (h : size t ≤ 1) : t = S := by
  cases t with
  | S => rfl
  | app f x => simp [size] at h; have := size_pos f; have := size_pos x; omega

/-- **Omega-step detection.**  If t has >= 2 arguments, sigma /= S, and the leftmost child of the node t.sigma is
    sigma.(q'.sigma) (the stack copied on top of q' pushed on the stack), then H(t) = S (S(SS)) q'. -/
theorem omega_detect (t σ q' d : T) (ht : 2 ≤ (args t).length) (hσ : σ ≠ S)
    (h : Reach (args (app t σ)) [app σ (app q' σ), d]) : Om t q' := by
  rw [args_app] at h
  rcases cinv2_reach t σ ht _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w', b, hx, hH, hP, hEq⟩ | ⟨y, _, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · simp only [List.cons.injEq, app.injEq] at hEq
    obtain ⟨⟨hcσ, hwq⟩, _⟩ := hEq
    -- w' = q'.sigma is not S: the prefix args x ++ [w'] reached [S, b] in zero steps, so x = S S
    have hw'S : w' ≠ S := by rw [← hwq]; intro h; cases h
    have hx1 : (args x).length = 1 := by
      by_cases hx2 : 2 ≤ (args x).length
      · rcases final_shape (args x) w' S b hx2 hP with ⟨hwS, _⟩ | hbig
        · exact absurd hwS.symm hw'S
        · exact absurd (size_le_one w' (by simp [size] at hbig; omega)) hw'S
      · have := args_ne_nil x hx; omega
    have hl : (args x ++ [w']).length ≤ 2 := by simp; omega
    have e := reach_stuck _ _ hl hP
    have hxSS : x = SS := by
      match hax : args x, e with
      | [x1], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        rw [args_one' x x1 hax, ← e.1]; rfl
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hax] at hx1; simp at hx1
    cases hH with
    | first _ _ _ => exact absurd hwq (size_app_ne q' σ)
    | next x0 c0 w0 _ _ hH0 hr0 =>
      simp only [app.injEq] at hwq
      obtain ⟨hq0, hσ0⟩ := hwq
      rw [hxSS, ← hcσ, ← hσ0] at hr0
      -- args x0 ++ [sigma] reaches [S S, sigma] only in zero steps: x0 = S(SS)
      have hx0 : x0 = SSS1 := by
        by_cases hx02 : 2 ≤ (args x0).length
        · exfalso
          rcases final_shape (args x0) σ SS σ hx02 hr0 with ⟨_, y, _, hy⟩ | hbig
          · exact size_app_ne y σ hy.symm
          · exact hσ (size_le_one σ (by simp [SS, size] at hbig; omega))
        · have hl0 : (args x0 ++ [σ]).length ≤ 2 := by simp; omega
          have e0 := reach_stuck _ _ hl0 hr0
          match hax0 : args x0, e0 with
          | [x1], e0 =>
            simp only [List.cons_append, List.nil_append, List.cons.injEq] at e0
            rw [args_one' x0 x1 hax0, ← e0.1]; rfl
          | [], e0 => simp at e0
          | _ :: _ :: _, _ => rw [hax0] at hx02; simp at hx02
      rw [hx0, ← hq0, ← hσ0] at hH0
      cases hH0 with
      | first _ _ hrt => exact hrt
      | next x1 c1 w1 _ _ hH1 _ =>
        exfalso
        have h1 := wh_size _ _ _ _ _ hH1
        simp [size] at h1
        have := size_pos c1
        omega
  · simp only [List.cons.injEq] at hEq
    exfalso
    have := congrArg size hEq.1
    simp [size] at this
    have := size_pos q'
    omega

end OM
#print axioms OM.omega_detect

namespace OM

open C
open C.T
open TC
open RC

theorem SSS1_ne_SS : SSS1 ≠ SS := by
  intro h; simp only [SSS1, SS, app.injEq] at h; cases h.2

theorem w_ne_SS (k : Nat) : w k ≠ SS := by
  cases k with
  | zero => intro h; simp only [w, M, SS, app.injEq] at h; cases h.1
  | succ k => intro h; simp only [w, SS, app.injEq] at h; cases h.1

theorem lastArg_w (k : Nat) : lastArg (w k) ≠ SS := by
  cases k with
  | zero => exact SSS1_ne_SS
  | succ k => exact w_ne_SS k

/-- the middle argument of a 2-argument application -/
def mid : T → T
  | app (app _ a) _ => a
  | _ => S

theorem w_succ_ne_M (k : Nat) : w (k + 1) ≠ M := by
  intro h
  have := congrArg mid h
  exact SSS1_ne_SS this.symm

/-- R2-steps into a term whose last argument is not S S are syntactic -/
theorem R2_into (Y V : T) (hV : lastArg V ≠ SS) (h : R2 Y V) : Y = app (app S SS) V := by
  by_cases h2 : (args Y).length ≤ 2
  · have e := (reach_stuck _ _ h2 h).symm
    exact args_two Y SS V e
  · obtain ⟨b, hb⟩ := final_app _ _ _ (by omega) h
    rw [hb] at hV; exact absurd rfl hV

/-- H(Y) = S (S(SS)) (S(SS)) forces Y = M -/
theorem Om_M (Y : T) (h : Om Y SSS1) : Y = M := by
  by_cases h2 : (args Y).length ≤ 2
  · have e := (reach_stuck _ _ h2 h).symm
    exact args_two Y SSS1 SSS1 e
  · exfalso
    obtain ⟨b, hb⟩ := final_app _ _ _ (by omega) h
    have := congrArg size hb
    simp [size] at this
    have := size_pos b
    omega

/-- an R2-chain of length d ending at M starts at w d -/
theorem Rchain_to_M : ∀ (d : Nat) (y : Nat → T), y d = M → (∀ s, s < d → R2 (y s) (y (s + 1))) → y 0 = w d := by
  intro d
  induction d with
  | zero => intro y h _; simpa [w] using h
  | succ d ih =>
    intro y hd hR
    have h1 := ih (fun s => y (s + 1)) hd (fun s hs => hR (s + 1) (by omega))
    have h0 := R2_into (y 0) (y 1) (by rw [h1]; exact lastArg_w d) (hR 0 (by omega))
    rw [h0, h1]; rfl

/-- determinism of R2 on w (i+1) -/
theorem R2_w (i : Nat) (t' : T) (h : R2 (w (i + 1)) t') : t' = w i := by
  have e := (reach_stuck _ _ (by simp [w, args]) h)
  have : args (w (i + 1)) = [SS, w i] := rfl
  rw [this] at e
  simp only [List.cons.injEq] at e
  exact e.2.1

theorem not_R2_M (t' : T) : ¬ R2 M t' := by
  intro h
  have e := (reach_stuck _ _ (by simp [M, args]) h)
  have : args M = [SSS1, SSS1] := rfl
  rw [this] at e
  simp only [List.cons.injEq] at e
  exact SSS1_ne_SS e.1.symm

end OM

namespace FH

open C
open C.T

set_option maxRecDepth 200000 in
theorem cls_w_succ : ∀ k, PM.clsLft (toTm (OM.w (k + 1))) = PM.clsLft (toTm (OM.w 1))
  | 0 => rfl
  | k + 1 => by
    have ih := cls_w_succ k
    show PM.mulLft (PM.clsLft (toTm (app S RC.SS))) (PM.clsLft (toTm (OM.w (k + 1)))) = PM.clsLft (toTm (OM.w 1))
    rw [ih]
    decide +kernel

set_option maxRecDepth 200000 in
/-- the Omega nodes w_i w_k with i < k or i = 0 are flag 1 -/
theorem flag_omega (i k : Nat) (h : i < k ∨ i = 0) : flag (app (OM.w i) (OM.w k)) = true := by
  unfold flag
  show PM.flagLft (PM.mulLft (PM.clsLft (toTm (OM.w i))) (PM.clsLft (toTm (OM.w k)))) = true
  cases i with
  | zero =>
    cases k with
    | zero => decide +kernel
    | succ k => rw [cls_w_succ k]; decide +kernel
  | succ i =>
    rcases h with h | h
    · obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      rw [cls_w_succ i, cls_w_succ k']; decide +kernel
    · cases h

/-- **Theorem (finite half, Omega scenario).**  An infinite leftmost walk from a term whose L36 class has flag 0
    never ends in a sequence of nodes (t j).(s j) (t j with >= 2 arguments, s j /= S) in which every step is either a
    tail call over the stack (s (j+1) = s j) or a canonical Omega step (t (j+1) = s j, s (j+1) = S(SS).(s j)). -/
theorem finite_half_Omega (u : Nat → C.T) (hchild : ∀ j, LChild (u j) (u (j + 1))) (hflag : flag (u 0) = false)
    (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length ∧ s j ≠ S)
    (hstep : ∀ j, s (j + 1) = s j ∨ (t (j + 1) = s j ∧ s (j + 1) = app OM.SSS1 (s j))) : False := by
  -- the computed step from each node
  have hreach : ∀ j, ∃ d, C.Reach (C.args (app (t j) (s j))) [app (t (j + 1)) (s (j + 1)), d] := by
    intro j
    have hc := hchild (j0 + j)
    rw [(hform j).1, show j0 + j + 1 = j0 + (j + 1) by omega, (hform (j + 1)).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, d, hr⟩
    · exfalso; rw [C.args_app] at hlen; have := (hform j).2.1; simp at hlen; omega
    · exact ⟨d, hr⟩
  -- tail calls are R2-steps of the tops; Omega steps happen at the top M
  have hR2 : ∀ j, s (j + 1) = s j → R2 (t j) (t (j + 1)) := by
    intro j hs
    obtain ⟨d, hr⟩ := hreach j
    rw [hs] at hr
    exact FZ.tail_call_fuel (t j) (t (j + 1)) (s j) d (hform j).2.1 (hform j).2.2 hr
  have hOm : ∀ j, t (j + 1) = s j → s (j + 1) = app OM.SSS1 (s j) → t j = OM.M := by
    intro j ht hs
    obtain ⟨d, hr⟩ := hreach j
    rw [ht, hs] at hr
    exact OM.Om_M _ (OM.omega_detect (t j) (s j) OM.SSS1 d (hform j).2.1 (hform j).2.2 hr)
  have hnotboth : ∀ j, ¬ (s (j + 1) = s j ∧ s (j + 1) = app OM.SSS1 (s j)) := by
    intro j ⟨h1, h2⟩
    rw [h1] at h2
    exact OM.size_app_ne _ _ h2.symm
  -- infinitely many Omega steps
  have hinf : ∀ N, ∃ j, N ≤ j ∧ s (j + 1) ≠ s j := by
    intro N
    refine Classical.byContradiction (fun hno => ?_)
    have hall : ∀ j, N ≤ j → s (j + 1) = s j := fun j hj =>
      Classical.byContradiction (fun h => hno ⟨j, hj, h⟩)
    exact no_R2_chain (fun i => t (N + i)) (fun i => by
      have := hR2 (N + i) (hall (N + i) (by omega))
      rw [show N + (i + 1) = N + i + 1 by omega]; exact this)
  -- an Omega step at j1 and a later one at j2: the stack at j1 is a counter w d
  have homega : ∀ j, s (j + 1) ≠ s j → t (j + 1) = s j ∧ s (j + 1) = app OM.SSS1 (s j) := by
    intro j h
    rcases hstep j with h1 | h1
    · exact absurd h1 h
    · exact h1
  have next_omega : ∀ (dd j : Nat), s (j + 1) ≠ s j → s (j + dd + 2) ≠ s (j + dd + 1) →
      ∃ d, s j = OM.w d := by
    intro dd
    induction dd using Nat.strongRecOn with
    | _ dd ih =>
      intro j hj hjd
      by_cases hmid : ∃ e, e < dd ∧ s (j + e + 2) ≠ s (j + e + 1)
      · obtain ⟨e, he, hne⟩ := hmid
        exact ih e he j hj hne
      · -- between j+1 and j+dd+1 only tail calls: the tops t (j+1), ..., t (j+dd+1) form an R2-chain ending at M
        have htail : ∀ e, e < dd → s (j + e + 2) = s (j + e + 1) := fun e he =>
          Classical.byContradiction (fun h => hmid ⟨e, he, h⟩)
        obtain ⟨ht1, _⟩ := homega j hj
        obtain ⟨_, _⟩ := homega (j + dd + 1) hjd
        have hM : t (j + dd + 1) = OM.M := hOm (j + dd + 1) (homega _ hjd).1 (homega _ hjd).2
        have hchain := OM.Rchain_to_M dd (fun e => t (j + 1 + e)) (by show t (j + 1 + dd) = OM.M; rw [show j + 1 + dd = j + dd + 1 by omega]; exact hM)
          (fun e he => by
            show R2 (t (j + 1 + e)) (t (j + 1 + (e + 1)))
            have := hR2 (j + 1 + e) (by rw [show j + 1 + e + 1 = j + e + 2 by omega, show j + 1 + e = j + e + 1 by omega]; exact htail e he)
            rw [show j + 1 + (e + 1) = j + 1 + e + 1 by omega]; exact this)
        simp only [Nat.add_zero] at hchain
        exact ⟨dd, by rw [← ht1]; exact hchain⟩
  obtain ⟨j1, _, hj1⟩ := hinf 0
  obtain ⟨j2, hj2, hj2'⟩ := hinf (j1 + 1)
  obtain ⟨d, hd⟩ := next_omega (j2 - j1 - 1) j1 hj1
    (by rw [show j1 + (j2 - j1 - 1) + 2 = j2 + 1 by omega, show j1 + (j2 - j1 - 1) + 1 = j2 by omega]; exact hj2')
  have htj1 : t j1 = OM.M := hOm j1 (homega j1 hj1).1 (homega j1 hj1).2
  -- from j1 on, the state is an Omega node (w i, w k) with i < k or i = 0
  have inv : ∀ e, ∃ i k, (i < k ∨ i = 0) ∧ t (j1 + e) = OM.w i ∧ s (j1 + e) = OM.w k := by
    intro e
    induction e with
    | zero => exact ⟨0, d, Or.inr rfl, by simpa [OM.w] using htj1, by simpa using hd⟩
    | succ e ih =>
      obtain ⟨i, k, hik, hti, hsk⟩ := ih
      rw [show j1 + (e + 1) = j1 + e + 1 by omega]
      rcases hstep (j1 + e) with hs | ⟨ht, hs⟩
      · -- tail call: i >= 1 and the top counts down
        have hr := hR2 (j1 + e) hs
        rw [hti] at hr
        cases i with
        | zero => exact absurd hr (OM.not_R2_M _)
        | succ i =>
          refine ⟨i, k, ?_, OM.R2_w i _ hr, by rw [hs, hsk]⟩
          rcases hik with h | h
          · left; omega
          · cases h
      · -- Omega step: the top was M, i.e. i = 0
        refine ⟨k, k + 1, Or.inl (by omega), by rw [ht, hsk], by rw [hs, hsk]; rfl⟩
  obtain ⟨i, k, hik, hti, hsk⟩ := inv 0
  have hfl := flag_walk u hchild (j0 + (j1 + 0))
  rw [(hform (j1 + 0)).1, hti, hsk, flag_omega i k hik, hflag] at hfl
  exact absurd hfl (by decide)

end FH

#print axioms FH.finite_half_Omega

namespace FH
open C
open C.T

/-- **Combined theorem.**  An infinite leftmost walk from a term whose L36 class has flag 0 (e.g. in (14,28),
    (14,26)) never ends in a sequence of computed nodes (t j).(s j) whose steps are tail calls over the stack
    (s (j+1) = s j) or canonical Omega steps (t (j+1) = s j, s (j+1) = S(SS).(s j)) — i.e. it never ends in the step
    families of the two known infinite mechanisms (reload cycle, Omega cycle). -/
theorem finite_half_families (u : Nat → C.T) (hchild : ∀ j, LChild (u j) (u (j + 1))) (hflag : flag (u 0) = false)
    (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length)
    (hstep : ∀ j, s (j + 1) = s j ∨ (t (j + 1) = s j ∧ s (j + 1) = app OM.SSS1 (s j))) : False := by
  by_cases hfin : ∃ N, ∀ j, N ≤ j → s (j + 1) = s j
  · -- finitely many Omega steps: from N on the bottom is fixed, a tail-call walk
    obtain ⟨N, hN⟩ := hfin
    have hconst : ∀ e, s (N + e) = s N := by
      intro e
      induction e with
      | zero => rfl
      | succ e ih => rw [show N + (e + 1) = N + e + 1 by omega, hN (N + e) (by omega), ih]
    exact finite_half_TC u hchild hflag (j0 + N) (s N) (fun e => t (N + e))
      (fun e => ⟨by rw [show j0 + N + e = j0 + (N + e) by omega, (hform (N + e)).1, hconst e], (hform (N + e)).2⟩)
  · -- some Omega step at j1: afterwards the stack is never S
    have : ∃ j1, s (j1 + 1) ≠ s j1 := by
      refine Classical.byContradiction (fun h => hfin ⟨0, fun j _ => Classical.byContradiction (fun h' => h ⟨j, h'⟩)⟩)
    obtain ⟨j1, hj1⟩ := this
    have hne : ∀ e, s (j1 + 1 + e) ≠ S := by
      intro e
      induction e with
      | zero =>
        rcases hstep j1 with h | ⟨_, h⟩
        · exact absurd h hj1
        · simp only [Nat.add_zero]; rw [h]; intro h'; cases h'
      | succ e ih =>
        rw [show j1 + 1 + (e + 1) = j1 + 1 + e + 1 by omega]
        rcases hstep (j1 + 1 + e) with h | ⟨_, h⟩
        · rw [h]; exact ih
        · rw [h]; intro h'; cases h'
    exact finite_half_Omega u hchild hflag (j0 + (j1 + 1)) (fun e => t (j1 + 1 + e)) (fun e => s (j1 + 1 + e))
      (fun e => ⟨by rw [show j0 + (j1 + 1) + e = j0 + (j1 + 1 + e) by omega]; exact (hform _).1,
        (hform _).2, hne e⟩)
      (fun e => by
        have := hstep (j1 + 1 + e)
        simp only [show j1 + 1 + (e + 1) = j1 + 1 + e + 1 by omega]
        exact this)

end FH

#print axioms FH.finite_half_families

/-! ## The rightmost path: the reload mechanism (R19 finite half, reload scenario) -/

namespace RR

open C
open C.T
open TC
open RC

/-- one rightmost step: the last argument of a node with <= 2 arguments, or the second component of the head normal
    form of a node with >= 3 arguments -/
def RChildC (u u' : T) : Prop :=
  ((args u).length ≤ 2 ∧ ∃ front, args u = front ++ [u']) ∨
  (3 ≤ (args u).length ∧ ∃ c, Reach (args u) [c, u'])

/-- a rightmost tail call t.sigma -> t'.sigma forces H(t) = S S t' -/
theorem right_tail_detect (t σ c t' : T) (ht : 2 ≤ (args t).length) (h : Reach (args (app t σ)) [c, app t' σ]) :
    R t t' := by
  rw [args_app] at h
  rcases final_shape (args t) σ c (app t' σ) ht h with ⟨_, y, hy, hd⟩ | hbig
  · simp only [app.injEq] at hd; rw [hd.1]; exact hy
  · exfalso
    obtain ⟨b, hb⟩ := final_app _ _ _ (by simp; omega) h
    simp only [app.injEq] at hb
    rw [← hb.2] at hbig
    omega

/-- a rightmost reload step t.sigma -> sigma.(S S sigma) (sigma /= S) forces t = B -/
theorem right_reload_detect (t σ c : T) (ht : 2 ≤ (args t).length) (hσ : σ ≠ S)
    (h : Reach (args (app t σ)) [c, app σ (app SS σ)]) : t = B := by
  rw [args_app] at h
  obtain ⟨b0, hb0⟩ := final_app _ _ _ (by simp; omega) h
  simp only [app.injEq] at hb0
  obtain ⟨_, hcSS⟩ := hb0
  rcases OM.cinv2_reach t σ ht _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c', w', b', hx, hH, hP, hEq⟩ | ⟨y, _, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · have e2 : app σ (app SS σ) = app b' (app c' w') := by
      have := congrArg (fun l : List T => l.getD 1 S) hEq; simpa using this
    simp only [app.injEq] at e2
    obtain ⟨hb', hc', hw'⟩ := e2
    subst hb'; subst hc'; subst hw'
    -- the prefix args x ++ [sigma] reached [S, sigma] in zero steps: x = S S
    have hxSS : x = SS := by
      by_cases hx2 : 2 ≤ (args x).length
      · exfalso
        rcases final_shape (args x) σ S σ hx2 hP with ⟨hS, _⟩ | hbig
        · exact hσ hS.symm
        · exact hσ (OM.size_le_one σ (by simp [size] at hbig; omega))
      · have hl : (args x ++ [σ]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [x1], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          rw [args_one' x x1 hax, ← e.1]; rfl
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at hx2; simp at hx2
    subst hxSS
    cases hH with
    | first _ _ hrt =>
      have := reach_SSSS _ hrt
      exact args_two t SS SS this
    | next x0 c0 w0 _ _ hH0 _ =>
      exfalso
      have h1 := OM.wh_size _ _ _ _ _ hH0
      simp [size] at h1
      have := size_pos c0
      omega
  · simp only [List.cons.injEq] at hEq
    exfalso
    rw [← hcSS] at hEq
    exact OM.size_app_ne SS σ hEq.1

end RR

#print axioms RR.right_tail_detect
#print axioms RR.right_reload_detect

namespace RR

open C
open C.T
open TC
open RC

/-- the R19 flag of a closed term -/
def flagR (t : C.T) : Bool := PM.flagRgt (PM.clsRgt (FH.toTm t))

theorem kCR_facts : (∀ x, x < 19 → PM.flagRgt (PM.mulRgt 0 x) = PM.flagRgt x) ∧
    (∀ x, x < 19 → ∀ y, y < 19 → PM.flagRgt (PM.mulRgt (PM.mulRgt 0 x) y) = PM.flagRgt y) := by
  have hk := PM.kCRgt
  simp only [PM.checkCRgt, Bool.and_eq_true, List.all_eq_true, List.mem_range, beq_iff_eq, PM.RNRgt,
    Bool.not_eq_true'] at hk
  exact ⟨hk.1.2, hk.2⟩

/-- **Flag invariance for the rightmost path**: the R19 flag is constant along every rightmost step -/
theorem flagR_step (u u' : C.T) (h : RChildC u u') : flagR u = flagR u' := by
  obtain ⟨k1, k2⟩ := kCR_facts
  have hcls : PM.clsRgt (FH.toTm u) = PM.clsLRgt ((C.args u).map FH.toTm) := by
    rw [PM.clsRgt_args, FH.toTm_args]
  rcases h with ⟨hlen, front, hr⟩ | ⟨_, c, hr⟩
  · unfold flagR
    rw [hcls, hr]
    match front with
    | [] =>
      simp only [List.nil_append, List.map_cons, List.map_nil, PM.clsLRgt, List.foldl]
      exact k1 _ (PM.clsRgt_lt _)
    | [a] =>
      simp only [List.cons_append, List.nil_append, List.map_cons, List.map_nil, PM.clsLRgt, List.foldl]
      exact k2 _ (PM.clsRgt_lt _) _ (PM.clsRgt_lt _)
    | _ :: _ :: _ =>
      exfalso
      rw [hr] at hlen; simp at hlen
  · obtain ⟨n, hn⟩ := FH.reach_run _ _ hr
    have hinv := PM.clsLRgt_run n _ _ hn
    unfold flagR
    rw [hcls, hinv]
    simp only [List.map_cons, List.map_nil, PM.clsLRgt, List.foldl]
    exact k2 _ (PM.clsRgt_lt _) _ (PM.clsRgt_lt _)

theorem flagR_walk (u : Nat → C.T) (h : ∀ j, RChildC (u j) (u (j + 1))) : ∀ j, flagR (u j) = flagR (u 0) := by
  intro j
  induction j with
  | zero => rfl
  | succ j ih => rw [← flagR_step _ _ (h j), ih]

set_option maxRecDepth 200000 in
theorem clsR_N : ∀ k, PM.clsRgt (FH.toTm (N k)) = PM.clsRgt (FH.toTm (N 0))
  | 0 => rfl
  | k + 1 => by
    have ih := clsR_N k
    show PM.mulRgt (PM.clsRgt (FH.toTm SS)) (PM.clsRgt (FH.toTm (N k))) = PM.clsRgt (FH.toTm (N 0))
    rw [ih]
    decide +kernel

set_option maxRecDepth 200000 in
/-- every node N_i N_k has R19 flag 1 -/
theorem flagR_N (i k : Nat) : flagR (app (N i) (N k)) = true := by
  unfold flagR
  show PM.flagRgt (PM.mulRgt (PM.clsRgt (FH.toTm (N i))) (PM.clsRgt (FH.toTm (N k)))) = true
  rw [clsR_N i, clsR_N k]
  decide +kernel

theorem N_succ_ne_B (i : Nat) : N (i + 1) ≠ B := by
  intro h
  simp only [N, B, SS, app.injEq] at h
  cases h.1.2

theorem R_N (i : Nat) (t' : T) (h : R (N (i + 1)) t') : t' = N i := by
  have e := reach_stuck _ _ (by simp [N, args, SS]) h
  have : args (N (i + 1)) = [S, N i] := rfl
  rw [this] at e
  simp only [List.cons.injEq] at e
  exact e.2.1

theorem not_R_B (t' : T) : ¬ R B t' := by
  intro h
  have e := reach_stuck _ _ (by simp [B, args]) h
  have : args B = [SS, SS] := rfl
  rw [this] at e
  simp only [List.cons.injEq] at e
  have := e.1
  simp [SS] at this

/-- **Theorem (rightmost finite half, reload scenario).**  A rightmost walk from a term whose R19 class has flag 0
    never ends in computed nodes (t j).(s j) (s j /= S) whose steps are rightmost tail calls (s (j+1) = s j) or
    canonical rightmost reload steps (t (j+1) = s j, s (j+1) = S S (s j)) — the rightmost path of the reload cycle. -/
theorem finite_half_right (u : Nat → C.T) (hchild : ∀ j, RChildC (u j) (u (j + 1))) (hflag : flagR (u 0) = false)
    (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length ∧ s j ≠ S)
    (hstep : ∀ j, s (j + 1) = s j ∨ (t (j + 1) = s j ∧ s (j + 1) = app SS (s j))) : False := by
  have hreach : ∀ j, ∃ c, C.Reach (C.args (app (t j) (s j))) [c, app (t (j + 1)) (s (j + 1))] := by
    intro j
    have hc := hchild (j0 + j)
    rw [(hform j).1, show j0 + j + 1 = j0 + (j + 1) by omega, (hform (j + 1)).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, c, hr⟩
    · exfalso; rw [C.args_app] at hlen; have := (hform j).2.1; simp at hlen; omega
    · exact ⟨c, hr⟩
  have hR : ∀ j, s (j + 1) = s j → R (t j) (t (j + 1)) := by
    intro j hs
    obtain ⟨c, hr⟩ := hreach j
    rw [hs] at hr
    exact right_tail_detect (t j) (s j) c (t (j + 1)) (hform j).2.1 hr
  have hB : ∀ j, t (j + 1) = s j → s (j + 1) = app SS (s j) → t j = B := by
    intro j ht hs
    obtain ⟨c, hr⟩ := hreach j
    rw [ht, hs] at hr
    exact right_reload_detect (t j) (s j) c (hform j).2.1 (hform j).2.2 hr
  have hinf : ∀ N0, ∃ j, N0 ≤ j ∧ s (j + 1) ≠ s j := by
    intro N0
    refine Classical.byContradiction (fun hno => ?_)
    have hall : ∀ j, N0 ≤ j → s (j + 1) = s j := fun j hj =>
      Classical.byContradiction (fun h => hno ⟨j, hj, h⟩)
    exact no_R_chain (fun i => t (N0 + i)) (fun i => by
      have := hR (N0 + i) (hall (N0 + i) (by omega))
      rw [show N0 + (i + 1) = N0 + i + 1 by omega]; exact this)
  have hreload : ∀ j, s (j + 1) ≠ s j → t (j + 1) = s j ∧ s (j + 1) = app SS (s j) := by
    intro j h
    rcases hstep j with h1 | h1
    · exact absurd h1 h
    · exact h1
  have next_reload : ∀ (dd j : Nat), s (j + 1) ≠ s j → s (j + dd + 2) ≠ s (j + dd + 1) →
      ∃ d, s j = N d := by
    intro dd
    induction dd using Nat.strongRecOn with
    | _ dd ih =>
      intro j hj hjd
      by_cases hmid : ∃ e, e < dd ∧ s (j + e + 2) ≠ s (j + e + 1)
      · obtain ⟨e, he, hne⟩ := hmid
        exact ih e he j hj hne
      · have htail : ∀ e, e < dd → s (j + e + 2) = s (j + e + 1) := fun e he =>
          Classical.byContradiction (fun h => hmid ⟨e, he, h⟩)
        obtain ⟨ht1, _⟩ := hreload j hj
        have hBB : t (j + dd + 1) = B := hB (j + dd + 1) (hreload _ hjd).1 (hreload _ hjd).2
        have hchain := Rchain_to_B dd (fun e => t (j + 1 + e))
          (by show t (j + 1 + dd) = B; rw [show j + 1 + dd = j + dd + 1 by omega]; exact hBB)
          (fun e he => by
            show R (t (j + 1 + e)) (t (j + 1 + (e + 1)))
            have := hR (j + 1 + e) (by rw [show j + 1 + e + 1 = j + e + 2 by omega, show j + 1 + e = j + e + 1 by omega]; exact htail e he)
            rw [show j + 1 + (e + 1) = j + 1 + e + 1 by omega]; exact this)
        simp only [Nat.add_zero] at hchain
        exact ⟨dd, by rw [← ht1]; exact hchain⟩
  obtain ⟨j1, _, hj1⟩ := hinf 0
  obtain ⟨j2, hj2, hj2'⟩ := hinf (j1 + 1)
  obtain ⟨d, hd⟩ := next_reload (j2 - j1 - 1) j1 hj1
    (by rw [show j1 + (j2 - j1 - 1) + 2 = j2 + 1 by omega, show j1 + (j2 - j1 - 1) + 1 = j2 by omega]; exact hj2')
  have htj1 : t j1 = B := hB j1 (hreload j1 hj1).1 (hreload j1 hj1).2
  have hfl := flagR_walk u hchild (j0 + j1)
  rw [(hform j1).1, htj1, hd, show B = N 0 from rfl, flagR_N 0 d, hflag] at hfl
  exact absurd hfl (by decide)

end RR

#print axioms RR.flagR_step
#print axioms RR.finite_half_right

/-! ## General Omega steps (any second component) — FG -/

namespace FG

open C
open C.T

/-- S (S (S S)) -/
def SSS2 : T := app S OM.SSS1

/-- a tail call from a top q.sigma (sigma of size >= 4) forces q = S(SS) -/
theorem top_tc (q σ t' : T) (hσ : 4 ≤ size σ) (h2 : 2 ≤ (args (app q σ)).length) (h : R2 (app q σ) t') :
    q = OM.SSS1 := by
  have h' : Reach (args (app q σ)) [app S S, t'] := h
  by_cases hq : 2 ≤ (args q).length
  · exfalso
    rw [args_app] at h'
    rcases final_shape (args q) σ (app S S) t' hq h' with ⟨hc, _⟩ | hbig
    · rw [← hc] at hσ; simp [size] at hσ
    · simp [size] at hbig; omega
  · have hl : (args (app q σ)).length ≤ 2 := by rw [args_app]; simp; omega
    have e := reach_stuck _ _ hl h'
    rw [args_app] at e
    match hax : args q, e with
    | [x], e =>
      simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
      rw [TC.args_one' q x hax, ← e.1]; rfl
    | [], e => simp at e
    | _ :: _ :: _, _ => rw [hax] at hq; simp at hq

/-- an Omega step from a top q.sigma (sigma of size >= 4) with second component p forces q = S(S(SS)) and p = sigma -/
theorem top_om (q σ p : T) (hσ : 4 ≤ size σ) (h : OM.Om (app q σ) p) : q = SSS2 ∧ p = σ := by
  have h' : Reach (args (app q σ)) [OM.SSS1, p] := h
  by_cases hq : 2 ≤ (args q).length
  · exfalso
    rw [args_app] at h'
    rcases final_shape (args q) σ OM.SSS1 p hq h' with ⟨hc, _⟩ | hbig
    · rw [← hc] at hσ; simp [OM.SSS1, RC.SS, size] at hσ
    · simp [OM.SSS1, RC.SS, size] at hbig; omega
  · have hl : (args (app q σ)).length ≤ 2 := by rw [args_app]; simp; omega
    have e := reach_stuck _ _ hl h'
    rw [args_app] at e
    match hax : args q, e with
    | [x], e =>
      simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
      exact ⟨by rw [TC.args_one' q x hax, ← e.1]; rfl, e.2.1⟩
    | [], e => simp at e
    | _ :: _ :: _, _ => rw [hax] at hq; simp at hq

theorem size_mono (s : Nat → T) (hs : ∀ j, s (j + 1) = s j ∨ ∃ q, s (j + 1) = app q (s j)) :
    ∀ a b, a ≤ b → size (s a) ≤ size (s b) := by
  intro a b hab
  induction b with
  | zero =>
    obtain rfl : a = 0 := by omega
    exact Nat.le_refl _
  | succ b ih =>
    by_cases h : a = b + 1
    · subst h; exact Nat.le_refl _
    · have := ih (by omega)
      rcases hs b with h1 | ⟨q, h1⟩
      · rw [h1]; exact this
      · rw [h1]; simp only [size]; omega

/-- **Theorem (finite half, general Omega scenario).**  An infinite leftmost walk from a term whose L36 class has
    flag 0 never ends in computed nodes (t j).(s j) (t j with >= 2 arguments, s j /= S) whose steps are tail calls over
    the stack (s (j+1) = s j) or Omega steps with ANY second component q (t (j+1) = s j, s (j+1) = q.(s j)).
    Proof: once the stack has size >= 6, a non-canonical Omega step is impossible (top_tc / top_om two and four
    Omega steps later), so the walk ends in canonical Omega steps — excluded by FH.finite_half_Omega. -/
theorem finite_half_Omega_general (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (hflag : FH.flag (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length ∧ s j ≠ S)
    (hstep : ∀ j, s (j + 1) = s j ∨ (t (j + 1) = s j ∧ ∃ q, s (j + 1) = app q (s j))) : False := by
  have hreach : ∀ j, ∃ d, C.Reach (C.args (app (t j) (s j))) [app (t (j + 1)) (s (j + 1)), d] := by
    intro j
    have hc := hchild (j0 + j)
    rw [(hform j).1, show j0 + j + 1 = j0 + (j + 1) by omega, (hform (j + 1)).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, d, hr⟩
    · exfalso; rw [C.args_app] at hlen; have := (hform j).2.1; simp at hlen; omega
    · exact ⟨d, hr⟩
  have hR2 : ∀ j, s (j + 1) = s j → R2 (t j) (t (j + 1)) := by
    intro j hs
    obtain ⟨d, hr⟩ := hreach j
    rw [hs] at hr
    exact FZ.tail_call_fuel (t j) (t (j + 1)) (s j) d (hform j).2.1 (hform j).2.2 hr
  have hOm : ∀ j q, t (j + 1) = s j → s (j + 1) = app q (s j) → OM.Om (t j) q := by
    intro j q ht hs
    obtain ⟨d, hr⟩ := hreach j
    rw [ht, hs] at hr
    exact OM.omega_detect (t j) (s j) q d (hform j).2.1 (hform j).2.2 hr
  have hs' : ∀ j, s (j + 1) = s j ∨ ∃ q, s (j + 1) = app q (s j) := by
    intro j
    rcases hstep j with h | ⟨_, h⟩
    · exact Or.inl h
    · exact Or.inr h
  have hmono := size_mono s hs'
  have hinf : ∀ N, ∃ j, N ≤ j ∧ s (j + 1) ≠ s j := by
    intro N
    refine Classical.byContradiction (fun hno => ?_)
    have hall : ∀ j, N ≤ j → s (j + 1) = s j := fun j hj =>
      Classical.byContradiction (fun h => hno ⟨j, hj, h⟩)
    exact no_R2_chain (fun i => t (N + i)) (fun i => by
      have := hR2 (N + i) (hall (N + i) (by omega))
      rw [show N + (i + 1) = N + i + 1 by omega]; exact this)
  have homega : ∀ j, s (j + 1) ≠ s j → t (j + 1) = s j ∧ ∃ q, s (j + 1) = app q (s j) := by
    intro j h
    rcases hstep j with h1 | h1
    · exact absurd h1 h
    · exact h1
  -- the first Omega step at or after b
  have hfirst_aux : ∀ (e b : Nat), b ≤ e → s (e + 1) ≠ s e →
      ∃ j1, b ≤ j1 ∧ s (j1 + 1) ≠ s j1 ∧ ∀ x, b ≤ x → x < j1 → s (x + 1) = s x := by
    intro e
    induction e using Nat.strongRecOn with
    | _ e ih =>
      intro b hbe he
      by_cases hmid : ∃ x, b ≤ x ∧ x < e ∧ s (x + 1) ≠ s x
      · obtain ⟨x, hbx, hxe, hx⟩ := hmid
        exact ih x hxe b hbx hx
      · refine ⟨e, hbe, he, fun x hbx hxe => ?_⟩
        exact Classical.byContradiction (fun h => hmid ⟨x, hbx, hxe, h⟩)
  have hfirst : ∀ b, ∃ j1, b ≤ j1 ∧ s (j1 + 1) ≠ s j1 ∧ ∀ x, b ≤ x → x < j1 → s (x + 1) = s x := by
    intro b
    obtain ⟨e, hbe, he⟩ := hinf b
    exact hfirst_aux e b hbe he
  have hconst : ∀ (n b : Nat), (∀ x, b ≤ x → x < b + n → s (x + 1) = s x) → s (b + n) = s b := by
    intro n
    induction n with
    | zero => intro b _; rfl
    | succ n ih =>
      intro b hx
      rw [show b + (n + 1) = b + n + 1 by omega, hx (b + n) (by omega) (by omega)]
      exact ih b (fun x h1 h2 => hx x h1 (by omega))
  have hconst' : ∀ b j1, b ≤ j1 → (∀ x, b ≤ x → x < j1 → s (x + 1) = s x) → s j1 = s b := by
    intro b j1 hb hx
    have := hconst (j1 - b) b (fun x h1 h2 => hx x h1 (by omega))
    rwa [show b + (j1 - b) = j1 by omega] at this
  -- the top two steps after an Omega step j1 is q.sigma: classify it
  have hclass : ∀ a q σ, t a = app q σ → 4 ≤ size σ →
      q = OM.SSS1 ∨ (q = SSS2 ∧ s (a + 1) ≠ s a ∧ t (a + 1) = s a ∧ s (a + 1) = app σ (s a)) := by
    intro a q σ hta hσ
    rcases hstep a with h | ⟨ht, p, hp⟩
    · left
      have h2 := (hform a).2.1
      rw [hta] at h2
      have hr := hR2 a h
      rw [hta] at hr
      exact top_tc q σ _ hσ h2 hr
    · right
      have ho := hOm a p ht hp
      rw [hta] at ho
      obtain ⟨hq, hpσ⟩ := top_om q σ p hσ ho
      refine ⟨hq, ?_, ht, by rw [hp, hpσ]⟩
      rw [hp]; exact OM.size_app_ne _ _
  -- key: once the stack has size >= 6, every Omega step is canonical
  have hkey : ∀ j, 6 ≤ size (s j) → s (j + 1) ≠ s j → s (j + 1) = app OM.SSS1 (s j) := by
    intro j hj hne
    obtain ⟨_, q, hq⟩ := homega j hne
    obtain ⟨j1, hj1b, hj1, hj1x⟩ := hfirst (j + 1)
    have hs1 : s j1 = s (j + 1) := hconst' (j + 1) j1 hj1b hj1x
    have ht1 : t (j1 + 1) = app q (s j) := by rw [(homega j1 hj1).1, hs1, hq]
    rcases hclass (j1 + 1) q (s j) ht1 (by omega) with hc | ⟨_, hne2, _, hs2⟩
    · rw [hq, hc]
    · exfalso
      -- two Omega steps later the top is (s j).(s (j1+1))
      obtain ⟨j3, hj3b, hj3, hj3x⟩ := hfirst (j1 + 1 + 1)
      have hs3 : s j3 = s (j1 + 1 + 1) := hconst' _ j3 hj3b hj3x
      have hsz : 4 ≤ size (s (j1 + 1)) := by
        have := hmono j (j1 + 1) (by omega); omega
      have ht3 : t (j3 + 1) = app (s j) (s (j1 + 1)) := by rw [(homega j3 hj3).1, hs3, hs2]
      rcases hclass (j3 + 1) (s j) (s (j1 + 1)) ht3 hsz with hc | ⟨hc, _⟩
      · rw [hc] at hj; simp [OM.SSS1, RC.SS, size] at hj
      · rw [hc] at hj; simp [SSS2, OM.SSS1, RC.SS, size] at hj
  -- a time J after which the stack has size >= 6
  have hgrow : ∀ n, ∃ J, n ≤ size (s J) := by
    intro n
    induction n with
    | zero => exact ⟨0, Nat.zero_le _⟩
    | succ n ih =>
      obtain ⟨J, hJ⟩ := ih
      obtain ⟨j, hjJ, hj⟩ := hinf J
      obtain ⟨_, q, hq⟩ := homega j hj
      refine ⟨j + 1, ?_⟩
      have := hmono J j hjJ
      have := size_pos q
      rw [hq]; simp only [size]; omega
  obtain ⟨J, hJ⟩ := hgrow 6
  exact FH.finite_half_Omega u hchild hflag (j0 + J) (fun e => t (J + e)) (fun e => s (J + e))
    (fun e => ⟨by rw [show j0 + J + e = j0 + (J + e) by omega]; exact (hform _).1, (hform _).2.1, (hform _).2.2⟩)
    (fun e => by
      simp only [show J + (e + 1) = J + e + 1 by omega]
      by_cases h : s (J + e + 1) = s (J + e)
      · exact Or.inl h
      · right
        refine ⟨(homega _ h).1, hkey _ ?_ h⟩
        have := hmono J (J + e) (by omega); omega)

/-- **Combined theorem (general).**  An infinite leftmost walk from a flag-0 term never ends in computed nodes
    (t j).(s j) whose steps are tail calls over the stack (s (j+1) = s j) or Omega steps with any second component
    (t (j+1) = s j, s (j+1) = q.(s j)); the bottom may be S (the reload mechanism) or not. -/
theorem finite_half_general_families (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (hflag : FH.flag (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length)
    (hstep : ∀ j, s (j + 1) = s j ∨ (t (j + 1) = s j ∧ ∃ q, s (j + 1) = app q (s j))) : False := by
  by_cases hfin : ∃ N, ∀ j, N ≤ j → s (j + 1) = s j
  · obtain ⟨N, hN⟩ := hfin
    have hconst : ∀ e, s (N + e) = s N := by
      intro e
      induction e with
      | zero => rfl
      | succ e ih => rw [show N + (e + 1) = N + e + 1 by omega, hN (N + e) (by omega), ih]
    exact FH.finite_half_TC u hchild hflag (j0 + N) (s N) (fun e => t (N + e))
      (fun e => ⟨by rw [show j0 + N + e = j0 + (N + e) by omega, (hform (N + e)).1, hconst e], (hform (N + e)).2⟩)
  · have : ∃ j1, s (j1 + 1) ≠ s j1 := by
      refine Classical.byContradiction (fun h => hfin ⟨0, fun j _ => Classical.byContradiction (fun h' => h ⟨j, h'⟩)⟩)
    obtain ⟨j1, hj1⟩ := this
    have hne : ∀ e, s (j1 + 1 + e) ≠ S := by
      intro e
      induction e with
      | zero =>
        rcases hstep j1 with h | ⟨_, q, h⟩
        · exact absurd h hj1
        · simp only [Nat.add_zero]; rw [h]; intro h'; cases h'
      | succ e ih =>
        rw [show j1 + 1 + (e + 1) = j1 + 1 + e + 1 by omega]
        rcases hstep (j1 + 1 + e) with h | ⟨_, q, h⟩
        · rw [h]; exact ih
        · rw [h]; intro h'; cases h'
    exact finite_half_Omega_general u hchild hflag (j0 + (j1 + 1)) (fun e => t (j1 + 1 + e))
      (fun e => s (j1 + 1 + e))
      (fun e => ⟨by rw [show j0 + (j1 + 1) + e = j0 + (j1 + 1 + e) by omega]; exact (hform _).1,
        (hform _).2, hne e⟩)
      (fun e => by
        have := hstep (j1 + 1 + e)
        simp only [show j1 + 1 + (e + 1) = j1 + 1 + e + 1 by omega]
        exact this)

end FG

#print axioms FG.finite_half_Omega_general
#print axioms FG.finite_half_general_families

/-! ## Rightmost path: reload-type steps with any second component — RG -/

namespace RG

open C
open C.T
open TC
open RC

/-- a rightmost step t.sigma -> sigma.(q.sigma) (sigma /= S) forces H(t) = S (S S) q -/
theorem right_reload_detect_gen (t σ c q : T) (ht : 2 ≤ (args t).length) (hσ : σ ≠ S)
    (h : Reach (args (app t σ)) [c, app σ (app q σ)]) : R2 t q := by
  rw [args_app] at h
  obtain ⟨b0, hb0⟩ := final_app _ _ _ (by simp; omega) h
  simp only [app.injEq] at hb0
  obtain ⟨_, hcq⟩ := hb0
  rcases OM.cinv2_reach t σ ht _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c', w', b', hx, hH, hP, hEq⟩ | ⟨y, _, hEq⟩
  · have := congrArg List.length hEq; simp at this; omega
  · have := congrArg List.length hEq; simp at this; omega
  · have e2 : app σ (app q σ) = app b' (app c' w') := by
      have := congrArg (fun l : List T => l.getD 1 S) hEq; simpa using this
    simp only [app.injEq] at e2
    obtain ⟨hb', hc', hw'⟩ := e2
    subst hb'; subst hw'
    have hxSS : x = SS := by
      by_cases hx2 : 2 ≤ (args x).length
      · exfalso
        rcases final_shape (args x) σ S σ hx2 hP with ⟨hS, _⟩ | hbig
        · exact hσ hS.symm
        · exact hσ (OM.size_le_one σ (by simp [size] at hbig; omega))
      · have hl : (args x ++ [σ]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [x1], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          rw [args_one' x x1 hax, ← e.1]; rfl
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at hx2; simp at hx2
    subst hxSS
    cases hH with
    | first _ _ hrt =>
      rw [hc']; exact hrt
    | next x0 c0 w0 _ _ hH0 _ =>
      exfalso
      have h1 := OM.wh_size _ _ _ _ _ hH0
      simp [size] at h1
      have := size_pos c0
      omega
  · simp only [List.cons.injEq] at hEq
    exfalso
    rw [← hcq] at hEq
    exact OM.size_app_ne q σ hEq.1

/-- a rightmost tail call from a top q.sigma (sigma /= S) forces q = S S -/
theorem top_rtc (q σ t' : T) (hσ : σ ≠ S) (h : R (app q σ) t') : q = SS := by
  by_cases hq : 2 ≤ (args q).length
  · exact absurd (R_strip q σ t' hq h).1 hσ
  · have h' : Reach (args (app q σ)) [S, t'] := h
    have hl : (args (app q σ)).length ≤ 2 := by rw [args_app]; simp; omega
    have e := reach_stuck _ _ hl h'
    rw [args_app] at e
    match hax : args q, e with
    | [x], e =>
      simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
      rw [args_one' q x hax, ← e.1]; rfl
    | [], e => simp at e
    | _ :: _ :: _, _ => rw [hax] at hq; simp at hq

/-- a rightmost reload-type step from a top q.sigma (size sigma >= 4) with second component p forces q = S(SS), p = sigma -/
theorem top_rr (q σ p : T) (hσ : 4 ≤ size σ) (h : R2 (app q σ) p) : q = OM.SSS1 ∧ p = σ := by
  have h' : Reach (args (app q σ)) [app S S, p] := h
  by_cases hq : 2 ≤ (args q).length
  · exfalso
    rw [args_app] at h'
    rcases final_shape (args q) σ (app S S) p hq h' with ⟨hc, _⟩ | hbig
    · rw [← hc] at hσ; simp [size] at hσ
    · simp [size] at hbig; omega
  · have hl : (args (app q σ)).length ≤ 2 := by rw [args_app]; simp; omega
    have e := reach_stuck _ _ hl h'
    rw [args_app] at e
    match hax : args q, e with
    | [x], e =>
      simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
      exact ⟨by rw [args_one' q x hax, ← e.1]; rfl, e.2.1⟩
    | [], e => simp at e
    | _ :: _ :: _, _ => rw [hax] at hq; simp at hq

/-- **Theorem (rightmost finite half, general reload scenario).**  A rightmost walk from a term whose R19 class has
    flag 0 never ends in computed nodes (t j).(s j) (t j with >= 2 arguments, s j /= S) whose steps are rightmost tail
    calls (s (j+1) = s j) or rightmost reload-type steps with ANY second component q (t (j+1) = s j,
    s (j+1) = q.(s j)).  Proof: such a step forces H(t j) = S(SS) q; once the stack has size >= 6 only q = S S is
    possible (top_rtc / top_rr), and RR.finite_half_right excludes the canonical case. -/
theorem finite_half_right_general (u : Nat → C.T) (hchild : ∀ j, RR.RChildC (u j) (u (j + 1)))
    (hflag : RR.flagR (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length ∧ s j ≠ S)
    (hstep : ∀ j, s (j + 1) = s j ∨ (t (j + 1) = s j ∧ ∃ q, s (j + 1) = app q (s j))) : False := by
  have hreach : ∀ j, ∃ c, C.Reach (C.args (app (t j) (s j))) [c, app (t (j + 1)) (s (j + 1))] := by
    intro j
    have hc := hchild (j0 + j)
    rw [(hform j).1, show j0 + j + 1 = j0 + (j + 1) by omega, (hform (j + 1)).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, c, hr⟩
    · exfalso; rw [C.args_app] at hlen; have := (hform j).2.1; simp at hlen; omega
    · exact ⟨c, hr⟩
  have hR : ∀ j, s (j + 1) = s j → R (t j) (t (j + 1)) := by
    intro j hs
    obtain ⟨c, hr⟩ := hreach j
    rw [hs] at hr
    exact RR.right_tail_detect (t j) (s j) c (t (j + 1)) (hform j).2.1 hr
  have hRR : ∀ j q, t (j + 1) = s j → s (j + 1) = app q (s j) → R2 (t j) q := by
    intro j q ht hs
    obtain ⟨c, hr⟩ := hreach j
    rw [ht, hs] at hr
    exact right_reload_detect_gen (t j) (s j) c q (hform j).2.1 (hform j).2.2 hr
  have hs' : ∀ j, s (j + 1) = s j ∨ ∃ q, s (j + 1) = app q (s j) := by
    intro j
    rcases hstep j with h | ⟨_, h⟩
    · exact Or.inl h
    · exact Or.inr h
  have hmono := FG.size_mono s hs'
  have hinf : ∀ N, ∃ j, N ≤ j ∧ s (j + 1) ≠ s j := by
    intro N
    refine Classical.byContradiction (fun hno => ?_)
    have hall : ∀ j, N ≤ j → s (j + 1) = s j := fun j hj =>
      Classical.byContradiction (fun h => hno ⟨j, hj, h⟩)
    exact no_R_chain (fun i => t (N + i)) (fun i => by
      have := hR (N + i) (hall (N + i) (by omega))
      rw [show N + (i + 1) = N + i + 1 by omega]; exact this)
  have hrl : ∀ j, s (j + 1) ≠ s j → t (j + 1) = s j ∧ ∃ q, s (j + 1) = app q (s j) := by
    intro j h
    rcases hstep j with h1 | h1
    · exact absurd h1 h
    · exact h1
  have hfirst_aux : ∀ (e b : Nat), b ≤ e → s (e + 1) ≠ s e →
      ∃ j1, b ≤ j1 ∧ s (j1 + 1) ≠ s j1 ∧ ∀ x, b ≤ x → x < j1 → s (x + 1) = s x := by
    intro e
    induction e using Nat.strongRecOn with
    | _ e ih =>
      intro b hbe he
      by_cases hmid : ∃ x, b ≤ x ∧ x < e ∧ s (x + 1) ≠ s x
      · obtain ⟨x, hbx, hxe, hx⟩ := hmid
        exact ih x hxe b hbx hx
      · refine ⟨e, hbe, he, fun x hbx hxe => ?_⟩
        exact Classical.byContradiction (fun h => hmid ⟨x, hbx, hxe, h⟩)
  have hfirst : ∀ b, ∃ j1, b ≤ j1 ∧ s (j1 + 1) ≠ s j1 ∧ ∀ x, b ≤ x → x < j1 → s (x + 1) = s x := by
    intro b
    obtain ⟨e, hbe, he⟩ := hinf b
    exact hfirst_aux e b hbe he
  have hconst : ∀ (n b : Nat), (∀ x, b ≤ x → x < b + n → s (x + 1) = s x) → s (b + n) = s b := by
    intro n
    induction n with
    | zero => intro b _; rfl
    | succ n ih =>
      intro b hx
      rw [show b + (n + 1) = b + n + 1 by omega, hx (b + n) (by omega) (by omega)]
      exact ih b (fun x h1 h2 => hx x h1 (by omega))
  have hconst' : ∀ b j1, b ≤ j1 → (∀ x, b ≤ x → x < j1 → s (x + 1) = s x) → s j1 = s b := by
    intro b j1 hb hx
    have := hconst (j1 - b) b (fun x h1 h2 => hx x h1 (by omega))
    rwa [show b + (j1 - b) = j1 by omega] at this
  have hclass : ∀ a q σ, t a = app q σ → 4 ≤ size σ →
      q = SS ∨ (q = OM.SSS1 ∧ s (a + 1) ≠ s a ∧ t (a + 1) = s a ∧ s (a + 1) = app σ (s a)) := by
    intro a q σ hta hσ
    have hσS : σ ≠ S := by intro h; rw [h] at hσ; simp [size] at hσ
    rcases hstep a with h | ⟨ht, p, hp⟩
    · left
      have hr := hR a h
      rw [hta] at hr
      exact top_rtc q σ _ hσS hr
    · right
      have ho := hRR a p ht hp
      rw [hta] at ho
      obtain ⟨hq, hpσ⟩ := top_rr q σ p hσ ho
      refine ⟨hq, ?_, ht, by rw [hp, hpσ]⟩
      rw [hp]; exact OM.size_app_ne _ _
  have hkey : ∀ j, 6 ≤ size (s j) → s (j + 1) ≠ s j → s (j + 1) = app SS (s j) := by
    intro j hj hne
    obtain ⟨_, q, hq⟩ := hrl j hne
    obtain ⟨j1, hj1b, hj1, hj1x⟩ := hfirst (j + 1)
    have hs1 : s j1 = s (j + 1) := hconst' (j + 1) j1 hj1b hj1x
    have ht1 : t (j1 + 1) = app q (s j) := by rw [(hrl j1 hj1).1, hs1, hq]
    rcases hclass (j1 + 1) q (s j) ht1 (by omega) with hc | ⟨_, hne2, _, hs2⟩
    · rw [hq, hc]
    · exfalso
      obtain ⟨j3, hj3b, hj3, hj3x⟩ := hfirst (j1 + 1 + 1)
      have hs3 : s j3 = s (j1 + 1 + 1) := hconst' _ j3 hj3b hj3x
      have hsz : 4 ≤ size (s (j1 + 1)) := by
        have := hmono j (j1 + 1) (by omega); omega
      have ht3 : t (j3 + 1) = app (s j) (s (j1 + 1)) := by rw [(hrl j3 hj3).1, hs3, hs2]
      rcases hclass (j3 + 1) (s j) (s (j1 + 1)) ht3 hsz with hc | ⟨hc, _⟩
      · rw [hc] at hj; simp [SS, size] at hj
      · rw [hc] at hj; simp [OM.SSS1, SS, size] at hj
  have hgrow : ∀ n, ∃ J, n ≤ size (s J) := by
    intro n
    induction n with
    | zero => exact ⟨0, Nat.zero_le _⟩
    | succ n ih =>
      obtain ⟨J, hJ⟩ := ih
      obtain ⟨j, hjJ, hj⟩ := hinf J
      obtain ⟨_, q, hq⟩ := hrl j hj
      refine ⟨j + 1, ?_⟩
      have := hmono J j hjJ
      have := size_pos q
      rw [hq]; simp only [size]; omega
  obtain ⟨J, hJ⟩ := hgrow 6
  exact RR.finite_half_right u hchild hflag (j0 + J) (fun e => t (J + e)) (fun e => s (J + e))
    (fun e => ⟨by rw [show j0 + J + e = j0 + (J + e) by omega]; exact (hform _).1, (hform _).2.1, (hform _).2.2⟩)
    (fun e => by
      simp only [show J + (e + 1) = J + e + 1 by omega]
      by_cases h : s (J + e + 1) = s (J + e)
      · exact Or.inl h
      · right
        refine ⟨(hrl _ h).1, hkey _ ?_ h⟩
        have := hmono J (J + e) (by omega); omega)

end RG

#print axioms RG.right_reload_detect_gen
#print axioms RG.finite_half_right_general

/-! ## Monotone walks: computed steps that never return to their bottom — FM -/

namespace FM

open C
open C.T

/-- towers S, S S, S (S S), ... -/
def tw : Nat → T
  | 0 => S
  | m + 1 => app S (tw m)

abbrev Tower (t : T) : Prop := ∃ m, t = tw m

/-- w is a right-spine suffix of x -/
inductive Suf (w : T) : T → Prop
  | refl : Suf w w
  | wrap (p x : T) : Suf w x → Suf w (app p x)

theorem suf_trans (a b c : T) (h1 : Suf a b) (h2 : Suf b c) : Suf a c := by
  induction h2 with
  | refl => exact h1
  | wrap p x _ ih => exact Suf.wrap p x ih

theorem suf_S_aux (w x : T) (h : Suf w x) : x = S → w = S := by
  induction h with
  | refl => exact id
  | wrap p x _ _ => intro h; cases h

theorem suf_S (w : T) (h : Suf w S) : w = S := suf_S_aux w S h rfl

theorem suf_nontower (w x : T) (h : Suf w x) (hw : ¬ Tower w) : ¬ Tower x := by
  induction h with
  | refl => exact hw
  | wrap p x _ ih =>
    intro ⟨m, hm⟩
    cases m with
    | zero => simp [tw] at hm
    | succ m =>
      simp only [tw, app.injEq] at hm
      exact ih ⟨m, hm.2⟩

/-- the last element of a list is a spine-wrap of w -/
def LastSuf (w : T) (L : List T) : Prop := ∃ M y, L = M ++ [y] ∧ Suf w y

theorem lastsuf_step (w : T) (L L' : List T) (hB : LastSuf w L) (hs : step L = some L') : LastSuf w L' := by
  obtain ⟨M, y, rfl, hy⟩ := hB
  match M, hs with
  | a :: b :: c :: R, hs =>
    simp only [List.cons_append, step, Option.some.injEq] at hs
    subst hs
    exact ⟨args a ++ c :: app b c :: R, y, by simp, hy⟩
  | [a, b], hs =>
    simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
    subst hs
    exact ⟨args a ++ [y], app b y, by simp, Suf.wrap b y hy⟩
  | [a], hs => simp [step] at hs
  | [], hs => simp [step] at hs

theorem lastsuf_reach (w : T) (A B : List T) (hA : LastSuf w A) (h : Reach A B) : LastSuf w B := by
  induction h with
  | refl => exact hA
  | tail _ hs ih => exact lastsuf_step w _ _ ih hs

/-- the first component of a head normal form reached from a list of length >= 3 is a spine-wrap of the
    original last element -/
theorem first_suf (w : T) (A L : List T) (hA : LastSuf w A) (hlen : 3 ≤ A.length) (h : Reach A L) :
    ∀ c d, L = [c, d] → Suf w c := by
  intro c d hL
  cases h with
  | refl => subst hL; simp at hlen
  | tail hr hs =>
    obtain ⟨M, y, hM, hy⟩ := lastsuf_reach w _ _ hA hr
    subst hM
    subst hL
    match M, hs with
    | [a, b], hs =>
      simp only [List.cons_append, List.nil_append, step, Option.some.injEq] at hs
      have ha : args a = [] := by
        cases h' : args a with
        | nil => rfl
        | cons _ _ =>
          rw [h'] at hs
          have := congrArg List.length hs
          simp at this <;> omega
      rw [ha] at hs
      simp only [List.nil_append, List.cons.injEq] at hs
      rw [← hs.1]; exact hy
    | a :: b :: c' :: R, hs =>
      exfalso
      simp only [List.cons_append, step, Option.some.injEq] at hs
      have hl := congrArg List.length hs
      simp at hl <;> omega
    | [a], hs => simp [step] at hs
    | [], hs => simp [step] at hs

theorem wh_suf (Q z x c w : T) (h : OM.WH Q z x c w) : Suf z w := by
  induction h with
  | first => exact Suf.refl
  | next x0 c0 w0 _ _ _ _ ih => exact Suf.wrap c0 w0 ih

/-- Fibonacci words over (z, c0.z) -/
def Fw (z c0 : T) : Nat → T
  | 0 => z
  | 1 => app c0 z
  | i + 2 => app (Fw z c0 i) (Fw z c0 (i + 1))

/-- the pending second component at chain stage i -/
def Fc (z c0 : T) : Nat → T
  | 0 => c0
  | i + 1 => Fw z c0 i

theorem Fw_succ (z c0 : T) (i : Nat) : app (Fc z c0 i) (Fw z c0 i) = Fw z c0 (i + 1) := by
  cases i with
  | zero => rfl
  | succ i => rfl

theorem Fw_add2 (z c0 : T) (i : Nat) : Fw z c0 (i + 2) = app (Fw z c0 i) (Fw z c0 (i + 1)) := rfl

theorem Fw_suf (z c0 : T) : ∀ i, Suf z (Fw z c0 i)
  | 0 => Suf.refl
  | 1 => Suf.wrap c0 z Suf.refl
  | i + 2 => Suf.wrap _ _ (Fw_suf z c0 (i + 1))

/-- chain invariant over a non-tower bottom: the current head x is a non-tower (then the chain can never end), or
    the chain so far consists of peels of a tower and the wraps are Fibonacci words -/
def J (Q z x c w : T) : Prop :=
  ¬ Tower x ∨ ∃ c0 i m, Reach (args Q) [tw (m + i), c0] ∧ x = tw m ∧ w = Fw z c0 i ∧ c = Fc z c0 i

theorem wh_J (Q z x c w : T) (hz : ¬ Tower z) (h : OM.WH Q z x c w) : J Q z x c w := by
  induction h with
  | first x c hr =>
    by_cases hx : Tower x
    · obtain ⟨m, rfl⟩ := hx
      exact Or.inr ⟨c, 0, m, by simpa using hr, rfl, rfl, rfl⟩
    · exact Or.inl hx
  | next x0 c0' w0 x c hH0 hr ih =>
    rcases ih with hnt | ⟨c0, i, m, hQ0, hx0, hw0, hc0⟩
    · left
      by_cases h2 : 2 ≤ (args x0).length
      · have hsuf : Suf w0 x :=
          first_suf w0 (args x0 ++ [w0]) [x, c] ⟨args x0, w0, rfl, Suf.refl⟩ (by simp; omega) hr x c rfl
        exact suf_nontower z x (suf_trans _ _ _ (wh_suf _ _ _ _ _ hH0) hsuf) hz
      · have hl : (args x0 ++ [w0]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hr
        match hax : args x0, e with
        | [y], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          rw [e.1]
          intro hy
          apply hnt
          obtain ⟨m, hm⟩ := hy
          exact ⟨m + 1, by rw [TC.args_one' x0 y hax, hm]; rfl⟩
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
    · right
      subst hx0
      cases m with
      | zero =>
        exfalso
        have e := reach_stuck _ _ (by simp [args, tw]) hr
        simp [args, tw] at e
      | succ m =>
        have e := reach_stuck _ _ (by simp [args, tw]) hr
        simp only [tw, args, List.nil_append, List.cons_append, List.cons.injEq] at e
        refine ⟨c0, i + 1, m, by rw [show m + (i + 1) = m + 1 + i by omega]; exact hQ0, e.1, ?_, ?_⟩
        · rw [hw0, hc0]; exact Fw_succ z c0 i
        · show c = Fw z c0 i
          rw [e.2.1, hw0]

/-- **Lemma Fib.**  Over a non-tower bottom z (some right-spine multiplier of z is not S), every computed step is a
    Fibonacci step: if Q has >= 2 arguments and the head run of Q.z reaches [ch, d], then H(Q) = S (tw K) c0 and
    ch = Fw z c0 K (K = number of multipliers pushed on z). -/
theorem fib_step (Q z ch d : T) (hQ : 2 ≤ (args Q).length) (hz : ¬ Tower z)
    (h : Reach (args (app Q z)) [ch, d]) : ∃ K c0, Reach (args Q) [tw K, c0] ∧ ch = Fw z c0 K := by
  rw [args_app] at h
  have hzS : z ≠ S := fun h' => hz ⟨0, h'⟩
  rcases OM.cinv2_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hr, hEq⟩
  · have := congrArg List.length hEq; simp at this <;> omega
  · have := congrArg List.length hEq; simp at this <;> omega
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hch, _, _⟩ := hEq
    rcases wh_J Q z x c w hz hH with hnt | ⟨c0, i, m, hQ0, hxm, hw, hc⟩
    · exfalso
      by_cases h2 : 2 ≤ (args x).length
      · have hsuf : Suf w S :=
          first_suf w (args x ++ [w]) [S, b] ⟨args x, w, rfl, Suf.refl⟩ (by simp; omega) hP S b rfl
        have hwS : w = S := suf_S w hsuf
        have hzw : Suf z w := wh_suf _ _ _ _ _ hH
        rw [hwS] at hzw
        exact hzS (suf_S z hzw)
      · have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [y], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          apply hnt
          exact ⟨1, by rw [TC.args_one' x y hax, ← e.1]; rfl⟩
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
    · subst hxm
      cases m with
      | zero => exact absurd (show tw 0 = S from rfl) hx
      | succ m =>
        have e := reach_stuck _ _ (by simp [args, tw]) hP
        simp only [tw, args, List.nil_append, List.cons_append, List.cons.injEq] at e
        have hm : m = 0 := by
          cases m with
          | zero => rfl
          | succ m => simp [tw] at e
        subst hm
        rw [show 0 + 1 + i = i + 1 by omega] at hQ0
        refine ⟨i + 1, c0, hQ0, ?_⟩
        rw [hch, hw, hc]
        exact Fw_succ z c0 i
  · simp only [List.cons.injEq] at hEq
    exact ⟨0, y, hr, hEq.1⟩

/-- **Theorem (finite half, monotone walks).**  Let u be an infinite leftmost walk from a term whose L36 class has
    flag 0.  There are no j0, t, s such that from j0 on every node is u (j0+j) = (t j).(s j) with t j having >= 2
    arguments (only computed steps: no pops, no jumps), no step returns to its bottom (u (j0+j+1) /= s j), and the
    first bottom s 0 is not a tower S(S(...(S S)...)).  Proof: over non-tower bottoms every step is a Fibonacci step
    (fib_step); a pushed count K >= 4 or K = 3 would later put a non-tower term in a position where a tower is
    forced; so every step is a tail call (K = 1) or an Omega-type step (K = 2), excluded by
    FG.finite_half_general_families. -/
theorem finite_half_monotone (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (hflag : FH.flag (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length)
    (hret : ∀ j, u (j0 + j + 1) ≠ s j) (htw : ¬ Tower (s 0)) : False := by
  have hfib : ∀ j, ¬ Tower (s j) →
      ∃ K c0, Reach (args (t j)) [tw K, c0] ∧ u (j0 + j + 1) = Fw (s j) c0 K := by
    intro j hj
    have hc := hchild (j0 + j)
    rw [(hform j).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, d, hr⟩
    · exfalso; rw [C.args_app] at hlen; have := (hform j).2; simp at hlen; omega
    · exact fib_step (t j) (s j) _ d (hform j).2 hj hr
  have hnext : ∀ j, u (j0 + j + 1) = app (t (j + 1)) (s (j + 1)) := by
    intro j; rw [show j0 + j + 1 = j0 + (j + 1) by omega]; exact (hform (j + 1)).1
  have hnt : ∀ j, ¬ Tower (s j) := by
    intro j
    induction j with
    | zero => exact htw
    | succ j ih =>
      obtain ⟨K, c0, _, hu⟩ := hfib j ih
      have hu' := hu
      rw [hnext j] at hu'
      match K, hu, hu' with
      | 0, hu, _ => exact absurd hu (hret j)
      | 1, _, hu' =>
        have e1 : Fw (s j) c0 1 = app c0 (s j) := rfl
        rw [e1] at hu'
        simp only [app.injEq] at hu'
        rw [hu'.2]; exact ih
      | i + 2, _, hu' =>
        rw [Fw_add2] at hu'
        simp only [app.injEq] at hu'
        rw [hu'.2]
        exact suf_nontower _ _ (Fw_suf (s j) c0 (i + 1)) ih
  obtain ⟨K, hK⟩ : ∃ K : Nat → Nat, ∀ j, ∃ c0, Reach (args (t j)) [tw (K j), c0] ∧
      u (j0 + j + 1) = Fw (s j) c0 (K j) :=
    ⟨fun j => Classical.choose (hfib j (hnt j)), fun j => Classical.choose_spec (hfib j (hnt j))⟩
  obtain ⟨c, hKc⟩ : ∃ c : Nat → T, ∀ j, Reach (args (t j)) [tw (K j), c j] ∧
      u (j0 + j + 1) = Fw (s j) (c j) (K j) :=
    ⟨fun j => Classical.choose (hK j), fun j => Classical.choose_spec (hK j)⟩
  have hstep : ∀ j, app (t (j + 1)) (s (j + 1)) = Fw (s j) (c j) (K j) :=
    fun j => (hnext j).symm.trans (hKc j).2
  have hK1 : ∀ j, 1 ≤ K j := by
    intro j
    rcases Nat.eq_zero_or_pos (K j) with h0 | h0
    · exfalso
      have h := (hKc j).2
      rw [h0] at h
      exact hret j h
    · exact h0
  have hstep1 : ∀ j, K j = 1 → t (j + 1) = c j ∧ s (j + 1) = s j := by
    intro j h1
    have h := hstep j
    rw [h1] at h
    have e1 : Fw (s j) (c j) 1 = app (c j) (s j) := rfl
    rw [e1] at h
    simpa only [app.injEq] using h
  have hstep2 : ∀ j, K j = 2 → t (j + 1) = s j ∧ s (j + 1) = app (c j) (s j) := by
    intro j h1
    have h := hstep j
    rw [h1] at h
    have e2 : Fw (s j) (c j) 2 = app (s j) (app (c j) (s j)) := rfl
    rw [e2] at h
    simpa only [app.injEq] using h
  have hstep3 : ∀ j, K j = 3 →
      t (j + 1) = app (c j) (s j) ∧ s (j + 1) = app (s j) (app (c j) (s j)) := by
    intro j h1
    have h := hstep j
    rw [h1] at h
    have e3 : Fw (s j) (c j) 3 = app (app (c j) (s j)) (app (s j) (app (c j) (s j))) := rfl
    rw [e3] at h
    simpa only [app.injEq] using h
  -- a top A.B with B a non-tower forces A = tw (K+1) and second component B
  have htop : ∀ j A B, t j = app A B → ¬ Tower B → A = tw (K j + 1) ∧ c j = B := by
    intro j A B htj hB
    have hr := (hKc j).1
    rw [htj, args_app] at hr
    have h2 := (hform j).2
    rw [htj, args_app] at h2
    by_cases hA : 2 ≤ (args A).length
    · exfalso
      have hsuf := first_suf B (args A ++ [B]) _ ⟨args A, B, rfl, Suf.refl⟩ (by simp; omega) hr _ _ rfl
      exact suf_nontower B _ hsuf hB ⟨K j, rfl⟩
    · have hl : (args A ++ [B]).length ≤ 2 := by simp; omega
      have e := reach_stuck _ _ hl hr
      match hax : args A, e with
      | [y], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        refine ⟨?_, e.2.1⟩
        rw [TC.args_one' A y hax, ← e.1]; rfl
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hax] at hA; simp at hA
  -- a non-tower A applied to a non-tower B is never a top
  have hnever : ∀ j A B, t j = app A B → ¬ Tower A → ¬ Tower B → False := by
    intro j A B htj hA hB
    exact hA ⟨_, (htop j A B htj hB).1⟩
  have hwrapnt : ∀ j q, ¬ Tower (app q (s j)) :=
    fun j q => suf_nontower _ _ (Suf.wrap q (s j) Suf.refl) (hnt j)
  -- no step pushes 4 or more multipliers
  have hX4 : ∀ j, 4 ≤ K j → False := by
    intro j hj
    obtain ⟨i, hi⟩ : ∃ i, K j = i + 2 + 2 := ⟨K j - 4, by omega⟩
    have h := hstep j
    rw [hi, Fw_add2, Fw_add2] at h
    simp only [app.injEq] at h
    exact hnever (j + 1) _ _ h.1
      (suf_nontower _ _ (Fw_suf (s j) (c j) i) (hnt j))
      (suf_nontower _ _ (Fw_suf (s j) (c j) (i + 1)) (hnt j))
  -- after a 3-push step: a tail call whose second component is the old stack
  have hG : ∀ j, K j = 3 → K (j + 1) = 1 ∧ c j = tw 2 ∧ t (j + 1 + 1) = s j ∧
      s (j + 1 + 1) = app (s j) (app (tw 2) (s j)) := by
    intro j hj
    obtain ⟨ht1, hs1⟩ := hstep3 j hj
    obtain ⟨hcj, hc1⟩ := htop (j + 1) (c j) (s j) ht1 (hnt j)
    have hk := hK1 (j + 1)
    rcases (show K (j + 1) = 1 ∨ K (j + 1) = 2 ∨ K (j + 1) = 3 ∨ 4 ≤ K (j + 1) by omega) with h1 | h1 | h1 | h1
    · obtain ⟨ht2, hs2⟩ := hstep1 (j + 1) h1
      rw [h1] at hcj
      have hcj2 : c j = tw 2 := hcj
      refine ⟨h1, hcj2, by rw [ht2, hc1], by rw [hs2, hs1, hcj2]⟩
    · exfalso
      obtain ⟨ht2, _⟩ := hstep2 (j + 1) h1
      rw [hs1] at ht2
      exact hnever (j + 1 + 1) _ _ ht2 (hnt j) (hwrapnt j (c j))
    · exfalso
      obtain ⟨ht2, _⟩ := hstep3 (j + 1) h1
      rw [hc1] at ht2
      exact hnever (j + 1 + 1) _ _ ht2 (hnt j) (hnt (j + 1))
    · exact absurd h1 (fun h => hX4 (j + 1) h)
  -- no step pushes exactly 3 multipliers
  have hX3 : ∀ j, K j = 3 → False := by
    intro j hj
    obtain ⟨_, _, _, hs2⟩ := hG j hj
    have hσ : ∀ i, t i = s (j + 1 + 1) → False := by
      intro i hti
      rw [hs2] at hti
      exact hnever i _ _ hti (hnt j) (hwrapnt j (tw 2))
    -- infinitely many steps with K >= 2 (tail calls form R2-chains)
    have hex : ∃ i, j + 2 ≤ i ∧ 2 ≤ K i := by
      refine Classical.byContradiction (fun hno => ?_)
      have hall : ∀ i, j + 2 ≤ i → K i = 1 := fun i hi => by
        have := hK1 i
        have : ¬ 2 ≤ K i := fun h => hno ⟨i, hi, h⟩
        omega
      exact no_R2_chain (fun e => t (j + 2 + e)) (fun e => by
        have h1 := hall (j + 2 + e) (by omega)
        have hr := (hKc (j + 2 + e)).1
        rw [h1] at hr
        obtain ⟨ht', _⟩ := hstep1 (j + 2 + e) h1
        show R2 (t (j + 2 + e)) (t (j + 2 + (e + 1)))
        rw [show j + 2 + (e + 1) = j + 2 + e + 1 by omega, ht']
        exact hr)
    -- the first such step i: the stack is still s (j+2)
    have hfirst_aux : ∀ (e : Nat), j + 2 ≤ e → 2 ≤ K e →
        ∃ i, j + 2 ≤ i ∧ 2 ≤ K i ∧ ∀ x, j + 2 ≤ x → x < i → K x = 1 := by
      intro e
      induction e using Nat.strongRecOn with
      | _ e ih =>
        intro hbe he
        by_cases hmid : ∃ x, j + 2 ≤ x ∧ x < e ∧ 2 ≤ K x
        · obtain ⟨x, hbx, hxe, hx⟩ := hmid
          exact ih x hxe hbx hx
        · refine ⟨e, hbe, he, fun x hbx hxe => ?_⟩
          have := hK1 x
          have : ¬ 2 ≤ K x := fun h => hmid ⟨x, hbx, hxe, h⟩
          omega
    obtain ⟨e0, he0, hK0⟩ := hex
    obtain ⟨i, hi, hKi, hbefore⟩ := hfirst_aux e0 he0 hK0
    have hconst : ∀ n, j + 2 + n ≤ i → s (j + 2 + n) = s (j + 1 + 1) := by
      intro n
      induction n with
      | zero => intro _; rfl
      | succ n ih =>
        intro hn
        rw [show j + 2 + (n + 1) = j + 2 + n + 1 by omega,
          (hstep1 (j + 2 + n) (hbefore _ (by omega) (by omega))).2]
        exact ih (by omega)
    have hsi : s i = s (j + 1 + 1) := by
      have := hconst (i - (j + 2)) (by omega)
      rwa [show j + 2 + (i - (j + 2)) = i by omega] at this
    have hk := hK1 i
    rcases (show K i = 2 ∨ K i = 3 ∨ 4 ≤ K i by omega) with h1 | h1 | h1
    · obtain ⟨ht', _⟩ := hstep2 i h1
      rw [hsi] at ht'
      exact hσ (i + 1) ht'
    · obtain ⟨_, _, ht', _⟩ := hG i h1
      rw [hsi] at ht'
      exact hσ (i + 1 + 1) ht'
    · exact hX4 i h1
  -- so every step is a tail call or an Omega-type step
  exact FG.finite_half_general_families u hchild hflag j0 t s hform (fun j => by
    have h4 : K j < 4 := Nat.lt_of_not_le (fun h => hX4 j h)
    have h3 : K j ≠ 3 := fun h => hX3 j h
    have hk := hK1 j
    rcases (show K j = 1 ∨ K j = 2 by omega) with h1 | h1
    · exact Or.inl (hstep1 j h1).2
    · obtain ⟨ht', hs'⟩ := hstep2 j h1
      exact Or.inr ⟨ht', c j, hs'⟩)

end FM

#print axioms FM.fib_step
#print axioms FM.finite_half_monotone

/-! ## Monotone walks over tower bottoms; the full monotone theorem -/

namespace FM

open C
open C.T

theorem suf_size (w x : T) (h : Suf w x) : size w ≤ size x := by
  induction h with
  | refl => exact Nat.le_refl _
  | wrap p x _ ih => simp only [size]; omega

theorem suf_size_lt (w x : T) (h : Suf w x) (hne : x ≠ w) : size w < size x := by
  cases h with
  | refl => exact absurd rfl hne
  | wrap p x hs =>
    have := suf_size _ _ hs
    have := size_pos p
    simp only [size]; omega

theorem suf_app_inv (w p x : T) (h : Suf w (app p x)) : app p x = w ∨ Suf w x := by
  cases h with
  | refl => left; rfl
  | wrap _ _ hs => right; exact hs

theorem wh_inv (Q z x c w : T) (h : OM.WH Q z x c w) :
    (w = z ∧ Reach (args Q) [x, c]) ∨
    (∃ x0 c0 w0, OM.WH Q z x0 c0 w0 ∧ Reach (args x0 ++ [w0]) [x, c] ∧ w = app c0 w0) := by
  cases h with
  | first _ _ hr => exact Or.inl ⟨rfl, hr⟩
  | next x0 c0 w0 _ _ hH0 hr => exact Or.inr ⟨x0, c0, w0, hH0, hr, rfl⟩

/-- a growing computed step whose new top A has >= 2 arguments and whose new bottom B is a tower starts from a
    bottom of size <= 2 -/
theorem tower_grow (Q z A B d : T) (hQ : 2 ≤ (args Q).length)
    (h : Reach (args (app Q z)) [app A B, d]) (hA : 2 ≤ (args A).length) (hB : Tower B)
    (hne : app A B ≠ z) (hBz : B ≠ z) : size z ≤ 2 := by
  rw [args_app] at h
  rcases OM.cinv2_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hr, hEq⟩
  · have := congrArg List.length hEq; simp at this <;> omega
  · have := congrArg List.length hEq; simp at this <;> omega
  · simp only [List.cons.injEq, app.injEq] at hEq
    obtain ⟨⟨hAc, hBw⟩, _, _⟩ := hEq
    rcases wh_inv _ _ _ _ _ hH with ⟨hwz, _⟩ | ⟨x0, c0, w0, hH0, hr, hw⟩
    · exact absurd (hBw.trans hwz) hBz
    · -- the last head is S S
      have hxSS : x = app S S := by
        by_cases h2 : 2 ≤ (args x).length
        · exfalso
          have hs := first_suf w (args x ++ [w]) [S, b] ⟨args x, w, rfl, Suf.refl⟩ (by simp; omega) hP S b rfl
          have := suf_S _ hs
          rw [hw] at this
          cases this
        · have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
          have e := reach_stuck _ _ hl hP
          match hax : args x, e with
          | [y], e =>
            simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
            rw [TC.args_one' x y hax, ← e.1]
          | [], e => simp at e
          | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
      rw [hxSS] at hr
      have hzw0 : Suf z w0 := wh_suf _ _ _ _ _ hH0
      by_cases h2 : 2 ≤ (args x0).length
      · have hs := first_suf w0 (args x0 ++ [w0]) [app S S, c] ⟨args x0, w0, rfl, Suf.refl⟩ (by simp; omega)
          hr _ _ rfl
        have h0 := suf_size _ _ hs
        have h1 := suf_size _ _ hzw0
        simp only [size] at h0
        omega
      · exfalso
        have hl : (args x0 ++ [w0]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hr
        match hax : args x0, e with
        | [y], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          have hcw : c = w0 := e.2.1
          obtain ⟨m, hm⟩ := hB
          rw [hBw, hw] at hm
          cases m with
          | zero => simp [tw] at hm
          | succ m =>
            simp only [tw, app.injEq] at hm
            rw [hAc, hcw, hm.2] at hA
            cases m with
            | zero => simp [tw, args] at hA
            | succ m => simp [tw, args] at hA
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
  · simp only [List.cons.injEq] at hEq
    exact absurd hEq.1 hne

/-- **Theorem (finite half, eventually monotone walks — full).**  An infinite leftmost walk from a term whose L36
    class has flag 0 never ends in nodes (t j).(s j) with t j having >= 2 arguments (no pops, no jumps) and
    u (j0+j+1) /= s j (no step returns to its bottom).  Non-tower bottoms: finite_half_monotone.  Tower bottoms only:
    a growing step keeps a tower bottom only from a bottom of size <= 2 (tower_grow), so the bottom is eventually
    fixed and FH.finite_half_TC applies. -/
theorem finite_half_monotone_all (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (hflag : FH.flag (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length)
    (hret : ∀ j, u (j0 + j + 1) ≠ s j) : False := by
  by_cases hex : ∃ j, ¬ Tower (s j)
  · obtain ⟨j1, hj1⟩ := hex
    exact finite_half_monotone u hchild hflag (j0 + j1) (fun e => t (j1 + e)) (fun e => s (j1 + e))
      (fun e => by rw [show j0 + j1 + e = j0 + (j1 + e) by omega]; exact hform (j1 + e))
      (fun e => by rw [show j0 + j1 + e + 1 = j0 + (j1 + e) + 1 by omega]; exact hret (j1 + e))
      (by simpa using hj1)
  · have hall : ∀ j, Tower (s j) := fun j => Classical.byContradiction (fun h => hex ⟨j, h⟩)
    have hnext : ∀ j, u (j0 + j + 1) = app (t (j + 1)) (s (j + 1)) := by
      intro j; rw [show j0 + j + 1 = j0 + (j + 1) by omega]; exact (hform (j + 1)).1
    have hreach : ∀ j, ∃ d, Reach (args (app (t j) (s j))) [app (t (j + 1)) (s (j + 1)), d] := by
      intro j
      have hc := hchild (j0 + j)
      rw [(hform j).1, hnext j] at hc
      rcases hc with ⟨hlen, _, _⟩ | ⟨_, d, hr⟩
      · exfalso; rw [C.args_app] at hlen; have := (hform j).2; simp at hlen; omega
      · exact ⟨d, hr⟩
    have hsuf : ∀ j, Suf (s j) (s (j + 1)) := by
      intro j
      obtain ⟨d, hr⟩ := hreach j
      rw [args_app] at hr
      have hs := first_suf (s j) (args (t j) ++ [s j]) _ ⟨args (t j), s j, rfl, Suf.refl⟩
        (by have := (hform j).2; simp; omega) hr _ _ rfl
      rcases suf_app_inv _ _ _ hs with h | h
      · exact absurd (by rw [hnext j]; exact h) (hret j)
      · exact h
    have hgrow : ∀ j, s (j + 1) ≠ s j → size (s j) ≤ 2 := by
      intro j hne
      obtain ⟨d, hr⟩ := hreach j
      exact tower_grow (t j) (s j) (t (j + 1)) (s (j + 1)) d (hform j).2 hr (hform (j + 1)).2 (hall (j + 1))
        (by rw [← hnext j]; exact hret j) hne
    have hmono : ∀ a b, a ≤ b → size (s a) ≤ size (s b) := by
      intro a b hab
      induction b with
      | zero =>
        obtain rfl : a = 0 := by omega
        exact Nat.le_refl _
      | succ b ih =>
        by_cases h : a = b + 1
        · subst h; exact Nat.le_refl _
        · exact Nat.le_trans (ih (by omega)) (suf_size _ _ (hsuf b))
    have hstrict : ∀ j, s (j + 1) ≠ s j → size (s j) < size (s (j + 1)) :=
      fun j hne => suf_size_lt _ _ (hsuf j) hne
    have hev : ∃ N, ∀ j, N ≤ j → s (j + 1) = s j := by
      by_cases h3 : ∃ N, 3 ≤ size (s N)
      · obtain ⟨N, hN⟩ := h3
        refine ⟨N, fun j hj => Classical.byContradiction (fun hne => ?_)⟩
        have := hgrow j hne
        have := hmono N j hj
        omega
      · by_cases h2 : ∃ N, 2 ≤ size (s N)
        · obtain ⟨N, hN⟩ := h2
          refine ⟨N, fun j hj => Classical.byContradiction (fun hne => ?_)⟩
          have := hstrict j hne
          have := hmono N j hj
          exact h3 ⟨j + 1, by omega⟩
        · refine ⟨0, fun j _ => Classical.byContradiction (fun hne => ?_)⟩
          have := hstrict j hne
          have := size_pos (s j)
          exact h2 ⟨j + 1, by omega⟩
    obtain ⟨N, hN⟩ := hev
    have hconst : ∀ e, s (N + e) = s N := by
      intro e
      induction e with
      | zero => rfl
      | succ e ih => rw [show N + (e + 1) = N + e + 1 by omega, hN (N + e) (by omega), ih]
    exact FH.finite_half_TC u hchild hflag (j0 + N) (s N) (fun e => t (N + e))
      (fun e => ⟨by rw [show j0 + N + e = j0 + (N + e) by omega, (hform (N + e)).1, hconst e], (hform (N + e)).2⟩)

end FM

#print axioms FM.finite_half_monotone_all

/-! ## Rightmost path: monotone walks (every node with >= 3 arguments) — RM -/

namespace RM

open C
open C.T
open FM

/-- **Lemma Fib, both components.**  Over a non-tower bottom z, if Q has >= 2 arguments and the head run of Q.z
    reaches [ch, d], then H(Q) = S (tw K) c0, ch = Fw z c0 K and d = Fw z c0 (K+1). -/
theorem fib_step2 (Q z ch d : T) (hQ : 2 ≤ (args Q).length) (hz : ¬ Tower z)
    (h : Reach (args (app Q z)) [ch, d]) :
    ∃ K c0, Reach (args Q) [tw K, c0] ∧ ch = Fw z c0 K ∧ d = Fw z c0 (K + 1) := by
  rw [args_app] at h
  have hzS : z ≠ S := fun h' => hz ⟨0, h'⟩
  rcases OM.cinv2_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hr, hEq⟩
  · have := congrArg List.length hEq; simp at this <;> omega
  · have := congrArg List.length hEq; simp at this <;> omega
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hch, hd, _⟩ := hEq
    rcases wh_J Q z x c w hz hH with hnt | ⟨c0, i, m, hQ0, hxm, hw, hc⟩
    · exfalso
      by_cases h2 : 2 ≤ (args x).length
      · have hsuf : Suf w S :=
          first_suf w (args x ++ [w]) [S, b] ⟨args x, w, rfl, Suf.refl⟩ (by simp; omega) hP S b rfl
        have hwS : w = S := suf_S w hsuf
        have hzw : Suf z w := wh_suf _ _ _ _ _ hH
        rw [hwS] at hzw
        exact hzS (suf_S z hzw)
      · have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [y], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          apply hnt
          exact ⟨1, by rw [TC.args_one' x y hax, ← e.1]; rfl⟩
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
    · subst hxm
      cases m with
      | zero => exact absurd (show tw 0 = S from rfl) hx
      | succ m =>
        have e := reach_stuck _ _ (by simp [args, tw]) hP
        simp only [tw, args, List.nil_append, List.cons_append, List.cons.injEq] at e
        have hm : m = 0 := by
          cases m with
          | zero => rfl
          | succ m => simp [tw] at e
        subst hm
        rw [show 0 + 1 + i = i + 1 by omega] at hQ0
        refine ⟨i + 1, c0, hQ0, ?_, ?_⟩
        · rw [hch, hw, hc]
          exact Fw_succ z c0 i
        · rw [hd, e.2.1, hw, hc, Fw_succ z c0 i]
          exact (Fw_add2 z c0 i).symm
  · simp only [List.cons.injEq] at hEq
    exact ⟨0, y, hr, hEq.1, hEq.2.1⟩

/-- **Theorem (rightmost finite half, monotone walks).**  A rightmost walk from a term whose R19 class has flag 0
    never ends in nodes (t j).(s j) with t j having >= 2 arguments (every node has >= 3 arguments, so no rightmost
    step drops a multiplier), once the bottom s 0 is not a tower.  Proof: the rightmost child of a Fibonacci-K node is
    Fw (K+1); a push count P = K+1 >= 4 or P = 3 later forces a non-tower into a tower position; P = 1 are rightmost
    tail calls and P = 2 rightmost reload-type steps, excluded by RG.finite_half_right_general. -/
theorem finite_half_right_monotone (u : Nat → C.T) (hchild : ∀ j, RR.RChildC (u j) (u (j + 1)))
    (hflag : RR.flagR (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length)
    (htw : ¬ Tower (s 0)) : False := by
  have hfib : ∀ j, ¬ Tower (s j) →
      ∃ K c0, Reach (args (t j)) [tw K, c0] ∧ u (j0 + j + 1) = Fw (s j) c0 (K + 1) := by
    intro j hj
    have hc := hchild (j0 + j)
    rw [(hform j).1] at hc
    rcases hc with ⟨hlen, _, _⟩ | ⟨_, c, hr⟩
    · exfalso; rw [C.args_app] at hlen; have := (hform j).2; simp at hlen; omega
    · obtain ⟨K, c0, h1, _, h3⟩ := fib_step2 (t j) (s j) c _ (hform j).2 hj hr
      exact ⟨K, c0, h1, h3⟩
  have hnext : ∀ j, u (j0 + j + 1) = app (t (j + 1)) (s (j + 1)) := by
    intro j; rw [show j0 + j + 1 = j0 + (j + 1) by omega]; exact (hform (j + 1)).1
  have hnt : ∀ j, ¬ Tower (s j) := by
    intro j
    induction j with
    | zero => exact htw
    | succ j ih =>
      obtain ⟨K, c0, _, hu⟩ := hfib j ih
      rw [hnext j] at hu
      match K, hu with
      | 0, hu =>
        have e1 : Fw (s j) c0 (0 + 1) = app c0 (s j) := rfl
        rw [e1] at hu
        simp only [app.injEq] at hu
        rw [hu.2]; exact ih
      | i + 1, hu =>
        rw [show i + 1 + 1 = i + 2 by omega, Fw_add2] at hu
        simp only [app.injEq] at hu
        rw [hu.2]
        exact suf_nontower _ _ (Fw_suf (s j) c0 (i + 1)) ih
  obtain ⟨K, hK⟩ : ∃ K : Nat → Nat, ∀ j, ∃ c0, Reach (args (t j)) [tw (K j), c0] ∧
      u (j0 + j + 1) = Fw (s j) c0 (K j + 1) :=
    ⟨fun j => Classical.choose (hfib j (hnt j)), fun j => Classical.choose_spec (hfib j (hnt j))⟩
  obtain ⟨c, hKc⟩ : ∃ c : Nat → T, ∀ j, Reach (args (t j)) [tw (K j), c j] ∧
      u (j0 + j + 1) = Fw (s j) (c j) (K j + 1) :=
    ⟨fun j => Classical.choose (hK j), fun j => Classical.choose_spec (hK j)⟩
  have hstep : ∀ j, app (t (j + 1)) (s (j + 1)) = Fw (s j) (c j) (K j + 1) :=
    fun j => (hnext j).symm.trans (hKc j).2
  have hstep0 : ∀ j, K j = 0 → t (j + 1) = c j ∧ s (j + 1) = s j := by
    intro j h1
    have h := hstep j
    rw [h1] at h
    have e1 : Fw (s j) (c j) (0 + 1) = app (c j) (s j) := rfl
    rw [e1] at h
    simpa only [app.injEq] using h
  have hstep1 : ∀ j, K j = 1 → t (j + 1) = s j ∧ s (j + 1) = app (c j) (s j) := by
    intro j h1
    have h := hstep j
    rw [h1] at h
    have e2 : Fw (s j) (c j) (1 + 1) = app (s j) (app (c j) (s j)) := rfl
    rw [e2] at h
    simpa only [app.injEq] using h
  have hstep2 : ∀ j, K j = 2 →
      t (j + 1) = app (c j) (s j) ∧ s (j + 1) = app (s j) (app (c j) (s j)) := by
    intro j h1
    have h := hstep j
    rw [h1] at h
    have e3 : Fw (s j) (c j) (2 + 1) = app (app (c j) (s j)) (app (s j) (app (c j) (s j))) := rfl
    rw [e3] at h
    simpa only [app.injEq] using h
  have htop : ∀ j A B, t j = app A B → ¬ Tower B → A = tw (K j + 1) ∧ c j = B := by
    intro j A B htj hB
    have hr := (hKc j).1
    rw [htj, args_app] at hr
    have h2 := (hform j).2
    rw [htj, args_app] at h2
    by_cases hA : 2 ≤ (args A).length
    · exfalso
      have hsuf := first_suf B (args A ++ [B]) _ ⟨args A, B, rfl, Suf.refl⟩ (by simp; omega) hr _ _ rfl
      exact suf_nontower B _ hsuf hB ⟨K j, rfl⟩
    · have hl : (args A ++ [B]).length ≤ 2 := by simp; omega
      have e := reach_stuck _ _ hl hr
      match hax : args A, e with
      | [y], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        refine ⟨?_, e.2.1⟩
        rw [TC.args_one' A y hax, ← e.1]; rfl
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hax] at hA; simp at hA
  have hnever : ∀ j A B, t j = app A B → ¬ Tower A → ¬ Tower B → False := by
    intro j A B htj hA hB
    exact hA ⟨_, (htop j A B htj hB).1⟩
  have hwrapnt : ∀ j q, ¬ Tower (app q (s j)) :=
    fun j q => suf_nontower _ _ (Suf.wrap q (s j) Suf.refl) (hnt j)
  have hX3 : ∀ j, 3 ≤ K j → False := by
    intro j hj
    obtain ⟨i, hi⟩ : ∃ i, K j + 1 = i + 2 + 2 := ⟨K j - 3, by omega⟩
    have h := hstep j
    rw [hi, Fw_add2, Fw_add2] at h
    simp only [app.injEq] at h
    exact hnever (j + 1) _ _ h.1
      (suf_nontower _ _ (Fw_suf (s j) (c j) i) (hnt j))
      (suf_nontower _ _ (Fw_suf (s j) (c j) (i + 1)) (hnt j))
  have hG : ∀ j, K j = 2 → K (j + 1) = 0 ∧ c j = tw 1 ∧ t (j + 1 + 1) = s j ∧
      s (j + 1 + 1) = app (s j) (app (tw 1) (s j)) := by
    intro j hj
    obtain ⟨ht1, hs1⟩ := hstep2 j hj
    obtain ⟨hcj, hc1⟩ := htop (j + 1) (c j) (s j) ht1 (hnt j)
    rcases (show K (j + 1) = 0 ∨ K (j + 1) = 1 ∨ K (j + 1) = 2 ∨ 3 ≤ K (j + 1) by omega) with h1 | h1 | h1 | h1
    · obtain ⟨ht2, hs2⟩ := hstep0 (j + 1) h1
      rw [h1] at hcj
      have hcj2 : c j = tw 1 := hcj
      refine ⟨h1, hcj2, by rw [ht2, hc1], by rw [hs2, hs1, hcj2]⟩
    · exfalso
      obtain ⟨ht2, _⟩ := hstep1 (j + 1) h1
      rw [hs1] at ht2
      exact hnever (j + 1 + 1) _ _ ht2 (hnt j) (hwrapnt j (c j))
    · exfalso
      obtain ⟨ht2, _⟩ := hstep2 (j + 1) h1
      rw [hc1] at ht2
      exact hnever (j + 1 + 1) _ _ ht2 (hnt j) (hnt (j + 1))
    · exact absurd h1 (fun h => hX3 (j + 1) h)
  have hX2 : ∀ j, K j = 2 → False := by
    intro j hj
    obtain ⟨_, _, _, hs2⟩ := hG j hj
    have hσ : ∀ i, t i = s (j + 1 + 1) → False := by
      intro i hti
      rw [hs2] at hti
      exact hnever i _ _ hti (hnt j) (hwrapnt j (tw 1))
    have hex : ∃ i, j + 2 ≤ i ∧ 1 ≤ K i := by
      refine Classical.byContradiction (fun hno => ?_)
      have hall : ∀ i, j + 2 ≤ i → K i = 0 := fun i hi => by
        have : ¬ 1 ≤ K i := fun h => hno ⟨i, hi, h⟩
        omega
      exact no_R_chain (fun e => t (j + 2 + e)) (fun e => by
        have h1 := hall (j + 2 + e) (by omega)
        have hr := (hKc (j + 2 + e)).1
        rw [h1] at hr
        obtain ⟨ht', _⟩ := hstep0 (j + 2 + e) h1
        show R (t (j + 2 + e)) (t (j + 2 + (e + 1)))
        rw [show j + 2 + (e + 1) = j + 2 + e + 1 by omega, ht']
        exact hr)
    have hfirst_aux : ∀ (e : Nat), j + 2 ≤ e → 1 ≤ K e →
        ∃ i, j + 2 ≤ i ∧ 1 ≤ K i ∧ ∀ x, j + 2 ≤ x → x < i → K x = 0 := by
      intro e
      induction e using Nat.strongRecOn with
      | _ e ih =>
        intro hbe he
        by_cases hmid : ∃ x, j + 2 ≤ x ∧ x < e ∧ 1 ≤ K x
        · obtain ⟨x, hbx, hxe, hx⟩ := hmid
          exact ih x hxe hbx hx
        · refine ⟨e, hbe, he, fun x hbx hxe => ?_⟩
          have : ¬ 1 ≤ K x := fun h => hmid ⟨x, hbx, hxe, h⟩
          omega
    obtain ⟨e0, he0, hK0⟩ := hex
    obtain ⟨i, hi, hKi, hbefore⟩ := hfirst_aux e0 he0 hK0
    have hconst : ∀ n, j + 2 + n ≤ i → s (j + 2 + n) = s (j + 1 + 1) := by
      intro n
      induction n with
      | zero => intro _; rfl
      | succ n ih =>
        intro hn
        rw [show j + 2 + (n + 1) = j + 2 + n + 1 by omega,
          (hstep0 (j + 2 + n) (hbefore _ (by omega) (by omega))).2]
        exact ih (by omega)
    have hsi : s i = s (j + 1 + 1) := by
      have := hconst (i - (j + 2)) (by omega)
      rwa [show j + 2 + (i - (j + 2)) = i by omega] at this
    rcases (show K i = 1 ∨ K i = 2 ∨ 3 ≤ K i by omega) with h1 | h1 | h1
    · obtain ⟨ht', _⟩ := hstep1 i h1
      rw [hsi] at ht'
      exact hσ (i + 1) ht'
    · obtain ⟨_, _, ht', _⟩ := hG i h1
      rw [hsi] at ht'
      exact hσ (i + 1 + 1) ht'
    · exact hX3 i h1
  exact RG.finite_half_right_general u hchild hflag j0 t s
    (fun j => ⟨(hform j).1, (hform j).2, fun h => hnt j ⟨0, h⟩⟩)
    (fun j => by
      have h3 : K j < 3 := Nat.lt_of_not_le (fun h => hX3 j h)
      have h2 : K j ≠ 2 := fun h => hX2 j h
      rcases (show K j = 0 ∨ K j = 1 by omega) with h1 | h1
      · exact Or.inl (hstep0 j h1).2
      · obtain ⟨ht', hs'⟩ := hstep1 j h1
        exact Or.inr ⟨ht', c j, hs'⟩)

end RM

#print axioms RM.fib_step2
#print axioms RM.finite_half_right_monotone

/-! ## Rightmost path: monotone walks over tower bottoms; the full rightmost monotone theorem -/

namespace RM

open C
open C.T
open FM

/-- a rightmost computed step whose child A.B has A with >= 2 arguments and a tower B /= z starts from z = S -/
theorem rtower_grow (Q z A B c : T) (hQ : 2 ≤ (args Q).length)
    (h : Reach (args (app Q z)) [c, app A B]) (hA : 2 ≤ (args A).length) (hB : Tower B)
    (hBz : B ≠ z) : z = S := by
  rw [args_app] at h
  rcases OM.cinv2_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c', w, b, hx, hH, hP, hEq⟩ | ⟨y, hr, hEq⟩
  · have := congrArg List.length hEq; simp at this <;> omega
  · have := congrArg List.length hEq; simp at this <;> omega
  · simp only [List.cons.injEq, app.injEq] at hEq
    obtain ⟨_, ⟨hAb, hBcw⟩, _⟩ := hEq
    by_cases h2 : 2 ≤ (args x).length
    · rcases final_shape (args x) w S b h2 hP with ⟨hwS, _⟩ | hbig
      · exact suf_S z (by rw [hwS]; exact wh_suf _ _ _ _ _ hH)
      · exfalso; simp [size] at hbig; have := size_pos w; omega
    · exfalso
      have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
      have e := reach_stuck _ _ hl hP
      match hax : args x, e with
      | [y], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        have hbw : b = w := e.2.1
        obtain ⟨m, hm⟩ := hB
        rw [hBcw] at hm
        cases m with
        | zero => simp [tw] at hm
        | succ m =>
          simp only [tw, app.injEq] at hm
          rw [hAb, hbw, hm.2] at hA
          cases m with
          | zero => simp [tw, args] at hA
          | succ m => simp [tw, args] at hA
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
  · simp only [List.cons.injEq, app.injEq] at hEq
    exact absurd hEq.2.1.2 hBz

/-- **Theorem (rightmost path, eventually monotone walks — full).**  A rightmost walk from a term whose R19 class has
    flag 0 never ends in nodes (t j).(s j) with t j having >= 2 arguments (every node with >= 3 arguments, i.e. no
    rightmost step ever drops a multiplier).  Non-tower bottoms: finite_half_right_monotone.  Tower bottoms only:
    the bottom changes at most once (from S, rtower_grow), and then the steps are rightmost tail calls over a fixed
    bottom — an infinite R-chain, impossible. -/
theorem finite_half_right_monotone_all (u : Nat → C.T) (hchild : ∀ j, RR.RChildC (u j) (u (j + 1)))
    (hflag : RR.flagR (u 0) = false) (j0 : Nat) (t s : Nat → C.T)
    (hform : ∀ j, u (j0 + j) = app (t j) (s j) ∧ 2 ≤ (C.args (t j)).length) : False := by
  by_cases hex : ∃ j, ¬ Tower (s j)
  · obtain ⟨j1, hj1⟩ := hex
    exact finite_half_right_monotone u hchild hflag (j0 + j1) (fun e => t (j1 + e)) (fun e => s (j1 + e))
      (fun e => by rw [show j0 + j1 + e = j0 + (j1 + e) by omega]; exact hform (j1 + e))
      (by simpa using hj1)
  · have hall : ∀ j, Tower (s j) := fun j => Classical.byContradiction (fun h => hex ⟨j, h⟩)
    have hnext : ∀ j, u (j0 + j + 1) = app (t (j + 1)) (s (j + 1)) := by
      intro j; rw [show j0 + j + 1 = j0 + (j + 1) by omega]; exact (hform (j + 1)).1
    have hreach : ∀ j, ∃ c, Reach (args (app (t j) (s j))) [c, app (t (j + 1)) (s (j + 1))] := by
      intro j
      have hc := hchild (j0 + j)
      rw [(hform j).1, hnext j] at hc
      rcases hc with ⟨hlen, _, _⟩ | ⟨_, c, hr⟩
      · exfalso; rw [C.args_app] at hlen; have := (hform j).2; simp at hlen; omega
      · exact ⟨c, hr⟩
    -- the new bottom is the first hnf component, a spine-wrap of the old bottom
    have hsuf : ∀ j, Suf (s j) (s (j + 1)) := by
      intro j
      obtain ⟨c, hr⟩ := hreach j
      rw [args_app] at hr
      obtain ⟨b, hb⟩ := final_app _ _ _ (by have := (hform j).2; simp; omega) hr
      simp only [app.injEq] at hb
      have hs := first_suf (s j) (args (t j) ++ [s j]) _ ⟨args (t j), s j, rfl, Suf.refl⟩
        (by have := (hform j).2; simp; omega) hr _ _ rfl
      rw [← hb.2] at hs
      exact hs
    have hchg : ∀ j, s (j + 1) ≠ s j → s j = S := by
      intro j hne
      obtain ⟨c, hr⟩ := hreach j
      exact rtower_grow (t j) (s j) (t (j + 1)) (s (j + 1)) c (hform j).2 hr (hform (j + 1)).2 (hall (j + 1)) hne
    have hmono : ∀ a b, a ≤ b → size (s a) ≤ size (s b) := by
      intro a b hab
      induction b with
      | zero =>
        obtain rfl : a = 0 := by omega
        exact Nat.le_refl _
      | succ b ih =>
        by_cases h : a = b + 1
        · subst h; exact Nat.le_refl _
        · exact Nat.le_trans (ih (by omega)) (suf_size _ _ (hsuf b))
    have hev : ∃ N, ∀ j, N ≤ j → s (j + 1) = s j := by
      by_cases h2 : ∃ N, 2 ≤ size (s N)
      · obtain ⟨N, hN⟩ := h2
        refine ⟨N, fun j hj => Classical.byContradiction (fun hne => ?_)⟩
        have h1 := hchg j hne
        have := hmono N j hj
        rw [h1] at this
        simp only [size] at this
        omega
      · refine ⟨0, fun j _ => Classical.byContradiction (fun hne => ?_)⟩
        have := suf_size_lt _ _ (hsuf j) hne
        have := size_pos (s j)
        exact h2 ⟨j + 1, by omega⟩
    obtain ⟨N, hN⟩ := hev
    have hconst : ∀ e, s (N + e) = s N := by
      intro e
      induction e with
      | zero => rfl
      | succ e ih => rw [show N + (e + 1) = N + e + 1 by omega, hN (N + e) (by omega), ih]
    -- rightmost tail calls over a fixed bottom: an infinite R-chain
    exact no_R_chain (fun e => t (N + e)) (fun e => by
      obtain ⟨c, hr⟩ := hreach (N + e)
      have h1 : s (N + e + 1) = s (N + e) := hN (N + e) (by omega)
      rw [h1] at hr
      have := RR.right_tail_detect (t (N + e)) (s (N + e)) c (t (N + e + 1)) (hform (N + e)).2 hr
      show R (t (N + e)) (t (N + (e + 1)))
      rw [show N + (e + 1) = N + e + 1 by omega]
      exact this)

end RM

#print axioms RM.finite_half_right_monotone_all

/-! ## Tower-headed chains and Scenario A over a non-tower fuel — SA -/

namespace SA

open C
open C.T
open FM

/-- H(W) = S (tw K) W' for some K -/
def TT (W W' : T) : Prop := ∃ K, Reach (args W) [tw K, W']

/-- the argument of an application -/
def rpart : T → T
  | S => S
  | app _ x => x

theorem args_tw_le (m : Nat) : (args (tw m)).length ≤ 1 := by
  cases m with
  | zero => simp [tw, args]
  | succ m => simp [tw, args]

theorem TT_strip (Q z W' : T) (hQ : 2 ≤ (args Q).length) (h : TT (app Q z) W') :
    ∃ K Y, W' = app Y (tw K) ∧ ((z = tw K ∧ R Q Y) ∨ (z = S ∧ K = 1) ∨ (args Y).length ≤ 1) := by
  obtain ⟨K, hK⟩ := h
  rw [args_app] at hK
  rcases OM.cinv2_reach Q z hQ _ hK with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hr, hEq⟩
  · have := congrArg List.length hEq; simp at this <;> omega
  · have := congrArg List.length hEq; simp at this <;> omega
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hcw, hW', _⟩ := hEq
    cases K with
    | zero => simp [tw] at hcw
    | succ K =>
      simp only [tw, app.injEq] at hcw
      obtain ⟨hc, hw⟩ := hcw
      refine ⟨K + 1, b, ?_, ?_⟩
      · rw [hW', ← hc, ← hw]; rfl
      · by_cases h2 : 2 ≤ (args x).length
        · rcases final_shape (args x) w S b h2 hP with ⟨hwS, _⟩ | hbig
          · right; left
            have hzS : z = S := suf_S z (by rw [hwS]; exact wh_suf _ _ _ _ _ hH)
            refine ⟨hzS, ?_⟩
            rw [← hw] at hwS
            cases K with
            | zero => rfl
            | succ K => simp [tw] at hwS
          · exfalso; simp [size] at hbig; have := size_pos w; omega
        · right; right
          have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
          have e := reach_stuck _ _ hl hP
          match hax : args x, e with
          | [y], e =>
            simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
            rw [e.2.1, ← hw]
            exact args_tw_le K
          | [], e => simp at e
          | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hz, hW', _⟩ := hEq
    exact ⟨K, y, by rw [hW', ← hz], Or.inl ⟨hz.symm, hr⟩⟩

/-- a tower-headed chain through Y.(tw m) with Y having <= 1 argument dies within two steps -/
theorem TT_dies (Y : T) (m : Nat) (W1 W2 : T) (hY : (args Y).length ≤ 1) (h1 : TT (app Y (tw m)) W1)
    (h2 : TT W1 W2) : False := by
  obtain ⟨K1, hK1⟩ := h1
  have hl : (args (app Y (tw m))).length ≤ 2 := by rw [args_app]; simp; omega
  have e := reach_stuck _ _ hl hK1
  rw [args_app] at e
  match hax : args Y, e with
  | [y0], e =>
    simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
    obtain ⟨K2, hK2⟩ := h2
    rw [e.2.1] at hK2
    have e2 := reach_stuck _ _ (by have := args_tw_le m; omega) hK2
    have h3 := congrArg List.length e2
    simp at h3
    have := args_tw_le m
    omega
  | [], e => simp at e
  | _ :: _ :: _, _ => rw [hax] at hY; simp at hY

/-- **No infinite tower-headed chain.**  There is no sequence W0, W1, ... of closed S-terms with
    H(W_j) = S (tw K_j) W_(j+1) (tw 0 = S, tw (K+1) = S (tw K)).  Generalises no_R_chain (all K_j = 0) and
    no_R2_chain (all K_j = 1). -/
theorem no_TT_chain (f : Nat → T) (hT : ∀ j, TT (f j) (f (j + 1))) : False := by
  have hbig : ∃ j1, 3 ≤ (args (f j1)).length := by
    refine Classical.byContradiction (fun hno => ?_)
    have hsmall : ∀ j, (args (f j)).length ≤ 2 := fun j => by
      have : ¬ 3 ≤ (args (f j)).length := fun h => hno ⟨j, h⟩
      omega
    have hdec : ∀ j, size (f (j + 1)) < size (f j) := by
      intro j
      obtain ⟨K, hK⟩ := hT j
      have e := reach_stuck _ _ (hsmall j) hK
      have hmem : f (j + 1) ∈ args (f j) := by rw [← e]; simp
      exact size_args _ _ hmem
    have hb : ∀ j, size (f j) + j ≤ size (f 0) := by
      intro j
      induction j with
      | zero => simp
      | succ j ih => have := hdec j; omega
    have := hb (size (f 0) + 1)
    have := size_pos (f (size (f 0) + 1))
    omega
  obtain ⟨j1, hj1⟩ := hbig
  -- from j1 + 1 on every node is Y.(tw m) with Y having >= 2 arguments
  have hstrip : ∀ j Q z, f j = app Q z → 2 ≤ (args Q).length →
      ∃ K Y, f (j + 1) = app Y (tw K) ∧ 2 ≤ (args Y).length ∧ ((z = tw K ∧ R Q Y) ∨ (z = S ∧ K = 1)) := by
    intro j Q z hfj hQ
    have h := hT j
    rw [hfj] at h
    obtain ⟨K, Y, hW, hc⟩ := TT_strip Q z _ hQ h
    by_cases hY : (args Y).length ≤ 1
    · exfalso
      have h1 := hT (j + 1)
      rw [hW] at h1
      exact TT_dies Y K _ _ hY h1 (hT (j + 1 + 1))
    · rcases hc with hc | hc | hc
      · exact ⟨K, Y, hW, by omega, Or.inl hc⟩
      · exact ⟨K, Y, hW, by omega, Or.inr hc⟩
      · exact absurd hc hY
  have hP : ∀ e, ∃ Y m, f (j1 + 1 + e) = app Y (tw m) ∧ 2 ≤ (args Y).length := by
    intro e
    induction e with
    | zero =>
      match hf : f j1 with
      | S => rw [hf] at hj1; simp [args] at hj1
      | app Q z =>
        have hQ : 2 ≤ (args Q).length := by rw [hf, args_app] at hj1; simp at hj1; omega
        obtain ⟨K, Y, hW, hY, _⟩ := hstrip j1 Q z hf hQ
        exact ⟨Y, K, by simpa using hW, hY⟩
    | succ e ih =>
      obtain ⟨Y, m, hfe, hY⟩ := ih
      obtain ⟨K, Y', hW, hY', _⟩ := hstrip _ Y (tw m) hfe hY
      exact ⟨Y', K, by rw [show j1 + 1 + (e + 1) = j1 + 1 + e + 1 by omega]; exact hW, hY'⟩
  -- transitions: an R-step of the function parts, or the bottom grows from S to S S
  have htrans : ∀ e, (rpart (f (j1 + 1 + e + 1)) = rpart (f (j1 + 1 + e)) ∧
      R (lchild (f (j1 + 1 + e))) (lchild (f (j1 + 1 + e + 1)))) ∨
      (rpart (f (j1 + 1 + e)) = S ∧ rpart (f (j1 + 1 + e + 1)) = tw 1) := by
    intro e
    obtain ⟨Y, m, hfe, hY⟩ := hP e
    obtain ⟨K, Y', hW, _, hc⟩ := hstrip _ Y (tw m) hfe hY
    rw [hfe, hW]
    rcases hc with ⟨hm, hR⟩ | ⟨hm, hK⟩
    · left; exact ⟨by simp only [rpart]; exact hm.symm, by simp only [lchild]; exact hR⟩
    · right; subst hK; exact ⟨by simp only [rpart]; exact hm, by simp only [rpart]⟩
  -- eventually only R-steps
  have hev : ∃ J, ∀ e, J ≤ e → R (lchild (f (j1 + 1 + e))) (lchild (f (j1 + 1 + e + 1))) := by
    by_cases hg : ∃ e2, rpart (f (j1 + 1 + e2)) = S ∧ rpart (f (j1 + 1 + e2 + 1)) = tw 1
    · obtain ⟨e2, _, hg2⟩ := hg
      have hnS : ∀ n, rpart (f (j1 + 1 + (e2 + 1 + n))) ≠ S := by
        intro n
        induction n with
        | zero =>
          rw [show j1 + 1 + (e2 + 1 + 0) = j1 + 1 + e2 + 1 by omega, hg2]
          intro h; simp [tw] at h
        | succ n ih =>
          rcases htrans (e2 + 1 + n) with ⟨h1, _⟩ | ⟨h1, _⟩
          · rw [show j1 + 1 + (e2 + 1 + (n + 1)) = j1 + 1 + (e2 + 1 + n) + 1 by omega, h1]; exact ih
          · exact absurd h1 ih
      refine ⟨e2 + 1, fun e he => ?_⟩
      rcases htrans e with ⟨_, hR⟩ | ⟨h1, _⟩
      · exact hR
      · exfalso
        have := hnS (e - (e2 + 1))
        rw [show e2 + 1 + (e - (e2 + 1)) = e by omega] at this
        exact this h1
    · refine ⟨0, fun e _ => ?_⟩
      rcases htrans e with ⟨_, hR⟩ | ⟨h1, h2⟩
      · exact hR
      · exact absurd ⟨e, h1, h2⟩ hg
  obtain ⟨J, hJ⟩ := hev
  exact no_R_chain (fun e => lchild (f (j1 + 1 + (J + e)))) (fun e => by
    have := hJ (J + e) (by omega)
    show R (lchild (f (j1 + 1 + (J + e)))) (lchild (f (j1 + 1 + (J + (e + 1)))))
    rw [show j1 + 1 + (J + (e + 1)) = j1 + 1 + (J + e) + 1 by omega]
    exact this)

end SA

#print axioms SA.no_TT_chain

/-! ## Scenario A over a non-tower fuel is impossible -/

namespace SA

open C
open C.T
open FM

def iter {α : Type} (g : α → α) (a : α) : Nat → α
  | 0 => a
  | n + 1 => g (iter g a n)

theorem fw_suf1 (z c : T) : ∀ K, Suf (app c z) (Fw z c (K + 1))
  | 0 => Suf.refl
  | K + 1 => Suf.wrap _ _ (fw_suf1 z c K)

/-- a leftmost step that is not a jump keeps every proper right-spine suffix of the node -/
theorem step_keeps (u u' σ : T) (hc : FH.LChild u u') (hs : Suf σ u) (hne : u ≠ σ)
    (hnj : ∀ p τ, u ≠ app (app S p) τ) : Suf σ u' := by
  cases u with
  | S => exact absurd (suf_S σ hs).symm hne
  | app A B =>
    have hsB : Suf σ B := by
      rcases suf_app_inv σ A B hs with h | h
      · exact absurd h hne
      · exact h
    rcases hc with ⟨hlen, rest, hr⟩ | ⟨hlen, d, hr⟩
    · rw [args_app] at hlen hr
      match hA : args A, hlen, hr with
      | [], _, hr =>
        simp only [List.nil_append, List.cons.injEq] at hr
        rw [← hr.1]; exact hsB
      | [p], _, _ =>
        exact absurd (by rw [TC.args_one' A p hA]) (hnj p B)
      | _ :: _ :: _, hlen, _ => simp at hlen
    · rw [args_app] at hr hlen
      have := first_suf B (args A ++ [B]) _ ⟨args A, B, rfl, Suf.refl⟩ hlen hr _ _ rfl
      exact suf_trans _ _ _ hsB this

/-- **Theorem (no Scenario A over a non-tower fuel).**  There is no jump-free infinite leftmost walk (no node with
    exactly two arguments) that keeps a non-tower term Z as a proper right-spine suffix of every node and returns
    infinitely often to the level directly above Z (nodes q.Z).  No flag hypothesis.  Proof: at a return q.Z the step
    is a Fibonacci step (FM.fib_step) with H(q) = S (tw K) c and K >= 1; the walk stays above c.Z until it reaches c.Z,
    so the next return multiplier is c; the return multipliers would form an infinite tower-headed chain
    (no_TT_chain). -/
theorem no_scenarioA (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (Z : T) (hZ : ¬ Tower Z)
    (hnj : ∀ j p τ, u j ≠ app (app S p) τ)
    (habove : ∀ j, Suf Z (u j) ∧ u j ≠ Z)
    (hret : ∀ N, ∃ j, N ≤ j ∧ ∃ q, u j = app q Z) : False := by
  have hstep : ∀ r q, u r = app q Z → ∃ c, TT q c ∧ Suf (app c Z) (u (r + 1)) := by
    intro r q hr
    have hc := hchild r
    rw [hr] at hc
    rcases hc with ⟨hlen, rest, hrr⟩ | ⟨hlen, d, hrr⟩
    · exfalso
      rw [args_app] at hlen hrr
      match hA : args q, hlen, hrr with
      | [], _, hrr =>
        simp only [List.nil_append, List.cons.injEq] at hrr
        exact (habove (r + 1)).2 hrr.1.symm
      | [p], _, _ =>
        exact hnj r p Z (by rw [hr, TC.args_one' q p hA])
      | _ :: _ :: _, hlen, _ => simp at hlen
    · have hq : 2 ≤ (args q).length := by rw [args_app] at hlen; simp at hlen; omega
      obtain ⟨K, c, hK, hu⟩ := fib_step q Z _ d hq hZ hrr
      refine ⟨c, ⟨K, hK⟩, ?_⟩
      rw [hu]
      cases K with
      | zero => exact absurd hu (habove (r + 1)).2
      | succ K => exact fw_suf1 Z c K
  have hkeep : ∀ r c, Suf (app c Z) (u (r + 1)) → ∀ n, (∀ i, i < n → u (r + 1 + i) ≠ app c Z) →
      Suf (app c Z) (u (r + 1 + n)) := by
    intro r c h0 n
    induction n with
    | zero => intro _; simpa using h0
    | succ n ih =>
      intro hne
      have hn := ih (fun i hi => hne i (by omega))
      rw [show r + 1 + (n + 1) = r + 1 + n + 1 by omega]
      exact step_keeps _ _ _ (hchild (r + 1 + n)) hn (hne n (by omega)) (hnj (r + 1 + n))
  have hnextret : ∀ r q, u r = app q Z → ∃ r' c, r < r' ∧ TT q c ∧ u r' = app c Z := by
    intro r q hr
    obtain ⟨c, hT, hsuf⟩ := hstep r q hr
    obtain ⟨j, hj, q', hq'⟩ := hret (r + 1)
    have hmin : ∀ j, r + 1 ≤ j → (∃ q', u j = app q' Z) → ∃ j1, r + 1 ≤ j1 ∧ (∃ q', u j1 = app q' Z) ∧
        ∀ i, r + 1 ≤ i → i < j1 → ¬ ∃ q', u i = app q' Z := by
      intro j
      induction j using Nat.strongRecOn with
      | _ j ih =>
        intro hj hq
        by_cases hm : ∃ i, r + 1 ≤ i ∧ i < j ∧ ∃ q', u i = app q' Z
        · obtain ⟨i, hi1, hi2, hi3⟩ := hm
          exact ih i hi2 hi1 hi3
        · exact ⟨j, hj, hq, fun i hi1 hi2 hq' => hm ⟨i, hi1, hi2, hq'⟩⟩
    obtain ⟨j1, hj1, ⟨q1, hq1⟩, hfirst⟩ := hmin j hj ⟨q', hq'⟩
    have hk := hkeep r c hsuf (j1 - (r + 1))
      (fun i hi heq => hfirst (r + 1 + i) (by omega) (by omega) ⟨c, heq⟩)
    rw [show r + 1 + (j1 - (r + 1)) = j1 by omega, hq1] at hk
    rcases suf_app_inv _ _ _ hk with h | h
    · have hqc : q1 = c := (C.T.app.inj h).1
      exact ⟨j1, c, by omega, hT, by rw [hq1, hqc]⟩
    · exfalso
      have := suf_size _ _ h
      simp only [size] at this
      have := size_pos c
      omega
  have hnext' : ∀ (rq : Nat × T), ∃ rq' : Nat × T,
      u rq.1 = app rq.2 Z → (u rq'.1 = app rq'.2 Z ∧ TT rq.2 rq'.2) := by
    intro ⟨r, q⟩
    by_cases h : u r = app q Z
    · obtain ⟨r', c, _, hT, hu⟩ := hnextret r q h
      exact ⟨(r', c), fun _ => ⟨hu, hT⟩⟩
    · exact ⟨(r, q), fun h' => absurd h' h⟩
  obtain ⟨nx, hnx⟩ : ∃ nx : Nat × T → Nat × T, ∀ rq, u rq.1 = app rq.2 Z →
      (u (nx rq).1 = app (nx rq).2 Z ∧ TT rq.2 (nx rq).2) :=
    ⟨fun rq => Classical.choose (hnext' rq), fun rq => Classical.choose_spec (hnext' rq)⟩
  obtain ⟨r0, _, q0, hq0⟩ := hret 0
  have hsq : ∀ n, u (iter nx (r0, q0) n).1 = app (iter nx (r0, q0) n).2 Z := by
    intro n
    induction n with
    | zero => exact hq0
    | succ n ih => exact (hnx (iter nx (r0, q0) n) ih).1
  exact no_TT_chain (fun n => (iter nx (r0, q0) n).2) (fun n => (hnx _ (hsq n)).2)

end SA

#print axioms SA.no_scenarioA

/-! ## The reductions in their final form: finite halves from 'eventually monotone' -/

namespace EM

open C
open C.T

theorem decomp (u : T) (h : 3 ≤ (args u).length) :
    u = app (lchild u) (SA.rpart u) ∧ 2 ≤ (args (lchild u)).length := by
  cases u with
  | S => simp [args] at h
  | app f x =>
    refine ⟨rfl, ?_⟩
    simp only [lchild]
    rw [args_app] at h; simp at h; omega

/-- **Leftmost finite half from EM.**  If an infinite leftmost walk from an L36-flag-0 term were eventually monotone
    (from some j0 on every node has >= 3 arguments and no child is the node's last argument), we get a contradiction.
    So: Conjecture EM (every infinite leftmost walk is eventually monotone) implies that every flag-0 term — e.g. every
    term of the joint classes (14,28), (14,26) — has a finite leftmost path. -/
theorem finite_half_of_EM (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (hflag : FH.flag (u 0) = false)
    (hEM : ∃ j0, ∀ j, j0 ≤ j → 3 ≤ (args (u j)).length ∧ u (j + 1) ≠ SA.rpart (u j)) : False := by
  obtain ⟨j0, h⟩ := hEM
  exact FM.finite_half_monotone_all u hchild hflag j0 (fun j => lchild (u (j0 + j)))
    (fun j => SA.rpart (u (j0 + j)))
    (fun j => decomp _ (h (j0 + j) (by omega)).1)
    (fun j => (h (j0 + j) (by omega)).2)

/-- **Rightmost finite half from EM_R.**  If a rightmost walk from an R19-flag-0 term eventually has only nodes with
    >= 3 arguments, we get a contradiction.  So Conjecture EM_R implies R19's finite half. -/
theorem finite_half_right_of_EMR (u : Nat → C.T) (hchild : ∀ j, RR.RChildC (u j) (u (j + 1)))
    (hflag : RR.flagR (u 0) = false)
    (hEM : ∃ j0, ∀ j, j0 ≤ j → 3 ≤ (args (u j)).length) : False := by
  obtain ⟨j0, h⟩ := hEM
  exact RM.finite_half_right_monotone_all u hchild hflag j0 (fun j => lchild (u (j0 + j)))
    (fun j => SA.rpart (u (j0 + j)))
    (fun j => decomp _ (h (j0 + j) (by omega)))

end EM

#print axioms EM.finite_half_of_EM
#print axioms EM.finite_half_right_of_EMR

/-! ## Scenario A in depth form: the frozen fuel is a tower — SA2 -/

namespace SA2

open C
open C.T
open FM

/-- right-spine depth (number of multipliers) -/
def msl : T → Nat
  | S => 0
  | app _ x => msl x + 1

/-- the right-spine suffix of depth min k (msl t) -/
def dropTo (k : Nat) : T → T
  | S => S
  | app f x => if msl (app f x) ≤ k then app f x else dropTo k x

theorem dropTo_suf (k : Nat) : ∀ t, Suf (dropTo k t) t
  | S => Suf.refl
  | app f x => by
    unfold dropTo
    split
    · exact Suf.refl
    · exact Suf.wrap f x (dropTo_suf k x)

theorem msl_dropTo (k : Nat) : ∀ t, k ≤ msl t → msl (dropTo k t) = k
  | S, h => by simp [msl] at h; subst h; rfl
  | app f x, h => by
    unfold dropTo
    split
    · rename_i h1; exact Nat.le_antisymm h1 h
    · rename_i h1
      simp only [msl] at h h1
      exact msl_dropTo k x (by omega)

theorem dropTo_small (k : Nat) (t : T) (h : msl t ≤ k) : dropTo k t = t := by
  cases t with
  | S => rfl
  | app f x => unfold dropTo; simp [h]

theorem dropTo_big (k : Nat) (f x : T) (h : k < msl (app f x)) : dropTo k (app f x) = dropTo k x := by
  show (if msl (app f x) ≤ k then app f x else dropTo k x) = dropTo k x
  rw [if_neg (by omega)]

theorem msl_suf (B c : T) (h : Suf B c) : msl B ≤ msl c := by
  induction h with
  | refl => exact Nat.le_refl _
  | wrap p x _ ih => simp only [msl]; omega

theorem dropTo_suf_eq (k : Nat) (B c : T) (h : Suf B c) (hk : k ≤ msl B) : dropTo k c = dropTo k B := by
  induction h with
  | refl => rfl
  | wrap p x hs ih =>
    have := msl_suf _ _ hs
    rw [dropTo_big k p x (by simp only [msl]; omega)]
    exact ih

/-- **Theorem (Scenario A has a tower fuel).**  Let u be a jump-free infinite leftmost walk (no node with exactly two
    arguments) whose right-spine depth is always >= d >= 1 and equals d infinitely often.  Then the frozen part of
    depth d-1 (the 'fuel') is a tower S(S(...(S S))).  No flag hypothesis. -/
theorem scenarioA_tower (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1)))
    (hnj : ∀ j p τ, u j ≠ app (app S p) τ) (d : Nat) (hd : 1 ≤ d)
    (hlow : ∀ j, d ≤ msl (u j)) (hret : ∀ N, ∃ j, N ≤ j ∧ msl (u j) = d) :
    Tower (dropTo (d - 1) (u 0)) := by
  refine Classical.byContradiction (fun hZ => ?_)
  -- the part of depth d-1 is frozen
  have hfrozen : ∀ j, dropTo (d - 1) (u (j + 1)) = dropTo (d - 1) (u j) := by
    intro j
    have hl := hlow j
    have hl' := hlow (j + 1)
    have hc := hchild j
    match hu : u j with
    | S => rw [hu] at hl; simp [msl] at hl; omega
    | app A B =>
      rw [hu] at hc hl
      have hB : d - 1 ≤ msl B := by simp only [msl] at hl; omega
      rw [dropTo_big (d - 1) A B (by simp only [msl] at hl ⊢; omega)]
      rcases hc with ⟨hlen, rest, hr⟩ | ⟨hlen, dd, hr⟩
      · rw [args_app] at hlen hr
        match hA : args A, hlen, hr with
        | [], _, hr =>
          simp only [List.nil_append, List.cons.injEq] at hr
          rw [← hr.1]
        | [p], _, _ =>
          exact absurd (by rw [hu, TC.args_one' A p hA]) (hnj j p B)
        | _ :: _ :: _, hlen, _ => simp at hlen
      · rw [args_app] at hr hlen
        have hs := first_suf B (args A ++ [B]) _ ⟨args A, B, rfl, Suf.refl⟩ hlen hr _ _ rfl
        exact dropTo_suf_eq (d - 1) B _ hs hB
  have hconst : ∀ j, dropTo (d - 1) (u j) = dropTo (d - 1) (u 0) := by
    intro j
    induction j with
    | zero => rfl
    | succ j ih => rw [hfrozen j, ih]
  apply SA.no_scenarioA u hchild (dropTo (d - 1) (u 0)) hZ hnj
  · intro j
    refine ⟨by rw [← hconst j]; exact dropTo_suf _ _, fun h => ?_⟩
    have h1 := msl_dropTo (d - 1) (u 0) (by have := hlow 0; omega)
    have h2 := hlow j
    rw [h] at h2
    omega
  · intro N
    obtain ⟨j, hj, hmd⟩ := hret N
    refine ⟨j, hj, ?_⟩
    match hu : u j with
    | S => rw [hu] at hmd; simp [msl] at hmd; omega
    | app A B =>
      refine ⟨A, ?_⟩
      rw [← hconst j, hu, dropTo_big (d - 1) A B (by rw [hu] at hmd; simp only [msl] at hmd ⊢; omega),
        dropTo_small (d - 1) B (by rw [hu] at hmd; simp only [msl] at hmd; omega)]

end SA2

#print axioms SA2.scenarioA_tower

/-! ## Conjecture F (jump-free): tools — SA3 -/

namespace SA3

open C
open C.T
open FM

theorem step_len3 (L L' : List T) (h : step L = some L') : 3 ≤ L.length := by
  match L, h with
  | _ :: _ :: _ :: _, _ => simp
  | [], h => simp [step] at h
  | [_], h => simp [step] at h
  | [_, _], h => simp [step] at h

theorem reach_snoc (A B : List T) (z : T) (h : Reach A B) : Reach (A ++ [z]) (B ++ [z]) := by
  induction h with
  | refl => exact Reach.refl
  | tail _ hs ih => exact Reach.tail ih (step_append _ _ [z] (step_len3 _ _ hs) hs)

/-- the head run of q.z passes through args x0 ++ [z, c0.z], where H(q) = S x0 c0 -/
theorem after_wrap (q z ch dd x0 c0 : T) (h : Reach (args q ++ [z]) [ch, dd]) (hq : Reach (args q) [x0, c0])
    (hx0 : x0 ≠ S) : Reach (args x0 ++ [z, app c0 z]) [ch, dd] := by
  have h1 : Reach (args q ++ [z]) ([x0, c0] ++ [z]) := reach_snoc _ _ z hq
  have h2 : Reach (args q ++ [z]) (args x0 ++ [z, app c0 z]) := Reach.tail h1 rfl
  rcases RC.reach_linear _ _ _ h2 h with h3 | h3
  · exact h3
  · exfalso
    have e := reach_stuck _ _ (by simp) h3
    have hl := congrArg List.length e
    have := TC.args_ne_nil x0 hx0
    simp only [List.length_append, List.length_cons, List.length_nil] at hl
    omega

/-- if H(q) = S S c0 the leftmost child of q.z is z -/
theorem child_S (q z ch dd c0 : T) (h : Reach (args q ++ [z]) [ch, dd]) (hq : Reach (args q) [S, c0]) :
    ch = z := by
  have h1 : Reach (args q ++ [z]) ([S, c0] ++ [z]) := reach_snoc _ _ z hq
  have h2 : Reach (args q ++ [z]) [z, app c0 z] := Reach.tail h1 rfl
  have := RC.reach_det _ _ _ h h2 (by simp) (by simp)
  simp only [List.cons.injEq] at this
  exact this.1

theorem wh_c0 (Q z x c w : T) (h : OM.WH Q z x c w) :
    ∃ x0 c0, Reach (args Q) [x0, c0] ∧ ((w = z ∧ c = c0) ∨ Suf (app c0 z) w) := by
  induction h with
  | first x c hr => exact ⟨x, c, hr, Or.inl ⟨rfl, rfl⟩⟩
  | next x0' c0' w0 x c hH0 hr ih =>
    obtain ⟨x0, c0, hq, hc⟩ := ih
    refine ⟨x0, c0, hq, Or.inr ?_⟩
    rcases hc with ⟨hw, hcc⟩ | hs
    · rw [hw, hcc]; exact Suf.refl
    · exact Suf.wrap _ _ hs

/-- refined TT_strip: the third alternative is c1 = tw K' . tw K with tw K' a spine-wrap of z -/
theorem TT_strip2 (Q z W' : T) (K : Nat) (hQ : 2 ≤ (args Q).length) (h : Reach (args (app Q z)) [tw K, W']) :
    (z = tw K ∧ ∃ Y, R Q Y ∧ W' = app Y z) ∨ (z = S ∧ K = 1) ∨
    (∃ K', K = K' + 1 ∧ W' = app (tw K') (tw K) ∧ Suf z (tw K')) := by
  rw [args_app] at h
  rcases OM.cinv2_reach Q z hQ _ h with ⟨L1, _, hlen, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen, hEq⟩ |
      ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hr, hEq⟩
  · have := congrArg List.length hEq; simp at this <;> omega
  · have := congrArg List.length hEq; simp at this <;> omega
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hcw, hW', _⟩ := hEq
    cases K with
    | zero => simp [tw] at hcw
    | succ K =>
      simp only [tw, app.injEq] at hcw
      obtain ⟨hc, hw⟩ := hcw
      by_cases h2 : 2 ≤ (args x).length
      · rcases final_shape (args x) w S b h2 hP with ⟨hwS, _⟩ | hbig
        · right; left
          have hzS : z = S := suf_S z (by rw [hwS]; exact wh_suf _ _ _ _ _ hH)
          refine ⟨hzS, ?_⟩
          rw [← hw] at hwS
          cases K with
          | zero => rfl
          | succ K => simp [tw] at hwS
        · exfalso; simp [size] at hbig; have := size_pos w; omega
      · right; right
        have hl : (args x ++ [w]).length ≤ 2 := by simp; omega
        have e := reach_stuck _ _ hl hP
        match hax : args x, e with
        | [y], e =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
          refine ⟨K, rfl, ?_, ?_⟩
          · rw [hW', e.2.1, ← hc, ← hw]; rfl
          · rw [hw]; exact wh_suf _ _ _ _ _ hH
        | [], e => simp at e
        | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
  · simp only [List.cons.injEq] at hEq
    obtain ⟨hz, hW', _⟩ := hEq
    exact Or.inl ⟨hz.symm, y, hr, hW'⟩

theorem tw_child (K : Nat) (v : T) (h : FH.LChild (tw (K + 1)) v) : v = tw K := by
  have ha : args (tw (K + 1)) = [tw K] := by simp [tw, args]
  rcases h with ⟨_, rest, hr⟩ | ⟨hlen, _, _⟩
  · rw [ha] at hr
    simp only [List.cons.injEq] at hr
    exact hr.1.symm
  · rw [ha] at hlen; simp at hlen

theorem size_tw (m : Nat) : size (tw m) = m + 1 := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [tw, size, ih]; omega

theorem tw_inj (a b : Nat) (h : tw a = tw b) : a = b := by
  have := congrArg size h
  rw [size_tw, size_tw] at this
  omega

theorem fw_nontower (z c : T) (hz : ¬ Tower z) (i : Nat) : ¬ Tower (Fw z c i) :=
  suf_nontower _ _ (Fw_suf z c i) hz

theorem N_ne_SS (k : Nat) : RC.N (k + 1) ≠ app S S := by
  intro h
  have h1 : RC.N (k + 1) = app (app S S) (RC.N k) := rfl
  rw [h1] at h
  injection h with h2 h3
  cases h2

end SA3

/-! ## Conjecture F (jump-free): no Scenario A over a tower fuel other than S -/

namespace SA3

open C
open C.T
open FM

/-- **Theorem (Conjecture F for jump-free walks).**  No jump-free infinite leftmost walk (no node with exactly two
    arguments) keeps a tower tw (d+1) — i.e. any tower other than S — as a proper right-spine suffix of every node
    while returning infinitely often to nodes q.(tw (d+1)).  With SA.no_scenarioA: in Scenario A the fuel is S.
    No flag hypothesis.  Proof: every return step is an R2 step (d >= 1: an infinite R2-chain) or (d = 0, fuel S S)
    a fuel-S tail call with an excursion whose level counts down by R-steps to S S; by the reload classification the
    return multipliers end in N_i N_m, whose excursion counts down N_k . SS -> ... -> B . SS and gets stuck. -/
theorem no_scenarioA_tower (u : Nat → C.T) (hchild : ∀ j, FH.LChild (u j) (u (j + 1))) (d : Nat)
    (hnj : ∀ j p τ, u j ≠ app (app S p) τ)
    (habove : ∀ j, Suf (tw (d + 1)) (u j) ∧ u j ≠ tw (d + 1))
    (hret : ∀ N, ∃ j, N ≤ j ∧ ∃ q, u j = app q (tw (d + 1))) : False := by
  have hZS : tw (d + 1) ≠ S := by intro h; simp [tw] at h
  have hreach3 : ∀ t, 3 ≤ (args (u t)).length → ∃ dd, Reach (args (u t)) [u (t + 1), dd] := by
    intro t h3
    rcases hchild t with ⟨hlen, _, _⟩ | ⟨_, dd, hr⟩
    · omega
    · exact ⟨dd, hr⟩
  -- (alpha) a spine-wrap c.W of the next return node W is passed exactly
  have halpha : ∀ t0 r' c W, Suf (app c W) (u t0) → t0 ≤ r' → u r' = W → ∃ t, t0 ≤ t ∧ u t = app c W := by
    intro t0 r' c W hs ht hW
    refine Classical.byContradiction (fun hno => ?_)
    have hall : ∀ n, t0 + n ≤ r' → Suf (app c W) (u (t0 + n)) := by
      intro n
      induction n with
      | zero => intro _; simpa using hs
      | succ n ih =>
        intro hn
        have h1 := ih (by omega)
        have hne : u (t0 + n) ≠ app c W := fun h => hno ⟨t0 + n, by omega, h⟩
        rw [show t0 + (n + 1) = t0 + n + 1 by omega]
        exact SA.step_keeps _ _ _ (hchild (t0 + n)) h1 hne (hnj (t0 + n))
    have h2 := hall (r' - t0) (by omega)
    rw [show t0 + (r' - t0) = r' by omega, hW] at h2
    have h3 := suf_size _ _ h2
    simp only [size] at h3
    have := size_pos c
    omega
  -- (gamma) a top A.B over a non-tower bottom, B a non-tower, forces A to be a tower
  have hgamma : ∀ t A B σ, u t = app (app A B) σ → ¬ Tower σ → ¬ Tower B → ∃ K, A = tw (K + 1) := by
    intro t A B σ hu hσ hB
    have hA : A ≠ S := by intro h; rw [h] at hu; exact hnj t B σ hu
    have hA1 := TC.args_ne_nil A hA
    obtain ⟨dd, hr⟩ := hreach3 t (by rw [hu, args_app, args_app]; simp; omega)
    rw [hu] at hr
    obtain ⟨K, c, hK, _⟩ := fib_step (app A B) σ _ dd (by rw [args_app]; simp; omega) hσ hr
    rw [args_app] at hK
    by_cases h2 : 2 ≤ (args A).length
    · exfalso
      have hs := first_suf B (args A ++ [B]) _ ⟨args A, B, rfl, Suf.refl⟩ (by simp; omega) hK _ _ rfl
      exact suf_nontower B _ hs hB ⟨K, rfl⟩
    · have hl : (args A ++ [B]).length ≤ 2 := by simp; omega
      have e := reach_stuck _ _ hl hK
      match hax : args A, e with
      | [y], e =>
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at e
        exact ⟨K, by rw [TC.args_one' A y hax, ← e.1]; rfl⟩
      | [], e => simp at e
      | _ :: _ :: _, _ => rw [hax] at h2; simp at h2
  -- (beta) a node W.(X.W) before a return to W is impossible
  have hbeta : ∀ t r' W X, u t = app W (app X W) → u r' = W → 3 ≤ (args W).length → ¬ Tower (app X W) →
      False := by
    intro t r' W X hu hr' hW3 hXW
    obtain ⟨dd, hr⟩ := hreach3 t (by rw [hu, args_app]; simp; omega)
    rw [hu] at hr
    obtain ⟨K, c, hK, _⟩ := fib_step W (app X W) _ dd (by omega) hXW hr
    obtain ⟨dd', hr2⟩ := hreach3 r' (by rw [hr']; exact hW3)
    rw [hr'] at hr2
    have e := RC.reach_det _ _ _ hr2 hK (by simp) (by simp)
    simp only [List.cons.injEq] at e
    have hpop : ∀ i, i ≤ K → u (r' + 1 + i) = tw (K - i) := by
      intro i
      induction i with
      | zero => intro _; simpa using e.1
      | succ i ih =>
        intro hi
        have h1 := ih (by omega)
        have hc := hchild (r' + 1 + i)
        rw [h1, show K - i = (K - (i + 1)) + 1 by omega] at hc
        rw [show r' + 1 + (i + 1) = r' + 1 + i + 1 by omega]
        exact tw_child _ _ hc
    have hab := habove (r' + 1)
    rw [e.1] at hab
    have hsz := suf_size _ _ hab.1
    rw [size_tw, size_tw] at hsz
    have h4 := habove (r' + 1 + (K - (d + 1)))
    rw [hpop (K - (d + 1)) (by omega), show K - (K - (d + 1)) = d + 1 by omega] at h4
    exact h4.2 rfl
  -- the return structure: H(q) = S x0 c0 with x0 /= S, and the child is a spine-wrap of c0.Z
  have hR : ∀ r q, u r = app q (tw (d + 1)) → ∃ x0 c0, Reach (args q) [x0, c0] ∧ x0 ≠ S ∧
      Suf (app c0 (tw (d + 1))) (u (r + 1)) ∧ ∃ dd, Reach (args q ++ [tw (d + 1)]) [u (r + 1), dd] := by
    intro r q hr
    have hc := hchild r
    rw [hr] at hc
    rcases hc with ⟨hlen, rest, hrr⟩ | ⟨hlen, dd, hrr⟩
    · exfalso
      rw [args_app] at hlen hrr
      match hA : args q, hlen, hrr with
      | [], _, hrr =>
        simp only [List.nil_append, List.cons.injEq] at hrr
        exact (habove (r + 1)).2 hrr.1.symm
      | [p], _, _ =>
        exact hnj r p _ (by rw [hr, TC.args_one' q p hA])
      | _ :: _ :: _, hlen, _ => simp at hlen
    · rw [args_app] at hrr hlen
      have hq : 2 ≤ (args q).length := by simp at hlen; omega
      rcases OM.cinv2_reach q _ hq _ hrr with ⟨L1, _, hlen1, hEq⟩ | ⟨x, c1, w', P, _, _, _, hlen1, hEq⟩ |
          ⟨x, c, w, b, hx, hH, hP, hEq⟩ | ⟨y, hy, hEq⟩
      · exfalso; have := congrArg List.length hEq; simp at this <;> omega
      · exfalso; have := congrArg List.length hEq; simp at this <;> omega
      · simp only [List.cons.injEq] at hEq
        obtain ⟨hch, _, _⟩ := hEq
        obtain ⟨x0, c0, hq0, hcw⟩ := wh_c0 _ _ _ _ _ hH
        have hx0 : x0 ≠ S := by
          intro h0
          rw [h0] at hq0
          exact (habove (r + 1)).2 (child_S q _ _ dd c0 hrr hq0)
        refine ⟨x0, c0, hq0, hx0, ?_, dd, hrr⟩
        rw [hch]
        rcases hcw with ⟨hw, hcc⟩ | hs
        · rw [hw, hcc]; exact Suf.refl
        · exact Suf.wrap _ _ hs
      · exfalso
        simp only [List.cons.injEq] at hEq
        exact (habove (r + 1)).2 hEq.1
  -- the next return node is c0.Z
  have hnextret : ∀ r c0, Suf (app c0 (tw (d + 1))) (u (r + 1)) →
      ∃ r', r < r' ∧ u r' = app c0 (tw (d + 1)) := by
    intro r c0 hsuf
    obtain ⟨j, hj, q', hq'⟩ := hret (r + 1)
    have hmin : ∀ j, r + 1 ≤ j → (∃ q', u j = app q' (tw (d + 1))) → ∃ j1, r + 1 ≤ j1 ∧
        (∃ q', u j1 = app q' (tw (d + 1))) ∧ ∀ i, r + 1 ≤ i → i < j1 → ¬ ∃ q', u i = app q' (tw (d + 1)) := by
      intro j
      induction j using Nat.strongRecOn with
      | _ j ih =>
        intro hj hq
        by_cases hm : ∃ i, r + 1 ≤ i ∧ i < j ∧ ∃ q', u i = app q' (tw (d + 1))
        · obtain ⟨i, hi1, hi2, hi3⟩ := hm
          exact ih i hi2 hi1 hi3
        · exact ⟨j, hj, hq, fun i hi1 hi2 hq' => hm ⟨i, hi1, hi2, hq'⟩⟩
    obtain ⟨j1, hj1, ⟨q1, hq1⟩, hfirst⟩ := hmin j hj ⟨q', hq'⟩
    have hkeep : ∀ n, r + 1 + n ≤ j1 → Suf (app c0 (tw (d + 1))) (u (r + 1 + n)) := by
      intro n
      induction n with
      | zero => intro _; simpa using hsuf
      | succ n ih =>
        intro hn
        have h1 := ih (by omega)
        have hne : u (r + 1 + n) ≠ app c0 (tw (d + 1)) :=
          fun h => hfirst (r + 1 + n) (by omega) (by omega) ⟨c0, h⟩
        rw [show r + 1 + (n + 1) = r + 1 + n + 1 by omega]
        exact SA.step_keeps _ _ _ (hchild (r + 1 + n)) h1 hne (hnj (r + 1 + n))
    have hk := hkeep (j1 - (r + 1)) (by omega)
    rw [show r + 1 + (j1 - (r + 1)) = j1 by omega, hq1] at hk
    rcases suf_app_inv _ _ _ hk with h | h
    · exact ⟨j1, by omega, by rw [hq1, (C.T.app.inj h).1]⟩
    · exfalso
      have h2 := suf_size _ _ h
      simp only [size] at h2
      have := size_pos c0
      omega
  -- a return multiplier has >= 2 arguments
  have hc0args : ∀ r' c0, u r' = app c0 (tw (d + 1)) → 2 ≤ (args c0).length := by
    intro r' c0 hr'
    have hc := hchild r'
    rw [hr'] at hc
    by_cases h2 : 2 ≤ (args c0).length
    · exact h2
    · exfalso
      rcases hc with ⟨hlen, rest, hrr⟩ | ⟨hlen, _, _⟩
      · rw [args_app] at hrr
        match hA : args c0, hrr with
        | [], hrr =>
          simp only [List.nil_append, List.cons.injEq] at hrr
          exact (habove (r' + 1)).2 hrr.1.symm
        | [p], _ => exact hnj r' p _ (by rw [hr', TC.args_one' c0 p hA])
        | _ :: _ :: _, _ => rw [hA] at h2; simp at h2
      · rw [args_app] at hlen; simp at hlen; omega
  -- Claim E: each return step is an R2 step, or (d = 0) an excursion headed by Y.(S S) with H(x0) = S S Y
  have hE : ∀ r q, u r = app q (tw (d + 1)) → ∃ x0 c0 r', Reach (args q) [x0, c0] ∧ r < r' ∧
      u r' = app c0 (tw (d + 1)) ∧ (x0 = app S S ∨ (d = 0 ∧ ∃ Y, R x0 Y ∧
        u (r + 1) = app (app Y (tw 1)) (app c0 (tw (d + 1))))) := by
    intro r q hr
    obtain ⟨x0, c0, hq0, hx0, hsuf, dd, hrr⟩ := hR r q hr
    obtain ⟨r', hrr', hu'⟩ := hnextret r c0 hsuf
    have hc0 := hc0args r' c0 hu'
    refine ⟨x0, c0, r', hq0, hrr', hu', ?_⟩
    have hWnt : ¬ Tower (app c0 (tw (d + 1))) := by
      intro ⟨k, hk⟩
      cases k with
      | zero => simp [tw] at hk
      | succ k =>
        simp only [tw, app.injEq] at hk
        rw [hk.1] at hc0
        simp [args] at hc0
    have hW3 : 3 ≤ (args (app c0 (tw (d + 1)))).length := by rw [args_app]; simp; omega
    have hwrap := after_wrap q _ _ dd x0 c0 hrr hq0 hx0
    have hrw : Reach (args (app (app x0 (tw (d + 1))) (app c0 (tw (d + 1))))) [u (r + 1), dd] := by
