theorem clsLft_lt : ∀ t : Tm, clsLft t < 36
  | S => by simp [clsLft]
  | app f x => by
    have h := kRLft
    simp only [checkRLft, RNLft, List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
    exact h _ (clsLft_lt f) _ (clsLft_lt x)

theorem clsLft_args : ∀ t : Tm, clsLft t = clsLLft (args t)
  | S => by simp [clsLft, clsLLft, args]
  | app f x => by
    simp only [clsLft, clsLLft, args, List.foldl_append, List.foldl]
    rw [clsLft_args f]; rfl

theorem clsLLft_step (L L' : List Tm) (h : step L = some L') : clsLLft L = clsLLft L' := by
  match L, h with
  | a :: b :: c :: R, h =>
    simp only [step, Option.some.injEq] at h
    subst h
    simp only [clsLLft, List.foldl_append, List.foldl]
    have e : (args a).foldl (fun acc t => mulLft acc (clsLft t)) 0 = clsLft a := (clsLft_args a).symm
    have hk := kSLft
    simp only [checkSLft, RNLft, List.all_eq_true, List.mem_range, beq_iff_eq] at hk
    rw [e, hk _ (clsLft_lt a) _ (clsLft_lt b) _ (clsLft_lt c)]
    rfl

theorem clsLLft_run : ∀ (n : Nat) (L L' : List Tm), run n L = some L' → clsLLft L = clsLLft L'
  | 0, L, L', h => by simp [run] at h; subst h; rfl
  | n + 1, L, L', h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 => rw [hs] at h; exact (clsLLft_step L L1 hs).trans (clsLLft_run n L1 L' h)

theorem jointLft_term : ∀ t : Tm, (clsLft t, cls t) ∈ JLft
  | S => by
    have h := kJLft
    simp only [checkJLft, Bool.and_eq_true, List.contains_iff_mem] at h
    exact h.1.1
  | app f x => by
    have h := kJLft
    simp only [checkJLft, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem] at h
    exact h.1.2 _ (jointLft_term f) _ (jointLft_term x)

theorem jointLft_list : ∀ (L : List Tm) (acc : Nat × Nat), acc ∈ JLft →
    (L.foldl (fun a t => mulLft a (clsLft t)) acc.1, L.foldl (fun a t => mul a (cls t)) acc.2) ∈ JLft
  | [], acc, h => by simpa using h
  | t :: L, acc, h => by
    simp only [List.foldl]
    have hk := kJLft
    simp only [checkJLft, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem] at hk
    exact jointLft_list L (mulLft acc.1 (clsLft t), mul acc.2 (cls t)) (hk.1.2 _ h _ (jointLft_term t))

theorem flagLft_F (L : List Tm) (h : flagLft (clsLLft L) = true) : isF (clsL L) = true := by
  have hk := kJLft
  simp only [checkJLft, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem, Bool.or_eq_true,
    Bool.not_eq_true'] at hk
  have hm := jointLft_list L (0, 0) hk.1.1
  rcases hk.2 _ hm with h1 | h1
  · exact absurd h (by simp only [clsLLft] at h1 ⊢; rw [h1]; decide)
  · exact h1

/-- the leftmost Böhm-tree path has at least d further nodes, each with a head normal form -/
def InfLft : Nat → List Tm → Prop
  | 0, _ => True
  | d + 1, L => ∃ n L', run n L = some L' ∧ L'.length ≤ 2 ∧ ∃ x rest, L' = x :: rest ∧ InfLft d (args x)

theorem infLft_aux : ∀ (d : Nat) (L : List Tm), flagLft (clsLLft L) = true → InfLft d L
  | 0, _, _ => trivial
  | d + 1, L, h => by
    obtain ⟨n, L', hr, hl⟩ := hnfF L (flagLft_F L h)
    have hc : clsLLft L' = clsLLft L := (clsLLft_run n L L' hr).symm
    rw [← hc] at h
    have hk := kCLft
    simp only [checkCLft, Bool.and_eq_true, List.all_eq_true, List.mem_range, beq_iff_eq, RNLft,
      Bool.not_eq_true'] at hk
    obtain ⟨⟨h0, h1⟩, h2⟩ := hk
    refine ⟨n, L', hr, hl, ?_⟩
    match L', hl with
    | [], _ => simp only [clsLLft, List.foldl] at h; rw [h0] at h; exact absurd h (by decide)
    | [x], _ =>
      simp only [clsLLft, List.foldl] at h
      have hx : flagLft (clsLLft (args x)) = true := by rw [← clsLft_args, ← h1 _ (clsLft_lt x)]; exact h
      exact ⟨x, [], rfl, infLft_aux d (args x) hx⟩
    | [x, y], _ =>
      simp only [clsLLft, List.foldl] at h
      have hz := h2 _ (clsLft_lt x) _ (clsLft_lt y)
      rw [h] at hz
      have hx : flagLft (clsLLft (args x)) = true := by rw [← clsLft_args]; exact hz.symm
      exact ⟨x, [y], rfl, infLft_aux d (args x) hx⟩

/-- Proposition Q'' (leftmost path): if the Lft class of t is flagged, the leftmost path of BT(t) is infinite. -/
theorem propQ2Lft (t : Tm) (h : flagLft (clsLft t) = true) : ∀ d, InfLft d (args t) :=
  fun d => infLft_aux d (args t) (by rw [← clsLft_args]; exact h)

