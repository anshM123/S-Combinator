      | _ :: _ :: _, h1 => simp at h1
  -- the sequence of returns
  have hnext' : ∀ (rq : Nat × T), ∃ rq' : Nat × T, u rq.1 = app rq.2 (tw (d + 1)) →
      (u rq'.1 = app rq'.2 (tw (d + 1)) ∧ rq.1 < rq'.1 ∧ ∃ x0, Reach (args rq.2) [x0, rq'.2] ∧
