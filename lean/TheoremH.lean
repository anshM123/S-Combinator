inductive T where
  | S : T
  | var : Nat → T
  | app : T → T → T
deriving DecidableEq, Repr

open T

def args : T → List T
  | S => []
  | var _ => []
  | app f x => args f ++ [x]

def head : T → T
  | S => S
  | var n => var n
  | app f _ => head f

def step : List T → Option (List T)
  | a :: b :: c :: R => if head a = S then some (args a ++ c :: app b c :: R) else none
  | _ => none

def run : Nat → List T → Option (List T)
  | 0, L => some L
  | k + 1, L => match step L with
    | some L' => run k L'
    | none => none

/-- atom-free -/
def nv : T → Bool
  | S => true
  | var _ => false
  | app f x => nv f && nv x

def TAB : Nat := 
def mul (a b : Nat) : Nat := (TAB / 35 ^ (35 * a + b)) % 35
def FMASK : Nat := 25769803775
def isF (k : Nat) : Bool := (FMASK / 2 ^ k) % 2 == 1

def checkS : Bool := (List.range 35).all fun x => (List.range 35).all fun y => (List.range 35).all fun z =>
  mul (mul (mul 0 x) y) z == mul (mul x z) (mul y z)
set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem checkS_true : checkS = true := by decide +kernel

def checkRange : Bool := (List.range 35).all fun x => (List.range 35).all fun y => mul x y < 35
set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem checkRange_true : checkRange = true := by decide +kernel

def checkH : Bool := isF 0 && (List.range 35).all (fun x => isF (mul 0 x)) &&
  (List.range 35).all fun x => (List.range 35).all fun y => isF (mul (mul 0 x) y)
set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem checkH_true : checkH = true := by decide +kernel

theorem mul_lt (a b : Nat) (ha : a < 35) (hb : b < 35) : mul a b < 35 := by
  have h := checkRange_true
  simp only [checkRange, List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
  exact h a ha b hb

theorem s_identity (x y z : Nat) (hx : x < 35) (hy : y < 35) (hz : z < 35) :
    mul (mul (mul 0 x) y) z = mul (mul x z) (mul y z) := by
  have h := checkS_true
  simp only [checkS, List.all_eq_true, List.mem_range, beq_iff_eq] at h
  exact h x hx y hy z hz

/-- the polynomial of a term on M35 under an assignment of classes to atoms -/
def clsv (ρ : Nat → Nat) : T → Nat
  | S => 0
  | var n => ρ n
  | app f x => mul (clsv ρ f) (clsv ρ x)

def clsvL (ρ : Nat → Nat) (L : List T) : Nat := L.foldl (fun acc t => mul acc (clsv ρ t)) 0

def Valid (ρ : Nat → Nat) : Prop := ∀ k, ρ k < 35

theorem clsv_lt (ρ : Nat → Nat) (hρ : Valid ρ) : ∀ t : T, clsv ρ t < 35
  | S => by simp [clsv]
  | var n => hρ n
  | app f x => mul_lt _ _ (clsv_lt ρ hρ f) (clsv_lt ρ hρ x)

theorem foldl_lt (ρ : Nat → Nat) (hρ : Valid ρ) : ∀ (L : List T) (acc : Nat), acc < 35 →
    L.foldl (fun acc t => mul acc (clsv ρ t)) acc < 35
  | [], acc, h => h
  | t :: L, acc, h => foldl_lt ρ hρ L _ (mul_lt _ _ h (clsv_lt ρ hρ t))

theorem clsv_args (ρ : Nat → Nat) : ∀ t : T, head t = S → clsv ρ t = (args t).foldl (fun acc t => mul acc (clsv ρ t)) 0
  | S, _ => rfl
  | var n, h => by simp [head] at h
  | app f x, h => by
    simp only [head] at h
    simp only [clsv, args, List.foldl_append, List.foldl]
    rw [clsv_args ρ f h]

/-- a head step preserves the polynomial, for every assignment -/
theorem clsvL_step (ρ : Nat → Nat) (hρ : Valid ρ) (L L' : List T) (h : step L = some L') : clsvL ρ L = clsvL ρ L' := by
  match L, h with
  | a :: b :: c :: R, h =>
    simp only [step] at h
    split at h
    · rename_i ha
      simp only [Option.some.injEq] at h
      subst h
      simp only [clsvL, List.foldl_append, List.foldl]
      rw [← clsv_args ρ a ha, s_identity _ _ _ (clsv_lt ρ hρ a) (clsv_lt ρ hρ b) (clsv_lt ρ hρ c)]
      rfl
    · simp at h

/-- **Theorem H(b).** A symbolic run that never opens a variable preserves the polynomial on M35. -/
theorem thH_b (ρ : Nat → Nat) (hρ : Valid ρ) : ∀ (n : Nat) (L L' : List T), run n L = some L' → clsvL ρ L = clsvL ρ L'
  | 0, L, L', h => by simp [run] at h; subst h; rfl
  | n + 1, L, L', h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 => rw [hs] at h; exact (clsvL_step ρ hρ L L1 hs).trans (thH_b ρ hρ n L1 L' h)

/-- **Theorem H(a).** If the symbolic run reaches a head normal form without opening a variable, the polynomial lies in
    F for every assignment. -/
theorem thH_a (L L' : List T) (n : Nat) (hr : run n L = some L') (hl : L'.length ≤ 2) (ρ : Nat → Nat) (hρ : Valid ρ) :
    isF (clsvL ρ L) = true := by
  rw [thH_b ρ hρ n L L' hr]
  have hk := checkH_true
  simp only [checkH, Bool.and_eq_true, List.all_eq_true, List.mem_range] at hk
  obtain ⟨⟨h0, h1⟩, h2⟩ := hk
  match L', hl with
  | [], _ => simpa [clsvL] using h0
  | [x], _ => simpa [clsvL] using h1 _ (clsv_lt ρ hρ x)
  | [x, y], _ => simpa [clsvL] using h2 _ (clsv_lt ρ hρ x) _ (clsv_lt ρ hρ y)

theorem clsv_closed (ρ ρ' : Nat → Nat) : ∀ t : T, nv t = true → clsv ρ t = clsv ρ' t
  | S, _ => rfl
  | var n, h => by simp [nv] at h
  | app f x, h => by
    simp only [nv, Bool.and_eq_true] at h
    simp only [clsv, clsv_closed ρ ρ' f h.1, clsv_closed ρ ρ' x h.2]

