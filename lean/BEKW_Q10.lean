def GT : List Nat := [0, , , , , 221360928936055016515, , , , 13, 221360928936055016525, 221360928936055016644, , 221360928936055016524, , , , 0, 13, 0, 12, 192, 0, 3, 0, , 0, 13, 0, 12, 12, 0, 12, 0, 0]
def gidx (a b c : Nat) : Nat := ((GT.getD a 0) >>> (4 * (35 * b + c))) % 16

def R35 : List Nat := List.range 35

def checkNoS : Bool := R35.all fun a => R35.all fun b => mul a b != 0
def checkAbsorb : Bool := R35.all fun a => R35.all fun b => !isF (mul a b) || isF a
def checkRank : Bool := R35.all fun a => R35.all fun b =>
  !isF a || (if mul a b == a then (a == 12 && b == 0) else decide (rank (mul a b) < rank a))
def checkPre : Bool := (R35.all fun x => R35.all fun y => isPre (mul (mul 0 x) y)) &&
  (R35.all fun p => R35.all fun e => !isPre p || isPre (mul p e))
def checkSX : Bool := R35.all fun x => (SXL.getD (mul 0 x) []).contains x
def checkDEC : Bool := R35.all fun a2 => R35.all fun b2 => b2 == 0 || (DECL.getD (mul (mul 0 a2) b2) []).contains (a2, b2)
def checkG : Bool := R35.all fun a => R35.all fun b => R35.all fun c =>
  !isF (mul (mul (mul 0 a) b) c) ||
  (((SXL.getD a []).all fun x => (x == a && c == b && mul b c == c) || decide (gidx x c (mul b c) < gidx a b c)) &&
   (a == 0 || !isPre a || (DECL.getD (mul a c) []).all fun d => decide (gidx d.1 d.2 (mul b c) < gidx a b c)))

