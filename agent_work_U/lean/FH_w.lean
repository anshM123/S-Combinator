/-! ### facts extracted from the checks -/

theorem noS (a b : Nat) (ha : a < 35) (hb : b < 35) : mul a b ≠ 0 := by
  have h := k1
  simp only [checkNoS, R35, List.all_eq_true, List.mem_range, bne_iff_ne, ne_eq] at h
  exact h a ha b hb

theorem absorbF (a b : Nat) (ha : a < 35) (hb : b < 35) (h : isF (mul a b) = true) : isF a = true := by
  have hk := k2
  simp only [checkAbsorb, R35, List.all_eq_true, List.mem_range, Bool.or_eq_true, Bool.not_eq_true'] at hk
  rcases hk a ha b hb with h1 | h1
  · rw [h] at h1; exact absurd h1 (by decide)
  · exact h1

theorem rank_fact (a b : Nat) (ha : a < 35) (hb : b < 35) (hF : isF a = true) :
    (mul a b = a → a = 12 ∧ b = 0) ∧ (mul a b ≠ a → rank (mul a b) < rank a) := by
  have hk := k3
  simp only [checkRank, R35, List.all_eq_true, List.mem_range] at hk
  have h := hk a ha b hb
  rw [hF] at h
  by_cases he : mul a b = a
  · have : (mul a b == a) = true := by simp [he]
    rw [this] at h
    simp at h
    exact ⟨fun _ => h, fun hne => absurd he hne⟩
  · have : (mul a b == a) = false := by simp [he]
    rw [this] at h
    simp at h
    exact ⟨fun h' => absurd h' he, fun _ => h⟩

theorem rank_le8 (k : Nat) : rank k ≤ 8 := by
  have hs : ∀ i < 35, rankT.getD i 0 ≤ 8 := by decide
  unfold rank
  split
  · exact hs k (by assumption)
  · omega

theorem pre_base (x y : Nat) (hx : x < 35) (hy : y < 35) : isPre (mul (mul 0 x) y) = true := by
  have hk := k4
  simp only [checkPre, R35, Bool.and_eq_true, List.all_eq_true, List.mem_range] at hk
  exact hk.1 x hx y hy

theorem pre_step (p e : Nat) (hp : p < 35) (he : e < 35) (h : isPre p = true) : isPre (mul p e) = true := by
  have hk := k4
  simp only [checkPre, R35, Bool.and_eq_true, List.all_eq_true, List.mem_range, Bool.or_eq_true,
    Bool.not_eq_true'] at hk
  rcases hk.2 p hp e he with h1 | h1
  · rw [h] at h1; exact absurd h1 (by decide)
  · exact h1

theorem sx_mem (x : Nat) (hx : x < 35) : x ∈ SXL.getD (mul 0 x) [] := by
  have hk := k5
  simp only [checkSX, R35, List.all_eq_true, List.mem_range, List.contains_iff_mem] at hk
  exact hk x hx

theorem dec_mem (a2 b2 : Nat) (ha : a2 < 35) (hb : b2 < 35) (h0 : b2 ≠ 0) :
    (a2, b2) ∈ DECL.getD (mul (mul 0 a2) b2) [] := by
  have hk := k6
  simp only [checkDEC, R35, List.all_eq_true, List.mem_range, Bool.or_eq_true, beq_iff_eq,
    List.contains_iff_mem] at hk
  rcases hk a2 ha b2 hb with h1 | h1
  · exact absurd h1 h0
  · exact h1

theorem g_peel (a b c x : Nat) (ha : a < 35) (hb : b < 35) (hc : c < 35)
    (hF : isF (mul (mul (mul 0 a) b) c) = true) (hx : x ∈ SXL.getD a []) :
    (x = a ∧ c = b ∧ mul b c = c) ∨ gidx x c (mul b c) < gidx a b c := by
  have hk := k7
  simp only [checkG, R35, List.all_eq_true, List.mem_range, Bool.or_eq_true, Bool.not_eq_true',
    Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hk
  rcases hk a ha b hb c hc with h1 | ⟨h1, _⟩
  · rw [hF] at h1; exact absurd h1 (by decide)
  · rcases h1 x hx with ⟨⟨e1, e2⟩, e3⟩ | h2
    · exact Or.inl ⟨e1, e2, e3⟩
    · exact Or.inr h2

theorem g_refill (a b c : Nat) (ha : a < 35) (hb : b < 35) (hc : c < 35)
    (hF : isF (mul (mul (mul 0 a) b) c) = true) (ha0 : a ≠ 0) (hpre : isPre a = true)
    (d : Nat × Nat) (hd : d ∈ DECL.getD (mul a c) []) : gidx d.1 d.2 (mul b c) < gidx a b c := by
  have hk := k7
  simp only [checkG, R35, List.all_eq_true, List.mem_range, Bool.or_eq_true, Bool.not_eq_true',
    Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hk
  rcases hk a ha b hb c hc with h1 | ⟨_, h2⟩
  · rw [hF] at h1; exact absurd h1 (by decide)
  · rcases h2 with (h3 | h3) | h3
    · exact absurd h3 ha0
    · rw [hpre] at h3; exact absurd h3 (by decide)
    · exact h3 d hd


/-! ### head-machine helpers -/

def tsize : Tm → Nat
  | S => 1
  | app f x => tsize f + tsize x

def sizeL (L : List Tm) : Nat := (L.map tsize).sum

theorem tsize_pos (t : Tm) : 0 < tsize t := by
  cases t with
  | S => simp [tsize]
  | app f x => have := tsize_pos f; simp [tsize]; omega

theorem sizeL_lt (L0 : List Tm) (e : Tm) : sizeL L0 < sizeL (L0 ++ [e]) := by
  simp [sizeL]; exact tsize_pos e

theorem step_append (L L' R : List Tm) (h : step L = some L') : step (L ++ R) = some (L' ++ R) := by
  match L, h with
  | a :: b :: c :: T0, h =>
    simp only [step, Option.some.injEq] at h
    subst h; simp [step]

theorem run_append : ∀ (n : Nat) (L L' R : List Tm), run n L = some L' → run n (L ++ R) = some (L' ++ R)
  | 0, L, L', R, h => by simp [run] at h; subst h; rfl
  | n + 1, L, L', R, h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 => rw [hs] at h; simp only [run, step_append L L1 R hs]; exact run_append n L1 L' R h

theorem run_add : ∀ (m n : Nat) (L L' : List Tm), run m L = some L' → run (m + n) L = run n L'
  | 0, n, L, L', h => by simp [run] at h; subst h; simp
  | m + 1, n, L, L', h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 =>
      rw [hs] at h
      rw [show m + 1 + n = (m + n) + 1 by omega]
      simp only [run, hs]; exact run_add m n L1 L' h

theorem run_form : ∀ (n : Nat) (L L' : List Tm), run (n + 1) L = some L' →
    ∃ a b c R, L' = args a ++ c :: app b c :: R
  | 0, L, L', h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 =>
      rw [hs] at h; simp [run] at h; subst h
      match L, hs with
      | a :: b :: c :: R, hs => simp only [step, Option.some.injEq] at hs; exact ⟨a, b, c, R, hs.symm⟩
  | n + 1, L, L', h => by
    simp only [run] at h
    cases hs : step L with
    | none => rw [hs] at h; simp at h
    | some L1 => rw [hs] at h; exact run_form n L1 L' h

theorem run_two (x v : Tm) (n : Nat) (L : List Tm) (h : run n [x, v] = some L) : L = [x, v] := by
  cases n with
  | zero => simp [run] at h; exact h.symm
  | succ n => simp [run, step] at h

theorem cls_app_ne (f x : Tm) : cls (app f x) ≠ 0 := noS _ _ (cls_lt f) (cls_lt x)

theorem clsL_app_last (L0 : List Tm) (e : Tm) : clsL (L0 ++ [e]) = mul (clsL L0) (cls e) := by
  simp [clsL, List.foldl_append]

theorem isPre_foldl : ∀ (R : List Tm) (acc : Nat), acc < 35 → isPre acc = true →
    isPre (R.foldl (fun a t => mul a (cls t)) acc) = true
  | [], acc, _, h => h
  | t :: R, acc, hl, h => by
    simp only [List.foldl]
    apply isPre_foldl R
    · have hr := checkRange_true
      simp only [checkRange, List.all_eq_true, List.mem_range, decide_eq_true_eq] at hr
      exact hr _ hl _ (cls_lt t)
    · exact pre_step acc (cls t) hl (cls_lt t) h

theorem isPre_args (p : Tm) (h : 2 ≤ (args p).length) : isPre (cls p) = true := by
  rw [cls_args]
  match hp : args p, h with
  | a1 :: a2 :: R, _ =>
    simp only [clsL, List.foldl]
    have hr := checkRange_true
    simp only [checkRange, List.all_eq_true, List.mem_range, decide_eq_true_eq] at hr
    apply isPre_foldl R
    · exact hr _ (hr _ (by decide) _ (cls_lt a1)) _ (cls_lt a2)
    · exact pre_base _ _ (cls_lt a1) (cls_lt a2)

theorem clsL3 (p q v : Tm) : clsL [p, q, v] = mul (mul (cls p) (cls v)) (mul (cls q) (cls v)) :=
  s_identity _ _ _ (cls_lt p) (cls_lt q) (cls_lt v)

theorem lex_left {a a' : Nat} (b c d b' c' d' : Nat) (h : a < a') :
    Prod.Lex (· < ·) (Prod.Lex (· < ·) (Prod.Lex (· < ·) (· < ·))) (a, b, c, d) (a', b', c', d') :=
  Prod.Lex.left _ _ h

theorem run_succ (n : Nat) (L L' : List Tm) (h : step L = some L') : run (n + 1) L = run n L' := by
  simp [run, h]

abbrev LexR := Prod.Lex (fun a₁ a₂ : Nat => a₁ < a₂)
  (Prod.Lex (fun a₁ a₂ : Nat => a₁ < a₂) (Prod.Lex (fun a₁ a₂ : Nat => a₁ < a₂) fun a₁ a₂ : Nat => a₁ < a₂))

theorem lex1 {a a' b b' c c' d d' : Nat} (h : a < a') : LexR (a, b, c, d) (a', b', c', d') := Prod.Lex.left _ _ h
theorem lex2 {a a' b b' c c' d d' : Nat} (h1 : a = a') (h : b < b') : LexR (a, b, c, d) (a', b', c', d') := by
  subst h1; exact Prod.Lex.right _ (Prod.Lex.left _ _ h)
theorem lex3 {a a' b b' c c' d d' : Nat} (h1 : a = a') (h2 : b = b') (h : c < c') : LexR (a, b, c, d) (a', b', c', d') := by
  subst h1; subst h2; exact Prod.Lex.right _ (Prod.Lex.right _ (Prod.Lex.left _ _ h))
theorem lex4 {a a' b b' c c' d d' : Nat} (h1 : a = a') (h2 : b = b') (h3 : c = c') (h : d < d') :
    LexR (a, b, c, d) (a', b', c', d') := by
  subst h1; subst h2; subst h3; exact Prod.Lex.right _ (Prod.Lex.right _ (Prod.Lex.right _ h))

theorem mul_lt (a b : Nat) (ha : a < 35) (hb : b < 35) : mul a b < 35 := by
  have hr := checkRange_true
  simp only [checkRange, List.all_eq_true, List.mem_range, decide_eq_true_eq] at hr
  exact hr _ ha _ hb

mutual
theorem hnfF (L : List Tm) (hF : isF (clsL L) = true) : ∃ n L', run n L = some L' ∧ L'.length ≤ 2 := by
  rcases Nat.lt_or_ge 2 L.length with hlen | hlen
  · obtain ⟨L0, e, rfl⟩ : ∃ L0 e, L = L0 ++ [e] :=
      ⟨L.dropLast, L.getLast (by intro h; simp [h] at hlen), (List.dropLast_concat_getLast _).symm⟩
    have hcl : clsL (L0 ++ [e]) = mul (clsL L0) (cls e) := clsL_app_last L0 e
    have h0F : isF (clsL L0) = true := absorbF _ _ (clsL_lt L0) (cls_lt e) (by rw [← hcl]; exact hF)
    have hrk := rank_fact (clsL L0) (cls e) (clsL_lt L0) (cls_lt e) h0F
    have hsz := sizeL_lt L0 e
    have h8 := rank_le8 (clsL L0)
    obtain ⟨n0, L1, h0, hs0⟩ := hnfF L0 h0F
    have hr := run_append n0 L0 L1 [e] h0
    have hcls1 : clsL (L1 ++ [e]) = clsL (L0 ++ [e]) := (clsL_run n0 _ _ hr).symm
    match L1, hs0, hr, hcls1 with
    | [], _, hr, _ => exact ⟨n0, [e], hr, by simp⟩
    | [p], _, hr, _ => exact ⟨n0, [p, e], hr, by simp⟩
    | [p, q], _, hr, hcls1 =>
      have hcl3 : clsL [p, q, e] = clsL (L0 ++ [e]) := hcls1
      have hcF : isF (clsL [p, q, e]) = true := by rw [hcl3]; exact hF
      obtain ⟨n1, L2, h2, hs2⟩ := chainF p q e hcF
      exact ⟨n0 + n1, L2, by rw [run_add n0 n1 _ _ hr]; exact h2, hs2⟩
    | _ :: _ :: _ :: _, hs0, _, _ => simp at hs0
  · exact ⟨0, L, rfl, hlen⟩
termination_by (8 - rank (clsL L), 1, sizeL L, 0)
decreasing_by
  · subst_vars
    by_cases hloop : mul (clsL L0) (cls e) = clsL L0
    · exact lex3 (by rw [hcl, hloop]) rfl hsz
    · apply lex1
      have := hrk.2 hloop
      rw [hcl]; omega
  · subst_vars
    exact lex2 (by rw [hcl3]) (by decide)

theorem chainF (p q v : Tm) (hF : isF (clsL [p, q, v]) = true) :
    ∃ n L', run n [p, q, v] = some L' ∧ L'.length ≤ 2 := by
  match p with
  | S => exact ⟨1, [v, app q v], by simp [run, step, args], by simp⟩
  | app S x =>
    have hs : step [app S x, q, v] = some [x, v, app q v] := by simp [step, args]
    have hF' : isF (clsL [x, v, app q v]) = true := by rw [← clsL_step _ _ hs]; exact hF
    have hcx : clsL [x, v, app q v] = clsL [app S x, q, v] := (clsL_step _ _ hs).symm
    have hgp := g_peel (cls (app S x)) (cls q) (cls v) (cls x) (cls_lt _) (cls_lt q) (cls_lt v) hF
      (sx_mem (cls x) (cls_lt x))
    have hts : tsize x < tsize (app S x) := by simp [tsize]
    obtain ⟨n, L', h, hl⟩ := chainF x v (app q v) hF'
    exact ⟨n + 1, L', by simp only [run, hs]; exact h, hl⟩
  | app (app f y) x =>
    have hlen : 2 ≤ (args (app (app f y) x)).length := by simp [args]
    have hs : step [app (app f y) x, q, v] = some ((args (app (app f y) x) ++ [v]) ++ [app q v]) := by
      simp [step]
    have hc3 := clsL3 (app (app f y) x) q v
    have hPv : clsL (args (app (app f y) x) ++ [v]) = mul (cls (app (app f y) x)) (cls v) := by
      rw [clsL_app_last, ← cls_args]
    have hlt := mul_lt _ _ (cls_lt (app (app f y) x)) (cls_lt v)
    have hqv := mul_lt _ _ (cls_lt q) (cls_lt v)
    have hPvF : isF (clsL (args (app (app f y) x) ++ [v])) = true := by
      rw [hPv]; exact absorbF _ _ hlt hqv (by rw [← hc3]; exact hF)
    have hne : mul (cls q) (cls v) ≠ 0 := noS _ _ (cls_lt q) (cls_lt v)
    have hrk2 := rank_fact (mul (cls (app (app f y) x)) (cls v)) (mul (cls q) (cls v)) hlt hqv
      (by rw [← hPv]; exact hPvF)
    have hstrict : rank (clsL [app (app f y) x, q, v]) < rank (clsL (args (app (app f y) x) ++ [v])) := by
      rw [hc3, hPv]; apply hrk2.2; intro h; exact hne (hrk2.1 h).2
    have h8 := rank_le8 (clsL (args (app (app f y) x) ++ [v]))
    obtain ⟨n1, L3, h3, hs3⟩ := hnfF (args (app (app f y) x) ++ [v]) hPvF
    have hr3 := run_append n1 _ _ [app q v] h3
    have hcls3 : clsL (L3 ++ [app q v]) = clsL [app (app f y) x, q, v] := by
      rw [← clsL_run n1 _ _ hr3, ← clsL_step _ _ hs]
    have hfirst : run (n1 + 1) [app (app f y) x, q, v] = some (L3 ++ [app q v]) := by
      rw [run_succ n1 _ _ hs]; exact hr3
    match L3, hs3, h3, hcls3, hfirst with
    | [], _, _, _, hfirst => exact ⟨n1 + 1, [app q v], hfirst, by simp⟩
    | [p'], _, _, _, hfirst => exact ⟨n1 + 1, [p', app q v], hfirst, by simp⟩
    | [p', q'], _, h3, hcls3, hfirst =>
      have hF2 : isF (clsL [p', q', app q v]) = true := by
        have : ([p', q'] ++ [app q v] : List Tm) = [p', q', app q v] := rfl
        rw [← this, hcls3]; exact hF
      have hcl3 : clsL [p', q', app q v] = clsL [app (app f y) x, q, v] := hcls3
      have hn1 : n1 ≠ 0 := by
        intro h0; subst h0; simp [run] at h3
        all_goals (have := congrArg List.length h3; simp [args] at this; try omega)
      obtain ⟨m, hm⟩ : ∃ m, n1 = m + 1 := ⟨n1 - 1, by omega⟩
      rw [hm] at h3
      obtain ⟨a, b, c, R, hform⟩ := run_form m _ _ h3
      have hq0 : cls q' ≠ 0 := by
        have hl := congrArg List.length hform
        simp at hl
        have ha : args a = [] := List.eq_nil_of_length_eq_zero (by omega)
        have hR : R = [] := List.eq_nil_of_length_eq_zero (by omega)
        rw [ha, hR] at hform
        simp at hform
        rw [hform.2]; exact cls_app_ne b c
      have hcl2 : clsL [p', q'] = mul (cls (app (app f y) x)) (cls v) := by
        rw [← hPv]; exact (clsL_run _ _ _ h3).symm
      have hdec : (cls p', cls q') ∈ DECL.getD (mul (cls (app (app f y) x)) (cls v)) [] := by
        have := dec_mem (cls p') (cls q') (cls_lt _) (cls_lt _) hq0
        have e2 : mul (mul 0 (cls p')) (cls q') = clsL [p', q'] := rfl
        rw [e2, hcl2] at this; exact this
      have hgr := g_refill (cls (app (app f y) x)) (cls q) (cls v) (cls_lt _) (cls_lt q) (cls_lt v) hF
        (cls_app_ne _ _) (isPre_args _ hlen) (cls p', cls q') hdec
      obtain ⟨n2, L4, h4, hs4⟩ := chainF p' q' (app q v) hF2
      refine ⟨n1 + 1 + n2, L4, ?_, hs4⟩
      rw [run_add (n1 + 1) n2 _ _ hfirst]
      exact h4
    | _ :: _ :: _ :: _, hs3, _, _, _ => simp at hs3
termination_by (8 - rank (clsL [p, q, v]), 0, gidx (cls p) (cls q) (cls v), tsize p)
decreasing_by
  · rcases hgp with ⟨h1, h2, h3⟩ | h
    · refine lex4 (by rw [hcx]) rfl ?_ hts
      show gidx (cls x) (cls v) (mul (cls q) (cls v)) = gidx (cls (app S x)) (cls q) (cls v)
      rw [h3, h1, h2]
    · exact lex3 (by rw [hcx]) rfl h
  · exact lex1 (by omega)
  · exact lex3 (by rw [hcl3]) rfl hgr
end


/-- **Theorem Q10** (BEKW Question 10): an S-term has a head normal form iff its M35 class is in F. -/
theorem Q10 (t : Tm) : (∃ n L', run n (args t) = some L' ∧ L'.length ≤ 2) ↔ isF (cls t) = true := by
  constructor
  · rintro ⟨n, L', h, hl⟩
    have := hnf_inF L' hl
    rw [← clsL_run n _ _ h, ← cls_args] at this
    exact this
  · intro hF
    exact hnfF (args t) (by rw [← cls_args]; exact hF)


/-! ## Lft: the leftmost-path model (36 classes): flag 1 => the leftmost Böhm-tree path is infinite -/

def TABLft : Nat := 
def mulLft (a b : Nat) : Nat := (TABLft / 36 ^ (36 * a + b)) % 36
def FMASKLft : Nat := 1536
def flagLft (k : Nat) : Bool := (FMASKLft / 2 ^ k) % 2 == 1
def JLft : List (Nat × Nat) := [(0, 0), (1, 1), (2, 3), (2, 12), (3, 5), (3, 10), (4, 2), (5, 6), (5, 12), (6, 15), (6, 25), (7, 4), (8, 21), (9, 28), (10, 26), (11, 26), (12, 12), (13, 7), (14, 9), (14, 11), (14, 16), (14, 17), (14, 18), (14, 19), (14, 22), (14, 23), (14, 24), (14, 25), (14, 26), (14, 27), (14, 28), (14, 29), (14, 30), (14, 31), (14, 32), (14, 33), (14, 34), (15, 21), (15, 26), (16, 24), (16, 26), (16, 31), (17, 21), (17, 26), (18, 8), (19, 12), (20, 12), (21, 9), (21, 20), (21, 26), (22, 26), (23, 12), (24, 14), (25, 21), (25, 26), (26, 12), (27, 13), (28, 21), (28, 26), (29, 10), (30, 10), (30, 16), (30, 19), (31, 12), (32, 26), (33, 24), (33, 26), (34, 10), (35, 25)]
def clsLft : Tm → Nat
  | S => 0
  | app f x => mulLft (clsLft f) (clsLft x)
def clsLLft (L : List Tm) : Nat := L.foldl (fun acc t => mulLft acc (clsLft t)) 0
def RNLft : List Nat := List.range 36
def checkSLft : Bool := RNLft.all fun x => RNLft.all fun y => RNLft.all fun z =>
  mulLft (mulLft (mulLft 0 x) y) z == mulLft (mulLft x z) (mulLft y z)
def checkRLft : Bool := RNLft.all fun x => RNLft.all fun y => mulLft x y < 36
def checkCLft : Bool := !flagLft 0 && (RNLft.all fun x => flagLft (mulLft 0 x) == flagLft x) &&
  (RNLft.all fun x => RNLft.all fun y => flagLft (mulLft (mulLft 0 x) y) == flagLft x)
def checkJLft : Bool := JLft.contains (0, 0) &&
  (JLft.all fun a => JLft.all fun b => JLft.contains (mulLft a.1 b.1, mul a.2 b.2)) &&
  (JLft.all fun a => !flagLft a.1 || isF a.2)

